-- ============================================================
-- RUSH BOTTLE → MORPH
-- Использует InsertService (работает в executor'ах лучше чем GetObjects)
-- ============================================================

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local InsertService = game:GetService("InsertService")

local LocalPlayer = Players.LocalPlayer

print("[Rush] === Скрипт запущен ===")

-- ============================================================
-- BACKPACK
-- ============================================================
local backpack = LocalPlayer:FindFirstChild("Backpack") or LocalPlayer:WaitForChild("Backpack", 10)
if not backpack then
    warn("[Rush] ❌ Backpack не найден")
    return
end

-- ============================================================
-- ЗАГРУЗКА БУТЫЛКИ (пробуем несколько способов)
-- ============================================================
local BOTTLE_IDS = {140419135012621, 111263531009426, 83996348420126}

local toolNew

-- Способ 1: GetObjects
for _, id in ipairs(BOTTLE_IDS) do
    local ok, objs = pcall(function()
        return game:GetObjects("rbxassetid://" .. id)
    end)
    if ok and objs and objs[1] then
        toolNew = objs[1]
        print("[Rush] ✅ Бутылка через GetObjects, ID:", id)
        break
    end
end

-- Способ 2: InsertService (если GetObjects не сработал)
if not toolNew then
    for _, id in ipairs(BOTTLE_IDS) do
        local ok, model = pcall(function()
            return InsertService:LoadAsset(id)
        end)
        if ok and model then
            -- LoadAsset возвращает Model-контейнер, берём первого ребёнка
            local child = model:GetChildren()[1]
            if child then
                toolNew = child
                print("[Rush] ✅ Бутылка через InsertService, ID:", id)
                break
            end
        end
    end
end

if not toolNew then
    warn("[Rush] ❌ Не удалось загрузить бутылку ни одним способом")
    return
end

toolNew.Parent = backpack
toolNew.Name = "Rush Bottle"
pcall(function() toolNew.TextureId = "rbxassetid://76865808847706" end)
print("[Rush] ✅ Бутылка в Backpack:", toolNew.Name, "| Class:", toolNew.ClassName)

-- ============================================================
-- НАСТРОЙКИ
-- ============================================================
local RUSH_ASSET = 78888776904283
local MORPH_DURATION = 60

local morphActive = false
local isThirdPerson = true

local Rush = nil
local enforceLoop, inputConnection, morphTimer = nil, nil, nil
local Footsteps, PlaySound = nil, nil

-- ============================================================
-- УНИВЕРСАЛЬНАЯ ЗАГРУЗКА МОДЕЛИ (GetObjects + InsertService)
-- ============================================================
local function loadModel(assetId)
    print("[Rush] Пробую GetObjects для", assetId)
    local ok, objs = pcall(function()
        return game:GetObjects("rbxassetid://" .. assetId)
    end)
    if ok and objs and objs[1] then
        print("[Rush] ✅ GetObjects сработал, count:", #objs)
        return objs[1]
    end
    print("[Rush] ⚠️ GetObjects не сработал, ok =", ok, "| count =", objs and #objs or "nil")

    print("[Rush] Пробую InsertService для", assetId)
    local ok2, model = pcall(function()
        return InsertService:LoadAsset(assetId)
    end)
    if ok2 and model then
        local child = model:GetChildren()[1]
        if child then
            print("[Rush] ✅ InsertService сработал:", child.Name)
            return child
        end
    end
    print("[Rush] ❌ InsertService тоже не сработал, ok =", ok2, "| model =", model)

    return nil
end

-- ============================================================
-- CLEANUP
-- ============================================================
local function cleanupMorph()
    if inputConnection then inputConnection:Disconnect() inputConnection = nil end
    if enforceLoop then enforceLoop:Disconnect() enforceLoop = nil end
    if morphTimer then task.cancel(morphTimer) morphTimer = nil end

    local camera = workspace.CurrentCamera
    if camera then camera.CameraType = Enum.CameraType.Custom end

    local Character = LocalPlayer.Character
    if Character then
        for _, Object in ipairs(Character:GetDescendants()) do
            if Object:IsA("BasePart") then
                Object.LocalTransparencyModifier = 0
                Object.Transparency = 0
                Object.CanCollide = true
            elseif Object:IsA("Decal") or Object:IsA("Texture") then
                Object.Transparency = 0
            end
        end
        for _, v in pairs(Character:GetChildren()) do
            if v:IsA("Accessory") and v:FindFirstChild("Handle") then
                v.Handle.Transparency = 0
                v.Handle.LocalTransparencyModifier = 0
            end
        end
    end

    if Footsteps then Footsteps:Stop() Footsteps = nil end
    if PlaySound then PlaySound:Stop() PlaySound = nil end

    if Rush then Rush:Destroy() Rush = nil end

    morphActive = false
    print("[Rush] 🔄 Морф снят")
end

-- ============================================================
-- CORE MORPH
-- ============================================================
local function applyMorph()
    if morphActive then cleanupMorph() end

    Rush = loadModel(RUSH_ASSET)

    if not Rush then
        warn("[Rush] ❌ Модель Rush не загружена ни одним способом")
        warn("[Rush] ID", RUSH_ASSET, "— либо мёртвый, либо недоступен в executor'е")
        return
    end

    print("[Rush] ✅ Rush загружен:", Rush.Name, "| Class:", Rush.ClassName)
    print("[Rush] --- Дети ---")
    for _, c in pairs(Rush:GetChildren()) do
        print("[Rush]   >", c.Name, "|", c.ClassName)
    end

    Rush.Parent = workspace

    local Main = Rush:FindFirstChild("Main") or Rush

    Footsteps = Main:FindFirstChild("Footsteps")
    PlaySound = Main:FindFirstChild("PlaySound")
    if Footsteps then pcall(function() Footsteps:Play() end) end
    if PlaySound then pcall(function() PlaySound:Play() end) end

    local camera = workspace.CurrentCamera
    if camera then camera.CameraType = Enum.CameraType.Scriptable end

    -- FOLLOW LOOP + КАМЕРА
    enforceLoop = RunService.RenderStepped:Connect(function()
        if not Rush or not Rush.Parent then return end

        local Character = LocalPlayer.Character
        if not Character then return end

        local RootPart = Character:FindFirstChild("HumanoidRootPart")
        if not RootPart then return end

        pcall(function()
            Rush:PivotTo(RootPart.CFrame)
        end)

        for _, Object in ipairs(Character:GetDescendants()) do
            if Object:IsA("BasePart") then
                Object.LocalTransparencyModifier = 1
                for _, Child in ipairs(Object:GetDescendants()) do
                    if Child:IsA("Decal") or Child:IsA("Texture") then
                        Child.Transparency = 1
                    end
                end
            elseif Object:IsA("Accessory") then
                local Handle = Object:FindFirstChild("Handle")
                if Handle then Handle.LocalTransparencyModifier = 1 end
            end
        end

        if camera then
            local morphHead = Rush:FindFirstChild("Head", true) or Rush:FindFirstChildWhichIsA("BasePart")
            local targetPos = morphHead and morphHead.Position or (RootPart.Position + Vector3.new(0, 1.5, 0))

            local lookVector = camera.CFrame.LookVector
            local upVector = camera.CFrame.UpVector

            if isThirdPerson then
                local camPos = targetPos - (lookVector * 12) + Vector3.new(0, 2, 0)
                camera.CFrame = CFrame.lookAt(camPos, targetPos, upVector)
            else
                local camPos = targetPos + lookVector * 0.5
                camera.CFrame = CFrame.lookAt(camPos, camPos + lookVector, upVector)
            end
        end
    end)

    inputConnection = UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        if input.UserInputType == Enum.UserInputType.Keyboard then
            if input.KeyCode == Enum.KeyCode.R then
                if Footsteps then
                    if Footsteps.IsPlaying then Footsteps:Stop() else Footsteps:Play() end
                end
                if PlaySound then
                    if PlaySound.IsPlaying then PlaySound:Stop() else PlaySound:Play() end
                end
            elseif input.KeyCode == Enum.KeyCode.L then
                isThirdPerson = not isThirdPerson
            end
        end
    end)

    morphActive = true
    print("[Rush] ✅ MORPH ACTIVATED! R — звуки, L — камера")

    morphTimer = task.delay(MORPH_DURATION, function()
        cleanupMorph()
    end)
end

-- ============================================================
-- АКТИВАЦИЯ ЗЕЛЬЯ
-- ============================================================
local drinked = false

toolNew.Activated:Connect(function()
    print("[Rush] 🍶 Activated сработал! drinked =", drinked)
    if drinked then return end
    drinked = true

    local newSound = workspace:FindFirstChild("DrinkPotionAddonSound")
    if not newSound then
        newSound = Instance.new("Sound", workspace)
        newSound.Name = "DrinkPotionAddonSound"
        newSound.SoundId = game.GameId == 6627207668
            and "rbxassetid://103799151859408"
            or  "rbxassetid://18869124055"
    end
    pcall(function() newSound:Play() end)

    task.defer(function()
        pcall(applyMorph)
    end)

    toolNew:Destroy()
end)

print("[Rush] ✅ Скрипт загружен, всё готово")
