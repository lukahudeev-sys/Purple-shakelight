local function transformIntoRush()
    print("[Rush] === transformIntoRush() ===")
    _G.TransformedIntoAnyMorph = false

    print("[Rush] Загружаю модель: 100327482330650")
    local ok, objs = pcall(function()
        return game:GetObjects("rbxassetid://100327482330650")
    end)

    print("[Rush] ok =", ok, "| count =", objs and #objs or "nil")

    if not ok or not objs or not objs[1] then
        warn("[Rush] ❌ Модель Rush не загрузилась")
        return
    end

    local figureNew = objs[1]
    print("[Rush] ✅ Модель:", figureNew.Name)

    local testingPlace = (game.GameId == 6627207668)
    figureNew.Parent = workspace

    local Main = figureNew:FindFirstChild("Main")
    if not Main then
        warn("[Rush] Нет Main в модели Rush")
        return
    end

    -- Звуки
    local Sounds = Main:FindFirstChild("Sounds")
    if Sounds then
        local soundFolder = testingPlace and Sounds:FindFirstChild("test game")
                                            or Sounds:FindFirstChild("DOORS")
        if soundFolder then
            for _, s in pairs(soundFolder:GetChildren()) do
                s:Clone().Parent = Main
            end
        end
        Sounds:Destroy()
    end

    -- Анимация
    local RunAnim
    local animator = figureNew:FindFirstChild("AnimationController")
                     and figureNew.AnimationController:FindFirstChild("Animator")
    if animator then
        local animsFolder = figureNew:FindFirstChild(testingPlace and "AnimationsTest" or "Animations")
        local runAnimObj = animsFolder and animsFolder:FindFirstChild("run")
        if runAnimObj then
            RunAnim = animator:LoadAnimation(runAnimObj)
            RunAnim:Play()
            RunAnim:AdjustSpeed(0)
        end
    end

    local Footsteps = Main:FindFirstChild("Footsteps")
    local PlaySound = Main:FindFirstChild("PlaySound")
    if Footsteps then Footsteps:Play() end
    if PlaySound then PlaySound:Play() end

    -- Скорость
    spawn(function()
        local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
        local hum = char:WaitForChild("Humanoid")
        hum.Running:Connect(function(speed)
            if RunAnim then
                if speed >= 20 then RunAnim:AdjustSpeed(1.5)
                elseif speed >= 5 then RunAnim:AdjustSpeed(1)
                else RunAnim:AdjustSpeed(0) end
            end
            if Footsteps and Footsteps.IsPlaying then
                Footsteps.PlaybackSpeed = math.clamp(speed / 16, 0.6, 1.8)
            end
            if PlaySound and PlaySound.IsPlaying then
                PlaySound.PlaybackSpeed = math.clamp(speed / 16, 0.6, 1.8)
            end
        end)
    end)

    -- Слежка + скрытие тела
    spawn(function()
        game:GetService("RunService").RenderStepped:Connect(function()
            local char = LocalPlayer.Character
            if not char then return end
            if char:FindFirstChild("Head") then
                char.Head.Transparency = 1
            end
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if hrp then
                pcall(function() figureNew:PivotTo(hrp.CFrame) end)
            end
            for _, v in pairs(char:GetChildren()) do
                if v:IsA("BasePart") then
                    v.LocalTransparencyModifier = 1
                    for _, d in pairs(v:GetDescendants()) do
                        if d:IsA("Decal") or d:IsA("Texture") then
                            d.Transparency = 1
                        end
                    end
                elseif v:IsA("Accessory") and v:FindFirstChild("Handle") then
                    v.Handle.Transparency = 1
                end
            end
        end)
    end)

    -- Управление
    LocalPlayer:GetMouse().KeyDown:Connect(function(key)
        if key == "r" then
            if Footsteps then
                if Footsteps.IsPlaying then Footsteps:Stop() else Footsteps:Play() end
            end
            if PlaySound then
                if PlaySound.IsPlaying then PlaySound:Stop() else PlaySound:Play() end
            end
        elseif key == "t" then
            local scream = Main:FindFirstChild("Scream")
            if scream then scream:Play() end
        end
    end)

    print("[Rush] ✅ Морф Rush активирован!")
end

-- ============================================================
-- ОСНОВНОЙ ЦИКЛ ЗЕЛЬЯ
-- ============================================================
spawn(function()
    while wait() do
        if drinked == true and ended == false then
            ended = true
            if game.GameId == 6627207668 then
                local newTool = script.flyTest:Clone()
                newTool.Parent = LocalPlayer.Backpack
                newTool.Enabled = true
            else
                if getgenv().ViridislightRunning then
                    return
                end
                getgenv().ViridislightRunning = true

                -- === ПРЕВРАЩЕНИЕ В RUSH ===
                spawn(function()
                    task.wait(1.5)
                    transformIntoRush()
                end)
                -- ==========================

                local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
                local Humanoid = Character:WaitForChild("Humanoid")
                local RootPart = Character:WaitForChild("HumanoidRootPart")

                local potionLight = Instance.new("PointLight")
                potionLight.Name = "ViridisLight"
                potionLight.Color = Color3.fromRGB(0,255,0)
                potionLight.Brightness = 2
                potionLight.Range = 0
                potionLight.Shadows = false
                potionLight.Parent = RootPart

                TweenService:Create(
                    potionLight,
                    TweenInfo.new(2.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
                    { Range = 45 }
                ):Play()

                local Collision = Character:FindFirstChild("CollisionPart")
                if not Collision then
                    for _, part in pairs(Character:GetChildren()) do
                        if part:IsA("BasePart") and part.Name:lower():find("collision") then
                            Collision = part
                            break
                        end
                    end
                end
                if not Collision then Collision = RootPart end

                local CollisionClone = Collision:Clone()
                CollisionClone.CanCollide = false
                CollisionClone.Massless = true
                CollisionClone.CanQuery = false
                CollisionClone.Name = "CollisionClone"
                if CollisionClone:FindFirstChild("CollisionCrouch") then
                    CollisionClone.CollisionCrouch:Destroy()
                end
                CollisionClone.Parent = Character

                task.spawn(function()
                    while Character.Parent and CollisionLoopRunning do
                        if RootPart.Anchored then
                            CollisionClone.Massless = true
                            repeat task.wait() until not RootPart.Anchored or not CollisionLoopRunning
                            if not CollisionLoopRunning then break end
                            task.wait(0.15)
                        else
                            CollisionClone.Massless = not CollisionClone.Massless
                        end
                        task.wait(0.24)
                    end
                end)

                local viridis = Instance.new("Sound", workspace)
                viridis.SoundId = "rbxassetid://140242540481244"
                viridis.Volume = 1.2

                local ambience = Instance.new("Sound", workspace)
                ambience.SoundId = "rbxassetid://1841950508"
                ambience.Volume = 1
                ambience.Looped = true
                ambience:Play()

                local Workspace = game:GetService("Workspace")
                local stopped = false
                local activeHighlights = {}

                local function process(inst)
                    if stopped then return end
                    if inst:IsA("Model") and (inst.Name == "Door" or inst.Name == "KeyObtain") then
                        if not inst:FindFirstChildOfClass("Highlight") then
                            local h = Instance.new("Highlight")
                            h.FillColor = Color3.fromRGB(120, 255, 160)
                            h.OutlineColor = Color3.fromRGB(80, 255, 120)
                            h.FillTransparency = 0.4
                            h.OutlineTransparency = 0
                            h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                            h.Parent = inst
                            table.insert(activeHighlights, h)
                        end
                    end
                end

                local function scanRooms()
                    if stopped then return end
                    local rooms = Workspace:FindFirstChild("CurrentRooms")
                    if not rooms then return end
                    for _, v in ipairs(rooms:GetDescendants()) do
                        process(v)
                    end
                end

                scanRooms()

                local conn
                conn = Workspace.CurrentRooms.DescendantAdded:Connect(function(v)
                    if stopped then return end
                    task.wait()
                    process(v)
                end)

                local function stopHighlights()
                    stopped = true
                    if conn then conn:Disconnect() end
                    for _, h in ipairs(activeHighlights) do
                        if h and h.Parent then h:Destroy() end
                    end
                    activeHighlights = {}
                end

                local RunService = game:GetService("RunService")
                local player = game.Players.LocalPlayer
                local humanoid2 = player.Character or player.CharacterAdded:Wait()
                humanoid2 = humanoid2:WaitForChild("Humanoid")
                local stopped2 = false
                local function startRegen()
                    task.spawn(function()
                        while not stopped2 do
                            task.wait(0.5)
                            if humanoid2 and humanoid2.Parent and humanoid2.Health > 0 then
                                humanoid2.Health = math.min(humanoid2.Health + 1, humanoid2.MaxHealth)
                            end
                        end
                    end)
                end
                startRegen()

                local originalWalkSpeed = humanoid2.WalkSpeed
                local speedConn = RunService.Heartbeat:Connect(function()
                    if humanoid2 and humanoid2.Parent and humanoid2.WalkSpeed ~= 17 then
                        humanoid2.WalkSpeed = 17
                    end
                end)

                local gui = Instance.new("ScreenGui")
                gui.IgnoreGuiInset = true
                gui.ResetOnSpawn = false
                gui.Parent = player:WaitForChild("PlayerGui")

                local label = Instance.new("TextLabel")
                label.Size = UDim2.new(0, 200, 0, 40)
                label.Position = UDim2.new(0.5, -100, 0, 10)
                label.BackgroundTransparency = 1
                label.TextColor3 = Color3.fromRGB(170, 255, 180)
                label.TextStrokeTransparency = 0.6
                label.Font = Enum.Font.Gotham
                label.TextSize = 20
                label.Text = "1:00"
                label.Parent = gui

                local timeLeft = 30
                local function formatTime(t)
                    local m = math.floor(t / 60)
                    local s = t % 60
                    return string.format("%d:%02d", m, s)
                end

                local function restore()
                    getgenv().ViridislightRunning = false
                    if potionLight and potionLight.Parent then
                        local lightTween = TweenService:Create(
                            potionLight,
                            TweenInfo.new(2),
                            { Range = 0 }
                        )
                        lightTween:Play()
                        lightTween.Completed:Connect(function()
                            if potionLight then potionLight:Destroy() end
                        end)
                    end
                    if newCloneEffect then newCloneEffect.Visible = false end
                    if speedConn then speedConn:Disconnect() end

                    local tween = TweenService:Create(humanoid2, TweenInfo.new(2), {
                        WalkSpeed = originalWalkSpeed
                    })
                    tween:Play()

                    task.delay(2, function()
                        if gui then gui:Destroy() end
                    end)
                end

                viridis:Play()
                viridis.Ended:Connect(function()
                    viridis:Destroy()
                end)

                task.spawn(function()
                    while timeLeft >= 0 do
                        label.Text = formatTime(timeLeft)
                        if timeLeft == 0 then
                            stopped2 = true
                            stopHighlights()
                            restore()
                            ambience:Destroy()
                            CollisionLoopRunning = false
                            if CollisionClone then CollisionClone:Destroy() end
                            break
                        end
                        timeLeft -= 1
                        task.wait(1)
                    end
                end)
            end
        end
    end
end)

