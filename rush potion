-- ============================================================
-- VIRIDIS BOTTLE → RUSH MORPH (third person)
-- Выпил зелье → превратился в Rush, камера сзади
-- L — toggle камеры, R — toggle звуков
-- ============================================================

local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local MainUI_upvr = game.Players.LocalPlayer.PlayerGui:WaitForChild("MainUI")

-- Загружаем бутылку
local toolNew
if game.GameId == 6627207668 then
	toolNew = game.ReplicatedStorage["Moon Bottle"]:Clone()
else
	toolNew = game:GetObjects("rbxassetid://140419135012621")[1]
end

-- Анимации питья
local ohhmydayz  = game.Players.LocalPlayer.Character:WaitForChild("Humanoid"):LoadAnimation(toolNew.bals.idle)
local ohhmydayz2 = game.Players.LocalPlayer.Character:WaitForChild("Humanoid"):LoadAnimation(toolNew.bals.open)
local ohhmydayz3 = game.Players.LocalPlayer.Character:WaitForChild("Humanoid"):LoadAnimation(toolNew.Animations.open)

local drinked = false

-- ============================================================
-- НАСТРОЙКИ КАМЕРЫ
-- ============================================================
local isThirdPerson = true
local thirdPersonDistance = 12
local thirdPersonHeightOffset = 2

local function resetCamera()
    local camera = workspace.CurrentCamera
    if camera then
        camera.CameraType = Enum.CameraType.Custom
    end
end

-- ============================================================
-- RUSH MORPH FUNCTION
-- ============================================================
local function transformIntoRush()
    if _G.RushMorphActive then
        warn("[Rush] Уже активен")
        return
    end
    _G.RushMorphActive = true

    local ok, figureNew = pcall(function()
        return game:GetObjects("rbxassetid://100327482330650")[1]
    end)

    if not ok or not figureNew then
        warn("[Rush] Не удалось загрузить модель rbxassetid://100327482330650")
        _G.RushMorphActive = false
        return
    end

    local isTestPlace = (game.GameId == 6627207668)
    figureNew.Parent = workspace

    -- Звуки
    local Main = figureNew:FindFirstChild("Main")
    local Footsteps, PlaySound
    if Main then
        local Sounds = Main:FindFirstChild("Sounds")
        if Sounds then
            local soundFolder = isTestPlace and Sounds:FindFirstChild("test game")
                                                or Sounds:FindFirstChild("DOORS")
            if soundFolder then
                for _, s in pairs(soundFolder:GetChildren()) do
                    s:Clone().Parent = Main
                end
            end
            Sounds:Destroy()
        end
        Footsteps = Main:FindFirstChild("Footsteps")
        PlaySound = Main:FindFirstChild("PlaySound")
        if Footsteps then Footsteps:Play() end
        if PlaySound then PlaySound:Play() end
    end

    -- Анимация бега
    local RunAnim
    local animator = figureNew:FindFirstChild("AnimationController")
                     and figureNew.AnimationController:FindFirstChild("Animator")
    if animator then
        local animsFolder = figureNew:FindFirstChild(isTestPlace and "AnimationsTest" or "Animations")
        local runAnimObj = animsFolder and animsFolder:FindFirstChild("run")
        if runAnimObj then
            RunAnim = animator:LoadAnimation(runAnimObj)
            RunAnim:Play()
            RunAnim:AdjustSpeed(0)
        end
    end

    -- Скорость шагов
    spawn(function()
        local char = game.Players.LocalPlayer.Character or game.Players.LocalPlayer.CharacterAdded:Wait()
        local hum = char:WaitForChild("Humanoid")
        hum.Running:Connect(function(speed)
            if RunAnim then
                if speed >= 20 then RunAnim:AdjustSpeed(1.5)
                elseif speed >= 5 then RunAnim:AdjustSpeed(1)
                else RunAnim:AdjustSpeed(0) end
            end
            if Footsteps and Footsteps.IsPlaying then
                Footsteps.PlaybackSpeed = math.clamp(speed / 16, 0.6, 1.8)
            end
            if PlaySound and PlaySound.IsPlaying then
                PlaySound.PlaybackSpeed = math.clamp(speed / 16, 0.6, 1.8)
            end
        end)
    end)

    -- ============================================================
    -- СЛЕЖКА + СКРЫТИЕ + КАМЕРА ОТ ТРЕТЬЕГО ЛИЦА
    -- ============================================================
    RunService.RenderStepped:Connect(function()
        local char = game.Players.LocalPlayer.Character
        if not char then return end

        if char:FindFirstChild("Head") then
            char.Head.Transparency = 1
        end

        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then
            pcall(function() figureNew:PivotTo(hrp.CFrame) end)
        end

        for _, v in pairs(char:GetChildren()) do
            if v:IsA("BasePart") then
                v.LocalTransparencyModifier = 1
                for _, d in pairs(v:GetDescendants()) do
                    if d:IsA("Decal") or d:IsA("Texture") then
                        d.Transparency = 1
                    end
                end
            elseif v:IsA("Accessory") and v:FindFirstChild("Handle") then
                v.Handle.Transparency = 1
            end
        end

        -- === КАМЕРА ОТ ТРЕТЬЕГО ЛИЦА ===
        local camera = workspace.CurrentCamera
        if camera and figureNew and figureNew.Parent then
            local morphHead = figureNew:FindFirstChild("Head", true)
            if not morphHead then
                morphHead = figureNew:FindFirstChildWhichIsA("BasePart")
            end

            if morphHead then
                if isThirdPerson then
                    camera.CameraType = Enum.CameraType.Scriptable
                    local lookVector = camera.CFrame.LookVector
                    local upVector = camera.CFrame.UpVector
                    local headPos = morphHead.Position
                    local camPos = headPos - (lookVector * thirdPersonDistance)
                                   + Vector3.new(0, thirdPersonHeightOffset, 0)
                    camera.CFrame = CFrame.lookAt(camPos, headPos, upVector)
                else
                    camera.CameraType = Enum.CameraType.Custom
                end
            end
        end
    end)

    -- R — toggle звуков, L — toggle камеры
    game.Players.LocalPlayer:GetMouse().KeyDown:Connect(function(key)
        if key == "r" then
            if Footsteps then
                if Footsteps.IsPlaying then Footsteps:Stop() else Footsteps:Play() end
            end
            if PlaySound then
                if PlaySound.IsPlaying then PlaySound:Stop() else PlaySound:Play() end
            end
        elseif key == "l" then
            isThirdPerson = not isThirdPerson
            if not isThirdPerson then
                resetCamera()
            end
        end
    end)

    print("[Rush] Morph activated! L — камера, R — звуки")
end

-- ============================================================
-- БУТЫЛКА
-- ============================================================
toolNew.Parent = game.Players.LocalPlayer.Backpack
toolNew.Name = "Viridislight Bottle"
toolNew.TextureId = "rbxassetid://76865808847706"

toolNew.Equipped:Connect(function()
	if game.GameId == 6627207668 then
		ohhmydayz:Play()
	end
end)

toolNew.Unequipped:Connect(function()
	if game.GameId == 6627207668 then
		ohhmydayz:Stop()
	end
end)

toolNew.Activated:Connect(function()
	if drinked == false then
		drinked = true

		if game.GameId == 6627207668 then
			ohhmydayz2:Play()
			ohhmydayz2.Ended:Wait()
		else
			ohhmydayz3:Play()
			ohhmydayz3.Ended:Wait()
		end

		toolNew:Destroy()

		transformIntoRush()
	end
end)
