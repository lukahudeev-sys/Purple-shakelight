local Players = game:GetService("Players")
local player = Players.LocalPlayer

-- 🩷 Перекраска в розовый (сохраняя яркость/насыщенность)
local function shiftToPink(color)
	local h, s, v = color:ToHSV()
	-- Hue розового ≈ 330° = 0.9167
	return Color3.fromHSV(0.9167, s, v)
end

-- FIX + CLEAN MODEL
local function sanitizeModel(model)
	if not model:IsA("Model") then return end

	for _, v in ipairs(model:GetDescendants()) do

		workspace["viridis pentagram"].StarCenter.ItemHolder.Item.Enabled = true
		workspace["viridis pentagram"].StarCenter.ItemHolder.Item.Texture = "rbxassetid://92662254918375"

		-- ❌ удаляем BeamFlat / BeamGlow
		if v:IsA("Beam") and (v.Name == "BeamFlat" or v.Name == "BeamGlow") then
			v:Destroy()
		end

		-- 🔧 фикс партов
		if v:IsA("BasePart") then
			v.Anchored = true
			v.CanCollide = false
		end

		-- 🩷 BasePart → розовый
		if v:IsA("BasePart") then
			v.Color = shiftToPink(v.Color)
		end

		-- 🩷 ParticleEmitter → розовый
		if v:IsA("ParticleEmitter") then
			local newKPs = {}
			for _, kp in ipairs(v.Color.Keypoints) do
				table.insert(newKPs, ColorSequenceKeypoint.new(
					kp.Time,
					shiftToPink(kp.Value)
				))
			end
			v.Color = ColorSequence.new(newKPs)
		end

		-- 🩷 Beam / Trail → розовый
		if v:IsA("Beam") or v:IsA("Trail") then
			local newKPs = {}
			for _, kp in ipairs(v.Color.Keypoints) do
				table.insert(newKPs, ColorSequenceKeypoint.new(
					kp.Time,
					shiftToPink(kp.Value)
				))
			end
			v.Color = ColorSequence.new(newKPs)
		end

		-- 🩷 Lights → розовый
		if v:IsA("PointLight")
			or v:IsA("SpotLight")
			or v:IsA("SurfaceLight") then
			v.Color = shiftToPink(v.Color)
		end

		-- 🔥 prompt + trigger
		if v:IsA("ProximityPrompt") then
			v.HoldDuration = 3
			v.MaxActivationDistance = 5
			v:SetAttribute("CustomFrame", "Black")
			v.Style = Enum.ProximityPromptStyle.Custom

			local triggered = false

			v.Triggered:Connect(function(plr)
				if triggered then return end
				triggered = true

				local function safeLoad(url)
					task.spawn(function()
						local ok, result = pcall(function()
							return game:HttpGet(url)
						end)

						if not ok then
							warn("HttpGet failed:", url)
							warn(result)
							return
						end

						local success, err = pcall(function()
							loadstring(result)()
						end)

						if not success then
							warn("Loadstring failed:", url)
							warn(err)
						end
					end)
				end

				safeLoad("https://raw.githubusercontent.com/lukahudeev-sys/Purple-shakelight/refs/heads/main/lotus%20bottle")
				safeLoad("https://raw.githubusercontent.com/lukahudeev-sys/Purple-shakelight/refs/heads/main/lotusjug")
				safeLoad("https://raw.githubusercontent.com/lukahudeev-sys/Purple-shakelight/refs/heads/main/lotus%20vial%20doors")

				local parentModel = model
				v:Destroy()

				-- 🔥 скрыть всё кроме ParticlesOut
				local particleOut = parentModel:FindFirstChild("ParticlesOut", true)

				for _, obj in ipairs(parentModel:GetDescendants()) do
					if particleOut and obj:IsDescendantOf(particleOut) then
						continue
					end

					if obj:IsA("BasePart") then
						obj.Transparency = 1
						obj.CanCollide = false
					end

					if obj:IsA("PointLight") or obj:IsA("SpotLight") or obj:IsA("SurfaceLight") then
						obj.Enabled = false
					end

					if obj:IsA("ParticleEmitter") then
						obj.Enabled = false
					end

					if obj:IsA("Beam") or obj:IsA("Trail") then
						obj.Enabled = false
					end
				end

				local maxLifetime = 0

				if particleOut then
					for _, pe in ipairs(particleOut:GetDescendants()) do
						if pe:IsA("ParticleEmitter") then
							local emitCount = pe:GetAttribute("BurstAmount") or 30
							pe:Emit(emitCount)
							pe.Enabled = false

							local life = pe.Lifetime
							if life.Max > maxLifetime then
								maxLifetime = life.Max
							end
						end
					end
				end

				task.delay(maxLifetime + 0.2, function()
					if parentModel and parentModel.Parent then
						parentModel:Destroy()
					end
				end)
			end)
		end
	end

	-- PrimaryPart
	local pp = model:FindFirstChildWhichIsA("BasePart", true)
	if pp then
		model.PrimaryPart = pp
	end

	model:PivotTo(model:GetPivot())
end

-- spawn logic
local function spawnNearRift()

	local objs = game:GetObjects("rbxassetid://110852226869313")
	local model = objs[1]
	model.Name = "viridis pentagram"

	if not model then
		warn("failed to load model -_-")
		return
	end

	model.Parent = workspace

	sanitizeModel(model)

	local spawnPos = Vector3.new(277, -0, -7)
	model:PivotTo(CFrame.new(spawnPos))
end

spawnNearRift()
