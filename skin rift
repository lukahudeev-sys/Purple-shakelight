	local ok, objs = pcall(function()
		return game:GetObjects("rbxassetid://110852226869313")
	end)
	if not ok or not objs or not objs[1] then
		warn("failed to load rift model -_-")
		return
	end

	local model = objs[1]
	model.Name = "skin pentagram"
	model.Parent = workspace

	sanitizeModel(model)

	model:PivotTo(CFrame.new(Vector3.new(274, 0, -51)))
end

spawnNearRift()
