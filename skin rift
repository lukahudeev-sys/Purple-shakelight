-- ============================================================
-- HTTP с фолбэками для разных экзекьюторов
-- ============================================================
local function httpGet(url)
	if syn and syn.request then
		local ok, res = pcall(function()
			return syn.request({Url = url, Method = "GET"})
		end)
		if ok and res and res.Body and res.Body ~= "" then
			return res.Body
		end
	end
	if request then
		local ok, res = pcall(function()
			return request({Url = url, Method = "GET"})
		end)
		if ok and res and res.Body and res.Body ~= "" then
			return res.Body
		end
	end
	if http_request then
		local ok, res = pcall(function()
			return http_request({Url = url, Method = "GET"})
		end)
		if ok and res and res.Body and res.Body ~= "" then
			return res.Body
		end
	end
	return game:HttpGet(url)
end

-- ============================================================
-- Безопасная загрузка скрипта: ретраи + диагностика
-- ============================================================
local function safeLoad(name, url, retries)
	retries = retries or 2
	task.spawn(function()
		local lastErr
		for attempt = 1, retries do
			local ok, body = pcall(httpGet, url)
			if ok and body and body ~= "" then
				local lstr = loadstring or load or (getgenv and (getgenv().loadstring or getgenv().load))
				if lstr then
					local func, loadErr = lstr(body)
					if func then
						local success, execErr = pcall(func)
						if success then
							print(("[skin rift] %s: OK"):format(name))
							return
						else
							lastErr = "Ошибка выполнения: " .. tostring(execErr)
						end
					else
						lastErr = "Синтаксическая ошибка: " .. tostring(loadErr)
					end
				else
					warn(("[skin rift] %s: loadstring недоступен!"):format(name))
					return
				end
			else
				lastErr = "HTTP failed: " .. tostring(body)
			end
			warn(("[skin rift] %s: попытка %d/%d не удалась: %s"):format(name, attempt, retries, tostring(lastErr)))
			task.wait(0.4)
		end
		warn(("[skin rift] %s: ✘ НЕ ЗАГРУЖЕН. Последняя ошибка: %s"):format(name, tostring(lastErr)))
	end)
end

-- ============================================================
-- Sanitize model
-- ============================================================
local function shiftToBlack(_color)
	return Color3.fromRGB(0, 0, 0)
end

local function sanitizeModel(model)
	if not model:IsA("Model") then return end

	-- Обновляем иконку в StarCenter (с защитой от nil)
	local starCenter = model:FindFirstChild("StarCenter")
	if starCenter then
		local itemHolder = starCenter:FindFirstChild("ItemHolder")
		if itemHolder then
			local item = itemHolder:FindFirstChild("Item")
			if item then
				item.Enabled = true
				item.Texture = "rbxassetid://117364073108480"
			end
		end
	end

	for _, v in ipairs(model:GetDescendants()) do
		-- Удаляем BeamFlat / BeamGlow
		if v:IsA("Beam") and (v.Name == "BeamFlat" or v.Name == "BeamGlow") then
			v:Destroy()
			continue
		end

		-- Парты
		if v:IsA("BasePart") then
			v.Anchored = true
			v.CanCollide = false
			v.Color = shiftToBlack(v.Color)
		end

		-- Цветовые секвенции
		if v:IsA("ParticleEmitter") or v:IsA("Beam") or v:IsA("Trail") then
			local seq = v.Color
			if seq then
				local newKPs = {}
				for _, kp in ipairs(seq.Keypoints) do
					table.insert(newKPs, ColorSequenceKeypoint.new(kp.Time, shiftToBlack(kp.Value)))
				end
				v.Color = ColorSequence.new(newKPs)
			end
		end

		-- Свет
		if v:IsA("PointLight") or v:IsA("SpotLight") or v:IsA("SurfaceLight") then
			v.Color = shiftToBlack(v.Color)
		end

		-- ProximityPrompt
		if v:IsA("ProximityPrompt") then
			v.HoldDuration = 3
			v.MaxActivationDistance = 5
			v:SetAttribute("CustomFrame", "Black")
			v.Style = Enum.ProximityPromptStyle.Custom

			local triggered = false

			v.Triggered:Connect(function(plr)
				if triggered then return end
				triggered = true

				-- 1) Запускаем загрузку скриптов в фоне (со стаггером)
				task.spawn(function()
					safeLoad("honcho", "https://raw.githubusercontent.com/lukahudeev-sys/Archive-doors-rifts/refs/heads/main/honcho%20potion")
					task.wait(0.1)
					safeLoad("figure", "https://raw.githubusercontent.com/lukahudeev-sys/Purple-shakelight/refs/heads/main/Figure%20potion")
					task.wait(0.1)
					safeLoad("seek",   "https://raw.githubusercontent.com/lukahudeev-sys/Purple-shakelight/refs/heads/main/seek%20potion")
					task.wait(0.1)
					safeLoad("ambush", "https://raw.githubusercontent.com/lukahudeev-sys/Purple-shakelight/refs/heads/main/ambush%20potion")
					task.wait(0.1)
					safeLoad("rush",   "https://raw.githubusercontent.com/lukahudeev-sys/Purple-shakelight/refs/heads/main/rush%20potion")
				end)

				-- 2) Визуальная часть — сразу
				local parentModel = model
				v:Destroy()

				local particleOut = parentModel:FindFirstChild("ParticlesOut", true)

				for _, obj in ipairs(parentModel:GetDescendants()) do
					if particleOut and obj:IsDescendantOf(particleOut) then
						continue
					end
					if obj:IsA("BasePart") then
						obj.Transparency = 1
						obj.CanCollide = false
					elseif obj:IsA("PointLight") or obj:IsA("SpotLight") or obj:IsA("SurfaceLight") then
						obj.Enabled = false
					elseif obj:IsA("ParticleEmitter") then
						obj.Enabled = false
					elseif obj:IsA("Beam") or obj:IsA("Trail") then
						obj.Enabled = false
					end
				end

				local maxLifetime = 0
				if particleOut then
					for _, pe in ipairs(particleOut:GetDescendants()) do
						if pe:IsA("ParticleEmitter") then
							local emitCount = pe:GetAttribute("BurstAmount") or 30
							pe:Emit(emitCount)
							pe.Enabled = false
							local t = pe.Lifetime.Max
							if t > maxLifetime then
								maxLifetime = t
							end
						end
					end
				end

				task.delay(maxLifetime + 0.2, function()
					if parentModel and parentModel.Parent then
						parentModel:Destroy()
					end
				end)
			end)
		end
	end

	-- PrimaryPart
	local pp = model:FindFirstChildWhichIsA("BasePart", true)
	if pp then
		model.PrimaryPart = pp
	end

	model:PivotTo(model:GetPivot())
end

