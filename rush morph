--[[
    Rush Morph для Doors
    Основано на структуре seek.txt
    
    Управление:
      R — toggle звуков (шаги + основной звук)
      T — крик (Scream, если есть)
      L — toggle камеры 1-е / 3-е лицо
--]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

-- Защита от повторного морфа (СВОЙ флаг, как в seek.txt)
if _G.RushMorphActive then
    warn("[Rush Morph] Уже активен!")
    return
end
_G.RushMorphActive = true

-- ============================================================
-- НАСТРОЙКА
-- ============================================================
local RUSH_ASSET = "rbxassetid://100327482330650"
local DOORS_TEST_PLACE_ID = 6627207668

-- Камера
local isThirdPerson = true
local thirdPersonDistance = 12
local thirdPersonHeightOffset = 2

-- ============================================================
-- ЗАГРУЗКА МОДЕЛИ
-- ============================================================
local ok, figureNew = pcall(function()
    return game:GetObjects(RUSH_ASSET)[1]
end)

if not ok or not figureNew then
    warn("[Rush Morph] Не удалось загрузить модель Rush. Проверь asset id.")
    _G.RushMorphActive = false
    return
end

local isTestPlace = (game.GameId == DOORS_TEST_PLACE_ID)

figureNew.Parent = workspace

-- ============================================================
-- ЗВУКИ (копируем как в morphs.txt)
-- ============================================================
local Main = figureNew:FindFirstChild("Main")
local Footsteps, PlaySound

if Main then
    local Sounds = Main:FindFirstChild("Sounds")
    if Sounds then
        local soundFolder = isTestPlace and Sounds:FindFirstChild("test game")
                                            or Sounds:FindFirstChild("DOORS")
        if soundFolder then
            for _, s in pairs(soundFolder:GetChildren()) do
                s:Clone().Parent = Main
            end
        end
        Sounds:Destroy()
    end

    Footsteps = Main:FindFirstChild("Footsteps")
    PlaySound = Main:FindFirstChild("PlaySound")

    if Footsteps then Footsteps:Play() end
    if PlaySound then PlaySound:Play() end
end

-- ============================================================
-- АНИМАЦИЯ (если есть)
-- ============================================================
local RunAnim
local animator = figureNew:FindFirstChild("AnimationController")
                 and figureNew.AnimationController:FindFirstChild("Animator")

if animator then
    local animsFolder = figureNew:FindFirstChild(isTestPlace and "AnimationsTest" or "Animations")
    local runAnimObj = animsFolder and animsFolder:FindFirstChild("run")
    if runAnimObj then
        RunAnim = animator:LoadAnimation(runAnimObj)
        RunAnim:Play()
        RunAnim:AdjustSpeed(0)
    end
end

-- ============================================================
-- АНИМАЦИЯ ПО СКОРОСТИ + УСКОРЕНИЕ ШАГОВ
-- ============================================================
spawn(function()
    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local hum = char:WaitForChild("Humanoid")
    hum.Running:Connect(function(speed)
        if RunAnim then
            if speed >= 20 then
                RunAnim:AdjustSpeed(1.5)
            elseif speed >= 5 then
                RunAnim:AdjustSpeed(1)
            else
                RunAnim:AdjustSpeed(0)
            end
        end
        if Footsteps and Footsteps.IsPlaying then
            Footsteps.PlaybackSpeed = math.clamp(speed / 16, 0.6, 1.8)
        end
        if PlaySound and PlaySound.IsPlaying then
            PlaySound.PlaybackSpeed = math.clamp(speed / 16, 0.6, 1.8)
        end
    end)
end)

-- ============================================================
-- СИНХРОНИЗАЦИЯ + СКРЫТИЕ ИГРОКА + КАМЕРА
-- ============================================================
local renderConn = RunService.RenderStepped:Connect(function()
    local char = LocalPlayer.Character
    if not char then return end

    local head = char:FindFirstChild("Head")
    if head then head.Transparency = 1 end

    local hrp = char:FindFirstChild("HumanoidRootPart")
    if hrp and figureNew.Parent then
        pcall(function()
            figureNew:PivotTo(hrp.CFrame)
        end)
    end

    for _, v in pairs(char:GetChildren()) do
        if v:IsA("BasePart") then
            v.LocalTransparencyModifier = 1
            for _, d in pairs(v:GetDescendants()) do
                if d:IsA("Decal") or d:IsA("Texture") then
                    d.Transparency = 1
                end
            end
        elseif v:IsA("Accessory") then
            if v:FindFirstChild("Handle") then
                v.Handle.Transparency = 1
            end
        end
    end

    -- Камера от третьего лица
    local camera = workspace.CurrentCamera
    if camera and figureNew.Parent then
        local morphHead = figureNew:FindFirstChild("Head", true)
        if not morphHead then
            morphHead = figureNew:FindFirstChildWhichIsA("BasePart")
        end

        if morphHead then
            if isThirdPerson then
                camera.CameraType = Enum.CameraType.Scriptable
                local lookVector = camera.CFrame.LookVector
                local upVector = camera.CFrame.UpVector
                local headPos = morphHead.Position
                local camPos = headPos - (lookVector * thirdPersonDistance)
                               + Vector3.new(0, thirdPersonHeightOffset, 0)
                camera.CFrame = CFrame.lookAt(camPos, headPos, upVector)
            else
                camera.CameraType = Enum.CameraType.Custom
            end
        end
    end
end)

-- ============================================================
-- УПРАВЛЕНИЕ
-- ============================================================
LocalPlayer:GetMouse().KeyDown:Connect(function(key)
    if key == "r" then
        -- toggle звуков
        if Footsteps then
            if Footsteps.IsPlaying then Footsteps:Stop() else Footsteps:Play() end
        end
        if PlaySound then
            if PlaySound.IsPlaying then PlaySound:Stop() else PlaySound:Play() end
        end
    elseif key == "t" then
        -- крик
        local scream = Main and Main:FindFirstChild("Scream")
        if scream then scream:Play() end
    elseif key == "l" then
        -- toggle камеры
        isThirdPerson = not isThirdPerson
        if not isThirdPerson then
            local camera = workspace.CurrentCamera
            if camera then camera.CameraType = Enum.CameraType.Custom end
        end
    end
end)

print("[Rush Morph] Загружен! R — звуки, T — крик, L — камера")
