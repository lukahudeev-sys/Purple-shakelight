local function transformIntoRush()
    -- Сбрасываем старый флаг, чтобы морф мог запуститься
    _G.TransformedIntoAnyMorph = false

    local Players = game:GetService("Players")
    local RunService = game:GetService("RunService")

    local Player = Players.LocalPlayer
    local Character = Player.Character or Player.CharacterAdded:Wait()

    -- Загружаем модель Rush
    local Success, Objects = pcall(function()
        return game:GetObjects("rbxassetid://100327482330650")
    end)

    if not Success or not Objects or not Objects[1] then
        warn("Не удалось загрузить модель Rush")
        return
    end

    local Rush = Objects[1]
    Rush.Parent = workspace

    local Main = Rush:FindFirstChild("Main")

    if not Main then
        warn("У Rush не найден объект Main")
        Rush:Destroy()
        return
    end

    -- Копируем звуки под игру (как в оригинале morphs.txt)
    local Sounds = Main:FindFirstChild("Sounds")
    if Sounds then
        local testingPlace = (game.GameId == 6627207668)
        local soundFolder = testingPlace and Sounds:FindFirstChild("test game")
                                            or Sounds:FindFirstChild("DOORS")
        if soundFolder then
            for _, s in pairs(soundFolder:GetChildren()) do
                s:Clone().Parent = Main
            end
        end
        Sounds:Destroy()
    end

    _G.TransformedIntoAnyMorph = true

    -- Запускаем звуки
    local Footsteps = Main:FindFirstChild("Footsteps")
    local PlaySound = Main:FindFirstChild("PlaySound")

    if Footsteps then Footsteps:Play() end
    if PlaySound then PlaySound:Play() end

    -- Следим за персонажем
    RunService.RenderStepped:Connect(function()
        if not Rush or not Rush.Parent then return end

        Character = Player.Character
        if not Character then return end

        local RootPart = Character:FindFirstChild("HumanoidRootPart")
        if not RootPart then return end

        -- Перемещаем Rush вместе с игроком
        pcall(function()
            Rush:PivotTo(RootPart.CFrame)
        end)

        -- Скрываем обычного персонажа
        for _, Object in ipairs(Character:GetChildren()) do
            if Object:IsA("BasePart") then
                Object.LocalTransparencyModifier = 1
                for _, Child in ipairs(Object:GetDescendants()) do
                    if Child:IsA("Decal") or Child:IsA("Texture") then
                        Child.Transparency = 1
                    end
                end
            elseif Object:IsA("Accessory") then
                local Handle = Object:FindFirstChild("Handle")
                if Handle then
                    Handle.LocalTransparencyModifier = 1
                end
            end
        end
    end)

    -- R переключает звуки Rush
    Player:GetMouse().KeyDown:Connect(function(Key)
        if Key ~= "r" then return end

        if Footsteps then
            if Footsteps.IsPlaying then Footsteps:Stop() else Footsteps:Play() end
        end
        if PlaySound then
            if PlaySound.IsPlaying then PlaySound:Stop() else PlaySound:Play() end
        end
    end)

    print("Rush morph activated!")
end

-- Кнопка
mspaint.Groupbox:AddButton({
    Text = "Rush",
    Tooltip = "Transforms you into Rush",
    Func = transformIntoRush,
})
