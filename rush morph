-- Rush Morph (third person) — исправленная версия
-- Заменяет старый transformIntoRush
-- Управление: R — toggle звуков, L — toggle камеры

local player = game.Players.LocalPlayer

-- Настройки камеры
local isThirdPerson = true
local thirdPersonDistance = 12
local thirdPersonHeightOffset = 2

local function resetCamera()
    local camera = workspace.CurrentCamera
    if camera then
        camera.CameraType = Enum.CameraType.Custom
    end
end

-- Очистка предыдущего Rush-морфа, если был
if _G.RushMorphCleanup then
    pcall(_G.RushMorphCleanup)
end

local function transformIntoRush()
    print(">>> Rush button pressed!")
    print(">>> _G.TransformedIntoAnyMorph =", _G.TransformedIntoAnyMorph)

    -- НЕ блокируемся жёстко — сбрасываем флаг как в Ambush
    _G.TransformedIntoAnyMorph = false

    -- Загружаем модель
    local ok, objs = pcall(function()
        return game:GetObjects("rbxassetid://100327482330650")
    end)

    print(">>> GetObjects ok:", ok)
    print(">>> objs count:", objs and #objs or "nil")

    if not ok or not objs or not objs[1] then
        warn("[Rush] Не удалось загрузить модель rbxassetid://100327482330650")
        return
    end

    local figureNew = objs[1]
    print(">>> Loaded model:", figureNew.Name)

    local testingPlace = (game.GameId == 6627207668)

    figureNew.Parent = workspace

    _G.TransformedIntoAnyMorph = true

    -- === ЗВУКИ (безопасно) ===
    local Main = figureNew:FindFirstChild("Main")
    if not Main then
        warn("[Rush] В модели нет папки Main. Дочерние объекты:")
        for _, c in pairs(figureNew:GetChildren()) do
            print("   >", c.Name, "|", c.ClassName)
        end
    end

    local Footsteps, PlaySound

    if Main then
        local Sounds = Main:FindFirstChild("Sounds")
        if Sounds then
            local soundFolder = testingPlace and Sounds:FindFirstChild("test game")
                                                or Sounds:FindFirstChild("DOORS")
            if soundFolder then
                for _, s in pairs(soundFolder:GetChildren()) do
                    s:Clone().Parent = Main
                end
            end
            Sounds:Destroy()
        end

        Footsteps = Main:FindFirstChild("Footsteps")
        PlaySound = Main:FindFirstChild("PlaySound")
        if Footsteps then Footsteps:Play() end
        if PlaySound then PlaySound:Play() end
    end

    -- === АНИМАЦИЯ (безопасно) ===
    local RunAnim
    do
        local animator = figureNew:FindFirstChild("AnimationController")
                         and figureNew.AnimationController:FindFirstChild("Animator")
        if animator then
            local animsFolder = figureNew:FindFirstChild(testingPlace and "AnimationsTest" or "Animations")
            local runAnimObj = animsFolder and animsFolder:FindFirstChild("run")
            if runAnimObj then
                RunAnim = animator:LoadAnimation(runAnimObj)
                RunAnim:Play()
                RunAnim:AdjustSpeed(0)
            end
        end
    end

    -- === Привязка звуков к скорости ===
    spawn(function()
        local char = game.Players.LocalPlayer.Character or game.Players.LocalPlayer.CharacterAdded:Wait()
        local hum = char:WaitForChild("Humanoid")
        hum.Running:Connect(function(speed)
            if RunAnim then
                if speed >= 20 then
                    RunAnim:AdjustSpeed(1.5)
                elseif speed >= 5 then
                    RunAnim:AdjustSpeed(1)
                else
                    RunAnim:AdjustSpeed(0)
                end
            end
            if Footsteps and Footsteps.IsPlaying then
                Footsteps.PlaybackSpeed = math.clamp(speed / 16, 0.6, 1.8)
            end
            if PlaySound and PlaySound.IsPlaying then
                PlaySound.PlaybackSpeed = math.clamp(speed / 16, 0.6, 1.8)
            end
        end)
    end)

    -- === Основной RenderStepped: движение + камера ===
    local renderConnection = game:GetService("RunService").RenderStepped:Connect(function()
        local character = game.Players.LocalPlayer.Character
        if not character then return end

        if character:FindFirstChild("Head") then
            character.Head.Transparency = 1
        end

        local hrp = character:FindFirstChild("HumanoidRootPart")
        if hrp then
            pcall(function()
                figureNew:PivotTo(hrp.CFrame)
            end)
        end

        -- Скрываем части персонажа
        for _, v in pairs(character:GetChildren()) do
            if v:IsA("BasePart") then
                v.LocalTransparencyModifier = 1
                for _, d in pairs(v:GetDescendants()) do
                    if d:IsA("Decal") or d:IsA("Texture") then
                        d.Transparency = 1
                    end
                end
            elseif v:IsA("Accessory") then
                local h = v:FindFirstChild("Handle")
                if h then h.Transparency = 1 end
            end
        end

        -- Камера от третьего лица
        local camera = workspace.CurrentCamera
        if camera and figureNew and figureNew.Parent then
            local morphHead = figureNew:FindFirstChild("Head", true)
            if not morphHead then
                morphHead = figureNew:FindFirstChildWhichIsA("BasePart")
            end

            if morphHead then
                if isThirdPerson then
                    camera.CameraType = Enum.CameraType.Scriptable
                    local lookVector = camera.CFrame.LookVector
                    local upVector = camera.CFrame.UpVector
                    local headPos = morphHead.Position
                    local camPos = headPos - (lookVector * thirdPersonDistance) + Vector3.new(0, thirdPersonHeightOffset, 0)
                    camera.CFrame = CFrame.lookAt(camPos, headPos, upVector)
                else
                    camera.CameraType = Enum.CameraType.Custom
                end
            end
        end
    end)

    -- === Cleanup ===
    _G.RushMorphCleanup = function()
        if renderConnection then
            renderConnection:Disconnect()
            renderConnection = nil
        end
        resetCamera()
        if figureNew then
            figureNew:Destroy()
            figureNew = nil
        end
        _G.TransformedIntoAnyMorph = false
        _G.RushMorphCleanup = nil
    end

    -- === Управление ===
    game.Players.LocalPlayer:GetMouse().KeyDown:Connect(function(key)
        if key == "r" then
            if Footsteps then
                if Footsteps.IsPlaying then Footsteps:Stop() else Footsteps:Play() end
            end
            if PlaySound then
                if PlaySound.IsPlaying then PlaySound:Stop() else PlaySound:Play() end
            end
        elseif key == "l" then
            isThirdPerson = not isThirdPerson
            if not isThirdPerson then
                resetCamera()
            end
        end
    end)

    print(">>> Rush morph activated!")
end

-- === Подключение кнопки ===
print(">>> Registering Rush button...")
mspaint.Groupbox:AddButton({
    Text = 'Rush',
    Tooltip = 'Transforms you into Rush (third person)',
    Func = transformIntoRush,
})
print(">>> Rush button registered OK")
