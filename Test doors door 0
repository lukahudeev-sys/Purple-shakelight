local function SafeLoadFileCached(url)
task.spawn(function()
pcall(function()
local code = nil

-- Kiểm tra xem đã có trong RAM chưa  
        if MEMORY_CACHE[url] then  
            code = MEMORY_CACHE[url]  
        else  
            -- Nếu chưa có, tải về và lưu vào RAM  
            local success, result = pcall(function()  
                return game:HttpGet(url)  
            end)  
            if success and result and result ~= "" then  
                code = result  
                MEMORY_CACHE[url] = code  
            end  
        end  
          
        -- Thực thi mã nguồn  
        if code then  
            local func, err = loadstring(code)  
            if func then  
                func()  
            end  
        end  
    end)  
end)

end

