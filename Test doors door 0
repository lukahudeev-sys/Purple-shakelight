-- Скрипт только для двери (0)
-- Оригинальный код был сильно повреждён, поэтому восстановлена логика выхода из укрытия

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")

-- Функция восстановления коллизий после выхода
local function restoreCollision(Model)
    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    task.spawn(function()
        while true do
            local touching = false
            for _, part in ipairs(hrp:GetTouchingParts()) do
                if part:IsDescendantOf(Model) then
                    touching = true
                    break
                end
            end
            if not touching then break end
            task.wait()
        end

        for _, obj in ipairs(Model:GetDescendants()) do
            if obj:IsA("BasePart") then
                obj.CanCollide = true
                obj.CanTouch = true
            end
        end
    end)
end

-- Основная логика взаимодействия с дверью
local function HandleDoor(obj)
    if not (obj:IsA("Model") and obj.Name == "Door") then
        return
    end

    for _, v in ipairs(obj:GetDescendants()) do
        if v:IsA("ProximityPrompt") then
            v.Triggered:Connect(function(player)
                if player == LocalPlayer then return end

                local char = LocalPlayer.Character
                if not char then return end

                char:SetAttribute("Hiding", true)
                v.Enabled = false

                local hum = char:FindFirstChildOfClass("Humanoid")
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if not hum or not hrp then return end

                hum.AutoRotate = false

                local head = char:WaitForChild("Head")
                local cam = workspace.CurrentCamera
                cam.CameraType = Enum.CameraType.Scriptable

                local camCon
                camCon = RunService.RenderStepped:Connect(function()
                    if head.Parent then
                        cam.CFrame = head.CFrame
                    end
                end)

                hrp.Anchored = true

                local cf, size = obj:GetBoundingBox()
                local look = -obj.PrimaryPart.CFrame.LookVector
                local pos = cf.Position + Vector3.new(0, size.Y / 2 - 2, 0) + look * 1

                hrp.CFrame = CFrame.lookAt(pos, pos + look)

                TweenService:Create(
                    hrp,
                    TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
                    { CFrame = hrp.CFrame + Vector3.new(0, 3, 0) }
                ):Play()
                task.wait(0.25)

                local goal = hrp.CFrame - (obj.PrimaryPart.CFrame.LookVector * 2.3)
                local tween = TweenService:Create(
                    hrp,
                    TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
                    { CFrame = CFrame.new(goal.Position) * (hrp.CFrame - hrp.Position) }
                )
                tween:Play()
                tween.Completed:Wait()

                -- Выход из укрытия
                local animator = hum:FindFirstChildOfClass("Animator")
                if not animator then return end

                local exitAnim = Instance.new("Animation")
                exitAnim.AnimationId = "rbxassetid://10066064783"
                local exitTrack = animator:LoadAnimation(exitAnim)
                exitTrack.Priority = Enum.AnimationPriority.Action4
                exitTrack:Play()

                repeat task.wait() until exitTrack.Length > 0

                while exitTrack.IsPlaying do
                    task.wait()
                    if exitTrack.TimePosition >= exitTrack.Length - 0.01 then
                        exitTrack:Stop()

                        char:SetAttribute("Hiding", nil)

                        local exitGoal = hrp.CFrame + (hrp.CFrame.LookVector * 4.5)
                        local exitTween = TweenService:Create(
                            hrp,
                            TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
                            { CFrame = CFrame.new(exitGoal.Position) * (hrp.CFrame - hrp.Position) }
                        )
                        exitTween:Play()
                        exitTween.Completed:Wait()

                        for _, part in ipairs(char:GetDescendants()) do
                            if part:IsA("BasePart") then
                                part.CanCollide = true
                            end
                        end

                        for _, part in ipairs(obj:GetDescendants()) do
                            if part:IsA("BasePart") then
                                part.CanCollide = false
                                part.CanTouch = true
                            end
                        end

                        restoreCollision(obj)

                        hrp.Anchored = true
                        local finalCF = hrp.CFrame
                        exitTrack:Destroy()
                        exitAnim:Destroy()
                        hrp.CFrame = finalCF
                        task.wait()
                        hrp.Anchored = false
                        hrp.CFrame = finalCF
                        task.wait()
                        hrp.CFrame = finalCF
                        hrp.Anchored = false

                        if camCon then
                            camCon:Disconnect()
                            camCon = nil
                        end

                        cam.CameraType = Enum.CameraType.Custom
                        v.Enabled = true
                        break
                    end
                end
            end)
        end
    end
end

-- Поиск дверей в текущих комнатах
local CurrentRooms = workspace:FindFirstChild("CurrentRooms")
if CurrentRooms then
    for _, obj in ipairs(CurrentRooms:GetDescendants()) do
        HandleDoor(obj)
    end
    CurrentRooms.DescendantAdded:Connect(HandleDoor)
end
