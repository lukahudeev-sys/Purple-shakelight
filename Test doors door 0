local CooldownPaused = false

local function WaitCooldown()
	local pauseStart = nil

	while CooldownPaused or getgenv().multi == true or getgenv().FrostbiteHere == true do
		if not pauseStart then
			pauseStart = tick()
		end

		task.wait(0.2)
	end

	if pauseStart then
		return tick() - pauseStart
	end

	return 0
end

