-- ══════════════════════════════════════════════════
--  Ставить / убирать
-- ══════════════════════════════════════════════════
local function raycastAt(origin, direction)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local ignore = {tool, gui}
    if heldBlock then table.insert(ignore, heldBlock) end
    if LP.Character then table.insert(ignore, LP.Character) end
    params.FilterDescendantsInstances = ignore
    return workspace:Raycast(origin, direction, params)
end

local function raycastFromMouse()
    local ur = mouse.UnitRay
    return raycastAt(ur.Origin, ur.Direction * MAX_DISTANCE)
end

local function raycastFromCenter()
    local cam = workspace.CurrentCamera
    local ur = cam:ViewportPointToRay(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
    return raycastAt(ur.Origin, ur.Direction * MAX_DISTANCE)
end

local function makeBlock(pos, data)
    local p = Instance.new("Part")
    p.Size          = Vector3.new(SIZE, SIZE, SIZE)
    p.Position      = pos
    p.Anchored      = true
    p.CanCollide    = true
    p.Material      = Enum.Material.SmoothPlastic
    p.Color         = Color3.fromRGB(255, 255, 255)
    p.TopSurface    = Enum.SurfaceType.Smooth
    p.BottomSurface = Enum.SurfaceType.Smooth
    p:SetAttribute("PlacedBlock", true)
    applyBlockVisual(p, data)
    p.Parent = workspace

    table.insert(placed, p)
    while #placed > MAX_BLOCKS do
        local old = table.remove(placed, 1)
        if old and old.Parent then old:Destroy() end
    end
end

local function tryPlace(hit)
    if not hit then return end
    local sh = Vector3.new(snap(hit.Position.X), snap(hit.Position.Y), snap(hit.Position.Z))
    local pos = sh + hit.Normal * SIZE
    makeBlock(Vector3.new(snap(pos.X), snap(pos.Y), snap(pos.Z)), BLOCKS[current])
end

local function tryBreak(hit)
    if hit and hit.Instance:GetAttribute("PlacedBlock") then
        hit.Instance:Destroy()
    end
end

local function cycleBlock()
    current = current % #BLOCKS + 1
    updateSelection()
end

-- ══════════════════════════════════════════════════
--  Экипировка
-- ══════════════════════════════════════════════════
local equipped = false

tool.Equipped:Connect(function()
    equipped = true
    frame.Visible = true
    createHeldBlock()
    if IS_MOBILE and mobilePlaceBtn then
        mobilePlaceBtn.Visible  = true
        mobileBreakBtn.Visible  = true
        mobileSwitchBtn.Visible = true
    end
end)

tool.Unequipped:Connect(function()
    equipped = false
    frame.Visible = false
    destroyHeldBlock()
    if IS_MOBILE and mobilePlaceBtn then
        mobilePlaceBtn.Visible  = false
        mobileBreakBtn.Visible  = false
        mobileSwitchBtn.Visible = false
    end
end)

-- ══════════════════════════════════════════════════
--  Управление ПК
-- ══════════════════════════════════════════════════
UIS.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.R and equipped then
        cycleBlock()
    end
end)

UIS.InputBegan:Connect(function(input, gp)
    if input.UserInputType ~= Enum.UserInputType.MouseButton2 then return end
    if not equipped then return end
    tryPlace(raycastFromMouse())
end)

tool.Activated:Connect(function()
    if not equipped then return end
    tryBreak(raycastFromMouse())
end)

-- ══════════════════════════════════════════════════
--  Управление Телефон
-- ══════════════════════════════════════════════════
if IS_MOBILE then
    mobilePlaceBtn.MouseButton1Click:Connect(function()
        tryPlace(raycastFromCenter())
    end)

    mobileBreakBtn.MouseButton1Click:Connect(function()
        tryBreak(raycastFromCenter())
    end)

    mobileSwitchBtn.MouseButton1Click:Connect(function()
        cycleBlock()
    end)
end

LP.CharacterAdded:Connect(function()
    task.wait(0.5)
    if equipped then createHeldBlock() end
end)

tool.Parent = backpack
