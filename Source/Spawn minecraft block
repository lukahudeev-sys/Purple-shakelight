local buttons = {}

local function updateSelection()
    for i, data in ipairs(BLOCKS) do
        local btn = buttons[i]
        if btn then
            if i == current then
                btn.BackgroundColor3 = data.color
                btn.TextColor3       = Color3.fromRGB(0, 0, 0)
            else
                btn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
                btn.TextColor3       = Color3.fromRGB(255, 255, 255)
            end
        end
    end
    
    local h = tool:FindFirstChild("Handle")
    if h then h.Color = BLOCKS[current].color end
    if heldBlock then applyBlockVisual(heldBlock, BLOCKS[current]) end
    
    local texId = BLOCKS[current].texture
    if (not texId or texId == 0) and BLOCKS[current].fallback then
        texId = BLOCKS[current].fallback
    end
    if texId and texId ~= 0 then
        tool.TextureId = "rbxassetid://" .. texId
    else
        tool.TextureId = ""
    end
end

