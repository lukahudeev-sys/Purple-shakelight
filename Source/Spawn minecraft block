if not LP.Character then LP.CharacterAdded:Wait() end
local mouse     = LP:GetMouse()
local backpack  = LP:WaitForChild("Backpack")
local playerGui = LP:WaitForChild("PlayerGui")

local IS_MOBILE = UIS.TouchEnabled and not UIS.KeyboardEnabled

local TOOL_ID = 140620012279196

-- ┌──────────────────────────────────────────────────────────┐
-- │  ТЕКСТУРЫ БЛОКОВ (те, что заработали)                     │
local BLOCKS = {
    { name = "Diamond Block", texture = 5012801290, color = Color3.fromRGB(90, 220, 255) },
    { name = "Command Block", texture = 101892211863547, fallback = 168673770, color = Color3.fromRGB(220, 140, 60) },
}
-- └──────────────────────────────────────────────────────────┘

local SIZE         = 4
local MAX_DISTANCE = 30
local MAX_BLOCKS   = 300

local placed  = {}
local current = 1

local function snap(v)
    return math.floor(v / SIZE + 0.5) * SIZE
end

-- ══════════════════════════════════════════════════
--  Загрузка Tool
-- ══════════════════════════════════════════════════
local function safeGet(id, timeout)
    timeout = timeout or 5
    local done, result = false, nil
    task.spawn(function()
        local ok, res = pcall(function()
            return game:GetObjects("rbxassetid://" .. id)
        end)
        if ok then result = res end
        done = true
    end)
    local start = tick()
    while not done and (tick() - start) < timeout do task.wait(0.05) end
    return result
end

local tool
local objects = safeGet(TOOL_ID)
if objects and #objects > 0 then
    tool = objects[1]:IsA("Tool") and objects[1]
        or objects[1]:FindFirstChildWhichIsA("Tool")
end

if not tool then
    tool = Instance.new("Tool")
    tool.Name           = "Block Placer"
    tool.RequiresHandle = true
    tool.CanBeDropped   = false
    tool.ToolTip        = "ПКМ ставит | ЛКМ убирает | R меняет блок"

    local handle = Instance.new("Part")
    handle.Name       = "Handle"
    handle.Size       = Vector3.new(1.2, 1.2, 1.2)
    handle.Material   = Enum.Material.Neon
    handle.Color      = BLOCKS[1].color
    handle.CanCollide = false
    handle.Massless   = true
    handle.Parent     = tool
end

for _, c in ipairs({backpack, LP.Character}) do
    if c then
        local old = c:FindFirstChild(tool.Name)
        if old then old:Destroy() end
    end
end

-- ══════════════════════════════════════════════════
--  Визуал блока (Возвращаем Decal - 1 картинка на грань)
-- ══════════════════════════════════════════════════
local FACES = {
    Enum.NormalId.Front, Enum.NormalId.Back,
    Enum.NormalId.Left,  Enum.NormalId.Right,
    Enum.NormalId.Top,   Enum.NormalId.Bottom,
}

local heldBlock, heldWeld

local function applyBlockVisual(part, data)
    for _, d in ipairs(part:GetChildren()) do
        if d:IsA("Decal") or d:IsA("Texture") then
            d:Destroy()
        end
    end

    local texId = data.texture
    if (not texId or texId == 0) and data.fallback then
        texId = data.fallback
    end

    if texId and texId ~= 0 then
        part.Color = Color3.fromRGB(255, 255, 255)
        for _, face in ipairs(FACES) do
            local d = Instance.new("Decal") -- Используем Decal!
            d.Face    = face
            d.Texture = "rbxassetid://" .. texId
            d.Parent  = part
        end
    else
        part.Color = data.color
    end
end

local function destroyHeldBlock()
    if heldWeld  then heldWeld:Destroy();  heldWeld  = nil end
    if heldBlock then heldBlock:Destroy(); heldBlock = nil end
end

local function createHeldBlock()
    destroyHeldBlock()
    local char = LP.Character
    if not char then return end
    local rightHand = char:FindFirstChild("RightHand") or char:FindFirstChild("Right Arm")
    if not rightHand then return end

    heldBlock = Instance.new("Part")
    heldBlock.Name        = "HeldBlockVisual"
    heldBlock.Size        = Vector3.new(1.4, 1.4, 1.4)
    heldBlock.Material    = Enum.Material.SmoothPlastic
    heldBlock.CanCollide  = false
    heldBlock.CanTouch    = false
    heldBlock.CanQuery    = false
    heldBlock.Massless    = true

    applyBlockVisual(heldBlock, BLOCKS[current])

    heldWeld = Instance.new("Weld")
    heldWeld.Part0 = rightHand
    heldWeld.Part1 = heldBlock
    heldWeld.C0    = CFrame.new(0, -0.6, 0) * CFrame.Angles(0, math.rad(45), 0)
    heldWeld.Parent = heldBlock

    heldBlock.Parent = char
end

