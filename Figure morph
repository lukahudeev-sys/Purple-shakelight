-- === ТРЕТЬЕ ЛИЦО: КАМЕРА ЧЕРЕЗ MOUSE ОБЪЕКТ ===
local player = game.Players.LocalPlayer
local camera = workspace.CurrentCamera
local RunService = game:GetService("RunService")
local UIS = game:GetService("UserInputService")
local mouse = player:GetMouse()

-- Настройки
local DISTANCE = 14
local HEIGHT = 3
local SENSITIVITY = 0.5
local rotX = 0
local rotY = 15

-- Camera Scriptable — Roblox не трогает
camera.CameraType = Enum.CameraType.Scriptable

-- Пытаемся захватить мышь (некоторые экзекуторы блокируют — не страшно)
pcall(function()
    UIS.MouseBehavior = Enum.MouseBehavior.LockCenter
end)

-- Отключаем родной PlayerModule
pcall(function()
    local pm = player:WaitForChild("PlayerScripts"):FindFirstChild("PlayerModule")
    if pm then
        local mod = require(pm)
        for _, cam in pairs(mod:GetCameras()) do
            if cam.SetActive then pcall(function() cam:SetActive(false) end) end
        end
    end
end)

-- Следим за позицией курсора. Если мышь не залочена — считаем дельту сами
local lastMousePos = UIS:GetMouseLocation()

UIS.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement then
        rotX = rotX - input.Delta.X * SENSITIVITY
        rotY = math.clamp(rotY - input.Delta.Y * SENSITIVITY, -60, 70)
    end
end)

-- Fallback: если InputChanged не работает — считаем дельту из GetMouseLocation
task.spawn(function()
    while task.wait(0.016) do
        local cur = UIS:GetMouseLocation()
        local delta = cur - lastMousePos
        -- Если мышь не залочена — используем свой расчёт
        if UIS.MouseBehavior ~= Enum.MouseBehavior.LockCenter then
            if math.abs(delta.X) > 0 and math.abs(delta.X) < 200 then
                rotX = rotX - delta.X * SENSITIVITY
                rotY = math.clamp(rotY - delta.Y * SENSITIVITY, -60, 70)
            end
        end
        lastMousePos = cur
    end
end)

-- Пытаемся залочить мышь постоянно
task.spawn(function()
    while task.wait(0.1) do
        pcall(function()
            UIS.MouseBehavior = Enum.MouseBehavior.LockCenter
            UIS.MouseIconEnabled = false
        end)
    end
end)

-- Основной цикл камеры — максимальный приоритет
RunService:BindToRenderStep("FigureCamera", Enum.RenderPriority.Camera.Value + 10, function()
    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    if camera.CameraType ~= Enum.CameraType.Scriptable then
        camera.CameraType = Enum.CameraType.Scriptable
    end

    local target = hrp.Position + Vector3.new(0, 2, 0)
    local radX = math.rad(rotX)
    local radY = math.rad(rotY)

    local offset = Vector3.new(
        math.sin(radX) * math.cos(radY),
        math.sin(radY),
        math.cos(radX) * math.cos(radY)
    ) * DISTANCE

    local camPos = target + offset + Vector3.new(0, HEIGHT, 0)
    camera.CFrame = CFrame.new(camPos, target)
    camera.Focus = CFrame.new(target)
end)

-- Запуск морфа
transformIntoFigure()
