-- ============================================================
-- RUSH BOTTLE → MORPH (от третьего лица)
-- Основано на рабочем ambush potion.txt
-- ============================================================

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local LocalPlayer = Players.LocalPlayer

-- ============================================================
-- ЖДЁМ BACKPACK
-- ============================================================
local backpack = LocalPlayer:FindFirstChild("Backpack")
if not backpack then
    backpack = LocalPlayer:WaitForChild("Backpack", 10)
end
if not backpack then
    warn("[Rush] ❌ Backpack не найден")
    return
end

-- ============================================================
-- ЗАГРУЖАЕМ БУТЫЛКУ (пробуем несколько ID)
-- ============================================================
local toolNew
for _, id in ipairs({140419135012621, 111263531009426, 83996348420126}) do
    local ok, objs = pcall(function()
        return game:GetObjects("rbxassetid://" .. id)
    end)
    if ok and objs and objs[1] then
        toolNew = objs[1]
        print("[Rush] ✅ Бутылка загружена с ID:", id)
        break
    else
        warn("[Rush] ❌ ID не сработал:", id)
    end
end

if not toolNew then
    warn("[Rush] ❌ Не удалось загрузить бутылку")
    return
end

toolNew.Parent = backpack
toolNew.Name = "Rush Bottle"
toolNew.TextureId = "rbxassetid://76865808847706"
print("[Rush] ✅ Предмет выдан в Backpack")

-- ============================================================
-- RUSH MORPH
-- ============================================================
local RUSH_ASSET = 78888776904283
local MORPH_DURATION = 60 -- ⏱ длительность морфа в секундах

local morphActive = false
local isThirdPerson = true

local Rush = nil
local enforceLoop, inputConnection, morphTimer = nil, nil, nil
local Footsteps, PlaySound = nil, nil

-- ============================================================
-- CLEANUP
-- ============================================================
local function cleanupMorph()
    if inputConnection then inputConnection:Disconnect() inputConnection = nil end
    if enforceLoop then enforceLoop:Disconnect() enforceLoop = nil end
    if morphTimer then task.cancel(morphTimer) morphTimer = nil end

    local camera = workspace.CurrentCamera
    if camera then camera.CameraType = Enum.CameraType.Custom end

    -- Возвращаем тело игрока
    local Character = LocalPlayer.Character
    if Character then
        for _, Object in ipairs(Character:GetDescendants()) do
            if Object:IsA("BasePart") then
                Object.LocalTransparencyModifier = 0
                Object.Transparency = 0
                Object.CanCollide = true
            elseif Object:IsA("Decal") or Object:IsA("Texture") then
                Object.Transparency = 0
            end
        end
        for _, v in pairs(Character:GetChildren()) do
            if v:IsA("Accessory") and v:FindFirstChild("Handle") then
                v.Handle.Transparency = 0
                v.Handle.LocalTransparencyModifier = 0
            end
        end
    end

    if Footsteps then Footsteps:Stop() Footsteps = nil end
    if PlaySound then PlaySound:Stop() PlaySound = nil end

    if Rush then
        Rush:Destroy()
        Rush = nil
    end

    morphActive = false
    print("[Rush] 🔄 Морф снят")
end

-- ============================================================
-- CORE MORPH
-- ============================================================
local function applyMorph()
    if morphActive then cleanupMorph() end

    print("[Rush] Загружаю модель Rush, ID:", RUSH_ASSET)

    local Success, Objects = pcall(function()
        return game:GetObjects("rbxassetid://" .. RUSH_ASSET)
    end)

    print("[Rush] ok =", Success, "| count =", Objects and #Objects or "nil")

    if not Success or not Objects or not Objects[1] then
        warn("[Rush] ❌ Не удалось загрузить модель Rush")
        print("[Rush] Попробуй другой ID. Сейчас в скрипте:", RUSH_ASSET)
        return
    end

    Rush = Objects[1]
    print("[Rush] ✅ Модель загружена:", Rush.Name)
    print("[Rush] --- Дети модели ---")
    for _, c in pairs(Rush:GetChildren()) do
        print("[Rush]   >", c.Name, "|", c.ClassName)
    end

    Rush.Parent = workspace

    -- Ищем Main или fallback
    local Main = Rush:FindFirstChild("Main")
    if not Main then
        warn("[Rush] Нет 'Main', использую корень модели")
        Main = Rush
    end

    -- Звуки (безопасно)
    Footsteps = Main:FindFirstChild("Footsteps")
    PlaySound = Main:FindFirstChild("PlaySound")
    if Footsteps then Footsteps:Play() end
    if PlaySound then PlaySound:Play() end

    -- Камера
    local camera = workspace.CurrentCamera
    if camera then camera.CameraType = Enum.CameraType.Scriptable end

    -- ============================================================
    -- FOLLOW LOOP + КАМЕРА
    -- ============================================================
    enforceLoop = RunService.RenderStepped:Connect(function()
        if not Rush or not Rush.Parent then return end

        local Character = LocalPlayer.Character
        if not Character then return end

        local RootPart = Character:FindFirstChild("HumanoidRootPart")
        if not RootPart then return end

        -- Перемещаем Rush за игроком
        pcall(function()
            Rush:PivotTo(RootPart.CFrame)
        end)

        -- Скрываем тело игрока
        for _, Object in ipairs(Character:GetDescendants()) do
            if Object:IsA("BasePart") then
                Object.LocalTransparencyModifier = 1
                for _, Child in ipairs(Object:GetDescendants()) do
                    if Child:IsA("Decal") or Child:IsA("Texture") then
                        Child.Transparency = 1
                    end
                end
            elseif Object:IsA("Accessory") then
                local Handle = Object:FindFirstChild("Handle")
                if Handle then
                    Handle.LocalTransparencyModifier = 1
                end
            end
        end

        -- 🎥 КАМЕРА ОТ ТРЕТЬЕГО ЛИЦА
        if camera then
            -- Ищем Head у Rush для привязки камеры
            local morphHead = Rush:FindFirstChild("Head", true)
            if not morphHead then
                morphHead = Rush:FindFirstChildWhichIsA("BasePart")
            end

            local targetPos
            if morphHead then
                targetPos = morphHead.Position
            else
                targetPos = RootPart.Position + Vector3.new(0, 1.5, 0)
            end

            local lookVector = camera.CFrame.LookVector
            local upVector = camera.CFrame.UpVector

            if isThirdPerson then
                local camPos = targetPos - (lookVector * 12) + Vector3.new(0, 2, 0)
                camera.CFrame = CFrame.lookAt(camPos, targetPos, upVector)
            else
                local camPos = targetPos + lookVector * 0.5
                camera.CFrame = CFrame.lookAt(camPos, camPos + lookVector, upVector)
            end
        end
    end)

    -- ============================================================
    -- INPUT: R — звуки, L — 1/3 лицо
    -- ============================================================
    inputConnection = UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        if input.UserInputType == Enum.UserInputType.Keyboard then
            if input.KeyCode == Enum.KeyCode.R then
                if Footsteps then
                    if Footsteps.IsPlaying then Footsteps:Stop() else Footsteps:Play() end
                end
                if PlaySound then
                    if PlaySound.IsPlaying then PlaySound:Stop() else PlaySound:Play() end
                end
            elseif input.KeyCode == Enum.KeyCode.L then
                isThirdPerson = not isThirdPerson
            end
        end
    end)

    morphActive = true
    print("[Rush] ✅ Rush morph activated! R — звуки, L — 1/3 лицо")

    -- ⏱ Таймер: через MORPH_DURATION секунд морф исчезает
    morphTimer = task.delay(MORPH_DURATION, function()
        cleanupMorph()
    end)
end

-- ============================================================
-- АКТИВАЦИЯ ЗЕЛЬЯ → МОРФ
-- ============================================================
local drinked = false

toolNew.Activated:Connect(function()
    if drinked then return end
    drinked = true

    print("[Rush] 🍶 Зелье выпито, превращаюсь в Rush...")

    -- Звук выпивания
    local newSound = workspace:FindFirstChild("DrinkPotionAddonSound")
    if not newSound then
        newSound = Instance.new("Sound", workspace)
        newSound.Name = "DrinkPotionAddonSound"
        if game.GameId == 6627207668 then
            newSound.SoundId = "rbxassetid://103799151859408"
        else
            newSound.SoundId = "rbxassetid://18869124055"
        end
    end
    newSound:Play()

    -- Морф
    task.defer(function()
        pcall(applyMorph)
    end)

    toolNew:Destroy()
end)
