-- ЭФФЕКТ НА ЭКРАНЕ
-- ============================================================
local newCloneEffect = MainUI.MainFrame.Healthbar.Effects.HerbGreenEffect:Clone()
newCloneEffect.Name = "GuidingLightPotion"
newCloneEffect.Visible = false
newCloneEffect.Parent = MainUI.MainFrame.Healthbar.Effects

local function drinkSoundPlay()
    local newSound = workspace:FindFirstChild("DrinkPotionAddonSound")
    if not newSound then
        newSound = Instance.new("Sound", workspace)
        newSound.Name = "DrinkPotionAddonSound"
        if game.GameId == 6627207668 then
            newSound.SoundId = "rbxassetid://103799151859408"
        else
            newSound.SoundId = "rbxassetid://18869124055"
        end
    end
    newSound:Play()
end

local function EffectOnScreen()
    drinkSoundPlay()
    newCloneEffect.Visible = true
    spawn(function()
        local clone = MainUI.MainFrame.WhiteVignette:Clone()
        if clone then
            local clone_2 = clone:Clone()
            clone_2.Name = "Live"
            clone_2.ImageColor3 = Color3.fromRGB(142, 255, 153)
            clone_2.ImageTransparency = 1
            clone_2.Parent = MainUI.MainFrame
            clone_2.Visible = true
            TweenService:Create(clone_2, TweenInfo.new(0.5, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
                ImageTransparency = 0
            }):Play()
            wait(5)
            TweenService:Create(clone_2, TweenInfo.new(5, Enum.EasingStyle.Linear, Enum.EasingDirection.Out), {
                Size = UDim2.new(1.5, 0, 1.5, 0)
            }):Play()
            wait(0.5)
            TweenService:Create(clone_2, TweenInfo.new(4.5, Enum.EasingStyle.Quart, Enum.EasingDirection.InOut), {
                ImageTransparency = 1
            }):Play()
            wait(4.5)
            clone_2:Destroy()
        end
    end)
end

-- ============================================================
-- AMBUSH MORPH ENGINE (через PivotTo, как в Seek)
-- ============================================================
local AMBUSH_ASSET = 98266611233960

local morphActive = false
local isThirdPerson = true
local morph = nil
local originalCharacter, originalRootPart, originalHumanoid = nil, nil, nil
local originalWalkSpeed, originalJumpPower, originalJumpHeight = 16, 50, 7.2
local enforceLoop, inputConnection = nil, nil

local function cleanupMorph()
    if inputConnection then inputConnection:Disconnect() inputConnection = nil end
    if enforceLoop then enforceLoop:Disconnect() enforceLoop = nil end

    local camera = workspace.CurrentCamera
    if camera then camera.CameraType = Enum.CameraType.Custom end

    if originalCharacter then
        for _, part in ipairs(originalCharacter:GetDescendants()) do
            if part:IsA("BasePart") then
                part.Transparency = 0
                part.LocalTransparencyModifier = 0
                part.CanCollide = true
            elseif part:IsA("Decal") or part:IsA("Texture") then
                part.Transparency = 0
            end
        end
        for _, v in pairs(originalCharacter:GetChildren()) do
            if v:IsA("Accessory") and v:FindFirstChild("Handle") then
                v.Handle.Transparency = 0
            end
        end
    end

    if originalHumanoid then
        originalHumanoid.WalkSpeed = originalWalkSpeed
        originalHumanoid.JumpPower = originalJumpPower
        if originalJumpHeight then
            originalHumanoid.JumpHeight = originalJumpHeight
        end
    end

    if morph then
        morph:Destroy()
        morph = nil
    end

    morphActive = false
end

local function applyMorph()
    if morphActive then cleanupMorph() end

    local ok, objs = pcall(function()
        return game:GetObjects("rbxassetid://" .. AMBUSH_ASSET)
    end)

    if not ok or not objs or not objs[1] then
        warn("[Ambush] ❌ Не удалось загрузить модель Ambush")
        return
    end

    morph = objs[1]
    print("[Ambush] ✅ Модель Ambush загружена:", morph.Name)

    local Main = morph:FindFirstChild("Main")
    if not Main then
        warn("[Ambush] ❌ У Ambush не найден объект Main")
        morph:Destroy()
        morph = nil
        return
    end

    originalCharacter = LocalPlayer.Character
    if not originalCharacter or not originalCharacter:FindFirstChild("HumanoidRootPart") then
        warn("[Ambush] ❌ Нет HumanoidRootPart")
        return
    end

    originalRootPart = originalCharacter:FindFirstChild("HumanoidRootPart")
    originalHumanoid = originalCharacter:FindFirstChildWhichIsA("Humanoid")
    if not originalRootPart or not originalHumanoid then
        warn("[Ambush] ❌ Нет Humanoid")
        return
    end

    originalWalkSpeed = originalHumanoid.WalkSpeed
    originalJumpPower = originalHumanoid.JumpPower
    originalJumpHeight = originalHumanoid.JumpHeight

    morph.Parent = workspace

    local morphHumanoid = morph:FindFirstChildWhichIsA("Humanoid")
    if morphHumanoid then morphHumanoid:Destroy() end

    for _, part in ipairs(morph:GetDescendants()) do
        if part:IsA("BasePart") then
            part.Anchored = false
            part.CanCollide = false
        end
    end

    morph:PivotTo(originalRootPart.CFrame)

    for _, part in ipairs(originalCharacter:GetDescendants()) do
        if part:IsA("BasePart") then
            part.LocalTransparencyModifier = 1
            part.Transparency = 1
            part.CanCollide = false
        elseif part:IsA("Decal") or part:IsA("Texture") then
            part.Transparency = 1
        end
    end
    for _, v in pairs(originalCharacter:GetChildren()) do
        if v:IsA("Accessory") and v:FindFirstChild("Handle") then
            v.Handle.Transparency = 1
        end
    end

    local camera = workspace.CurrentCamera
    if camera then camera.CameraType = Enum.CameraType.Scriptable end

    local Footsteps = Main:FindFirstChild("Footsteps")
    local PlaySound = Main:FindFirstChild("PlaySound")
    if Footsteps then Footsteps:Play() end
    if PlaySound then PlaySound:Play() end

    enforceLoop = RunService.RenderStepped:Connect(function()
        local char = LocalPlayer.Character
        if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end

        if morph and morph.Parent then
            morph:PivotTo(hrp.CFrame)
        end

        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                part.LocalTransparencyModifier = 1
            elseif part:IsA("Decal") or part:IsA("Texture") then
                part.Transparency = 1
            end
        end
        for _, v in pairs(char:GetChildren()) do
            if v:IsA("Accessory") and v:FindFirstChild("Handle") then
                v.Handle.Transparency = 1
            end
        end

        if camera then
            local headPos = hrp.Position + Vector3.new(0, 1.5, 0)
            local lookVector = camera.CFrame.LookVector
            local upVector = camera.CFrame.UpVector

            if isThirdPerson then
                local camPos = headPos - (lookVector * 12) + Vector3.new(0, 2, 0)
                camera.CFrame = CFrame.lookAt(camPos, headPos, upVector)
            else
                local camPos = headPos + lookVector * 0.5
                camera.CFrame = CFrame.lookAt(camPos, camPos + lookVector, upVector)
            end
        end
    end)

    inputConnection = UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        if input.UserInputType == Enum.UserInputType.Keyboard then
            if input.KeyCode == Enum.KeyCode.R then
                if Footsteps then
                    if Footsteps.IsPlaying then Footsteps:Stop() else Footsteps:Play() end
                end
                if PlaySound then
                    if PlaySound.IsPlaying then PlaySound:Stop() else PlaySound:Play() end
                end
            elseif input.KeyCode == Enum.KeyCode.L then
                isThirdPerson = not isThirdPerson
            end
        end
    end)

    morphActive = true
    print("[Ambush] ✅ Ambush привязан к игроку")
end

