local function transformIntoAmbush()
    -- Сбрасываем старый флаг
    _G.TransformedIntoAnyMorph = false

    local Players = game:GetService("Players")
    local RunService = game:GetService("RunService")
    local UserInputService = game:GetService("UserInputService")

    local LocalPlayer = Players.LocalPlayer

    -- ============================================================
    -- ЗАГРУЗКА МОДЕЛИ (как в Seek)
    -- ============================================================
    local AMBUSH_ASSET = 98266611233960

    local objects = game:GetObjects("rbxassetid://" .. AMBUSH_ASSET)
    if not objects or not objects[1] then
        warn("[Ambush Morph] Не удалось загрузить модель")
        return
    end

    local Ambush = objects[1]
    Ambush.Parent = workspace

    -- ============================================================
    -- ПРОВЕРКА MAIN
    -- ============================================================
    local Main = Ambush:FindFirstChild("Main")
    if not Main then
        warn("[Ambush Morph] У Ambush не найден объект Main")
        Ambush:Destroy()
        return
    end

    _G.TransformedIntoAnyMorph = true

    -- ============================================================
    -- ОРИГИНАЛЬНЫЙ ПЕРСОНАЖ
    -- ============================================================
    local originalCharacter = LocalPlayer.Character
    if not originalCharacter then
        warn("[Ambush Morph] Нет персонажа")
        Ambush:Destroy()
        return
    end

    local originalRootPart = originalCharacter:FindFirstChild("HumanoidRootPart")
    local originalHumanoid = originalCharacter:FindFirstChildWhichIsA("Humanoid")
    if not originalRootPart or not originalHumanoid then
        warn("[Ambush Morph] Нет HumanoidRootPart/Humanoid")
        Ambush:Destroy()
        return
    end

    -- ============================================================
    -- УБИРАЕМ HUMANOID У МОДЕЛИ (как в Seek)
    -- ============================================================
    local morphHumanoid = Ambush:FindFirstChildWhichIsA("Humanoid")
    if morphHumanoid then
        morphHumanoid:Destroy()
    end

    for _, part in ipairs(Ambush:GetDescendants()) do
        if part:IsA("BasePart") then
            part.Anchored = false
            part.CanCollide = false
        end
    end

    -- Ставим Ambush на игрока СРАЗУ
    Ambush:PivotTo(originalRootPart.CFrame)

    -- ============================================================
    -- СКРЫВАЕМ ТЕЛО ИГРОКА
    -- ============================================================
    for _, part in ipairs(originalCharacter:GetDescendants()) do
        if part:IsA("BasePart") then
            part.LocalTransparencyModifier = 1
            part.Transparency = 1
            part.CanCollide = false
        elseif part:IsA("Decal") or part:IsA("Texture") then
            part.Transparency = 1
        end
    end

    for _, v in pairs(originalCharacter:GetChildren()) do
        if v:IsA("Accessory") and v:FindFirstChild("Handle") then
            v.Handle.Transparency = 1
        end
    end

    -- ============================================================
    -- КАМЕРА
    -- ============================================================
    local camera = workspace.CurrentCamera
    if camera then
        camera.CameraType = Enum.CameraType.Scriptable
    end

    -- ============================================================
    -- ЗВУКИ
    -- ============================================================
    local Footsteps = Main:FindFirstChild("Footsteps")
    local PlaySound = Main:FindFirstChild("PlaySound")

    if Footsteps then Footsteps:Play() end
    if PlaySound then PlaySound:Play() end

    -- ============================================================
    -- ENFORCE LOOP — PivotTo каждый кадр (как в Seek)
    -- ============================================================
    local enforceLoop = RunService.RenderStepped:Connect(function()
        local char = LocalPlayer.Character
        if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end

        if Ambush and Ambush.Parent then
            Ambush:PivotTo(hrp.CFrame)
        end

        -- Скрываем тело игрока каждый кадр
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                part.LocalTransparencyModifier = 1
            elseif part:IsA("Decal") or part:IsA("Texture") then
                part.Transparency = 1
            end
        end
        for _, v in pairs(char:GetChildren()) do
            if v:IsA("Accessory") and v:FindFirstChild("Handle") then
                v.Handle.Transparency = 1
            end
        end

        -- Камера от третьего лица
        if camera then
            local headPos = hrp.Position + Vector3.new(0, 1.5, 0)
            local lookVector = camera.CFrame.LookVector
            local upVector = camera.CFrame.UpVector
            local camPos = headPos - (lookVector * 12) + Vector3.new(0, 2, 0)
            camera.CFrame = CFrame.lookAt(camPos, headPos, upVector)
        end
    end)

    -- ============================================================
    -- INPUT — R переключает звуки (как было)
    -- ============================================================
    local inputConnection
    inputConnection = UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        if input.UserInputType == Enum.UserInputType.Keyboard then
            if input.KeyCode == Enum.KeyCode.R then
                if Footsteps then
                    if Footsteps.IsPlaying then
                        Footsteps:Stop()
                    else
                        Footsteps:Play()
                    end
                end
                if PlaySound then
                    if PlaySound.IsPlaying then
                        PlaySound:Stop()
                    else
                        PlaySound:Play()
                    end
                end
            end
        end
    end)

    print("[Ambush Morph] ✅ Ambush привязан к игроку")
end
