-- ============================================================
-- AMBUSH BOTTLE + MORPH (не падает, не исчезает)
-- ============================================================

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local LocalPlayer = Players.LocalPlayer

-- Backpack
local backpack = LocalPlayer:WaitForChild("Backpack", 10)
if not backpack then warn("[Ambush] ❌ Backpack") return end

-- Бутылка
local toolNew
for _, id in ipairs({70922560617067, 111263531009426}) do
    local ok, objs = pcall(function()
        return game:GetObjects("rbxassetid://" .. id)
    end)
    if ok and objs and objs[1] then
        toolNew = objs[1]
        print("[Ambush] ✅ Бутылка:", id)
        break
    end
end
if not toolNew then warn("[Ambush] ❌ Нет бутылки") return end

toolNew.Parent = backpack
toolNew.Name = "Ambush Bottle"
toolNew.TextureId = "rbxassetid://139716715049853"
print("[Ambush] ✅ Предмет выдан")

-- ============================================================
-- MORPH
-- ============================================================
local AMBUSH_ASSET = 98266611233960
local MORPH_DURATION = 60

local morph, morphActive = nil, false
local morphParts = {}   -- все BasePart модели, которые двигаем вручную
local morphPrimary = nil -- главная часть (HumanoidRootPart или Main)
local originalCharacter, originalRootPart, originalHumanoid
local originalWalkSpeed, originalJumpPower, originalJumpHeight
local enforceLoop, inputConnection, morphTimer
local savedOffsets = {} -- смещения каждой части относительно primary

local function cleanupMorph()
    if inputConnection then inputConnection:Disconnect() inputConnection = nil end
    if enforceLoop then enforceLoop:Disconnect() enforceLoop = nil end
    if morphTimer then task.cancel(morphTimer) morphTimer = nil end

    local camera = workspace.CurrentCamera
    if camera then camera.CameraType = Enum.CameraType.Custom end

    if originalCharacter then
        for _, part in ipairs(originalCharacter:GetDescendants()) do
            if part:IsA("BasePart") then
                part.Transparency = 0
                part.LocalTransparencyModifier = 0
                part.CanCollide = true
            elseif part:IsA("Decal") or part:IsA("Texture") then
                part.Transparency = 0
            end
        end
        for _, v in pairs(originalCharacter:GetChildren()) do
            if v:IsA("Accessory") and v:FindFirstChild("Handle") then
                v.Handle.Transparency = 0
            end
        end
    end

    if originalHumanoid then
        originalHumanoid.WalkSpeed = originalWalkSpeed
        originalHumanoid.JumpPower = originalJumpPower
        if originalJumpHeight then originalHumanoid.JumpHeight = originalJumpHeight end
    end

    if morph then morph:Destroy() morph = nil end
    morphParts = {}
    morphPrimary = nil
    savedOffsets = {}
    morphActive = false
    print("[Ambush] 🔄 Морф снят")
end

local function applyMorph()
    if morphActive then cleanupMorph() end

    local ok, objs = pcall(function()
        return game:GetObjects("rbxassetid://" .. AMBUSH_ASSET)
    end)
    if not ok or not objs or not objs[1] then
        warn("[Ambush] ❌ Ambush не загрузился")
        return
    end

    morph = objs[1]
    print("[Ambush] ✅ Ambush загружен:", morph.Name)

    local Main = morph:FindFirstChild("Main")
    if not Main then
        warn("[Ambush] ❌ Нет Main")
        morph:Destroy() morph = nil return
    end

    originalCharacter = LocalPlayer.Character
    if not originalCharacter then return end
    originalRootPart = originalCharacter:FindFirstChild("HumanoidRootPart")
    originalHumanoid = originalCharacter:FindFirstChildWhichIsA("Humanoid")
    if not originalRootPart or not originalHumanoid then return end

    originalWalkSpeed = originalHumanoid.WalkSpeed
    originalJumpPower = originalHumanoid.JumpPower
    originalJumpHeight = originalHumanoid.JumpHeight

    morph.Parent = workspace

    local mh = morph:FindFirstChildWhichIsA("Humanoid")
    if mh then mh:Destroy() end

    -- ============================================================
    -- СОБИРАЕМ ВСЕ ЧАСТИ И ЗААНКЕРИВАЕМ ИХ
    -- ============================================================
    morphParts = {}
    for _, p in ipairs(morph:GetDescendants()) do
        if p:IsA("BasePart") then
            p.Anchored = true          -- ⬅️ ГЛАВНОЕ: анкорим, чтобы не падал
            p.CanCollide = false
            table.insert(morphParts, p)
        end
    end

    -- Определяем primary часть (HumanoidRootPart или Main или первая)
    morphPrimary = morph:FindFirstChild("HumanoidRootPart")
        or morph:FindFirstChild("Main")
        or morphParts[1]

    if not morphPrimary then
        warn("[Ambush] ❌ Не нашёл primary часть")
        return
    end

    -- Сохраняем смещения каждой части относительно primary
    savedOffsets = {}
    for _, p in ipairs(morphParts) do
        savedOffsets[p] = morphPrimary.CFrame:ToObjectSpace(p.CFrame)
    end

    -- Ставим морф на игрока
    local baseCFrame = originalRootPart.CFrame
    morphPrimary.CFrame = baseCFrame
    for _, p in ipairs(morphParts) do
        if p ~= morphPrimary then
            p.CFrame = baseCFrame * savedOffsets[p]
        end
    end

    -- Скрываем тело игрока
    for _, p in ipairs(originalCharacter:GetDescendants()) do
        if p:IsA("BasePart") then
            p.LocalTransparencyModifier = 1
            p.Transparency = 1
            p.CanCollide = false
        elseif p:IsA("Decal") or p:IsA("Texture") then
            p.Transparency = 1
        end
    end
    for _, v in pairs(originalCharacter:GetChildren()) do
        if v:IsA("Accessory") and v:FindFirstChild("Handle") then
            v.Handle.Transparency = 1
        end
    end

    local camera = workspace.CurrentCamera
    if camera then camera.CameraType = Enum.CameraType.Scriptable end

    local Footsteps = Main:FindFirstChild("Footsteps")
    local PlaySound = Main:FindFirstChild("PlaySound")
    if Footsteps then Footsteps:Play() end
    if PlaySound then PlaySound:Play() end

    -- ============================================================
    -- ENFORCE LOOP — двигаем морф вручную через CFrame
    -- ============================================================
    enforceLoop = RunService.RenderStepped:Connect(function()
        local char = LocalPlayer.Character
        if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end

        if morph and morph.Parent and morphPrimary and morphPrimary.Parent then
            local baseCFrame = hrp.CFrame
            morphPrimary.CFrame = baseCFrame
            for _, p in ipairs(morphParts) do
                if p and p.Parent and p ~= morphPrimary then
                    p.CFrame = baseCFrame * savedOffsets[p]
                end
            end
        end

        -- Скрываем тело игрока каждый кадр
        for _, p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") then p.LocalTransparencyModifier = 1
            elseif p:IsA("Decal") or p:IsA("Texture") then p.Transparency = 1 end
        end
        for _, v in pairs(char:GetChildren()) do
            if v:IsA("Accessory") and v:FindFirstChild("Handle") then
                v.Handle.Transparency = 1
            end
        end

        -- Камера от 3-го лица
        if camera then
            local headPos = hrp.Position + Vector3.new(0, 1.5, 0)
            local lv = camera.CFrame.LookVector
            local uv = camera.CFrame.UpVector
            local camPos = headPos - (lv * 12) + Vector3.new(0, 2, 0)
            camera.CFrame = CFrame.lookAt(camPos, headPos, uv)
        end
    end)

    -- R — звуки
    inputConnection = UserInputService.InputBegan:Connect(function(input, gp)
        if gp then return end
        if input.KeyCode == Enum.KeyCode.R then
            if Footsteps then
                if Footsteps.IsPlaying then Footsteps:Stop() else Footsteps:Play() end
            end
            if PlaySound then
                if PlaySound.IsPlaying then PlaySound:Stop() else PlaySound:Play() end
            end
        end
    end)

    morphActive = true
    print("[Ambush] ✅ Морф активен " .. MORPH_DURATION .. " сек")

    morphTimer = task.delay(MORPH_DURATION, cleanupMorph)
end

-- ============================================================
-- АКТИВАЦИЯ
-- ============================================================
local drinked = false
toolNew.Activated:Connect(function()
    if drinked then return end
    drinked = true
    print("[Ambush] 🍶 Пью зелье...")
    task.defer(function() pcall(applyMorph) end)
    toolNew:Destroy()
end)
