local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Player = Players.LocalPlayer

-- Загружаем бутылку
local toolNew = nil
if game.GameId == 6627207668 then
	toolNew = game.ReplicatedStorage["Moon Bottle"]:Clone()
else
	toolNew = game:GetObjects("rbxassetid://111263531009426")[1]
end

local drinked = false

-- ==========================================
-- ФУНКЦИЯ ПРЕВРАЩЕНИЯ В АМБУША
-- ==========================================
local function transformIntoAmbush()
	local Character = Player.Character or Player.CharacterAdded:Wait()

	-- Загружаем модель Ambush
	local Success, Objects = pcall(function()
		return game:GetObjects("rbxassetid://98266611233960")
	end)

	if not Success or not Objects or not Objects[1] then
		warn("Не удалось загрузить модель Ambush")
		return
	end

	local Ambush = Objects[1]
	Ambush.Parent = workspace

	local Main = Ambush:FindFirstChild("Main")
	if not Main then
		warn("У Ambush не найден объект Main")
		Ambush:Destroy()
		return
	end

	-- 🔥 ПРИНУДИТЕЛЬНО ВКЛЮЧАЕМ КАМЕРУ ОТ ТРЕТЬЕГО ЛИЦА
	Player.CameraMode = Enum.CameraMode.Classic
	Player.CameraMaxZoomDistance = 20
	Player.CameraMinZoomDistance = 8
	Player.CameraMode = Enum.CameraMode.Classic

	-- Следим за персонажем и скрываем его
	RunService.RenderStepped:Connect(function()
		if not Ambush or not Ambush.Parent then return end
		Character = Player.Character
		if not Character then return end
		local RootPart = Character:FindFirstChild("HumanoidRootPart")
		if not RootPart then return end

		-- Перемещаем Ambush вместе с игроком
		pcall(function()
			Ambush:PivotTo(RootPart.CFrame)
		end)

		-- Скрываем обычного персонажа
		for _, Object in ipairs(Character:GetChildren()) do
			if Object:IsA("BasePart") then
				Object.LocalTransparencyModifier = 1
				for _, Child in ipairs(Object:GetDescendants()) do
					if Child:IsA("Decal") or Child:IsA("Texture") then
						Child.Transparency = 1
					end
				end
			elseif Object:IsA("Accessory") then
				local Handle = Object:FindFirstChild("Handle")
				if Handle then
					Handle.LocalTransparencyModifier = 1
				end
			end
		end
	end)
end

-- ==========================================
-- ЛОГИКА ЗЕЛЬЯ
-- ==========================================
toolNew.Parent = Player.Backpack
toolNew.Name = "Ambush Potion"
toolNew.TextureId = "rbxassetid://76865808847706"

toolNew.Activated:Connect(function()
	if drinked == false then
		drinked = true

		-- Запускаем превращение
		transformIntoAmbush()

		-- Удаляем зелье
		toolNew:Destroy()
	end
end)
