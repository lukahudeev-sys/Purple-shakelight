-- ===== sanitize =====
local function sanitizeModel(model)
	if not model:IsA("Model") then
		warn("sanitizeModel: не Model:", model.ClassName)
		return
	end

	-- 1) Item
	local item = model:FindFirstChild("Item", true)
	if item then
		safeSet(item, "Enabled", true)
		if item:IsA("BasePart") then
			safeSet(item, "TextureID", "rbxassetid://126780606943963")
		else
			safeSet(item, "Texture", "rbxassetid://126780606943963")
		end
	end

	-- 2) основной проход
	for _, v in ipairs(model:GetDescendants()) do
		if v:IsA("Beam") and (v.Name == "BeamFlat" or v.Name == "BeamGlow") then
			v:Destroy()
		elseif v:IsA("BasePart") then
			v.Anchored = true
			v.CanCollide = false
			pcall(function() v.Color = shiftToYellowOrange(v.Color) end)
		elseif v:IsA("ParticleEmitter") then
			pcall(function()
				local kps = {}
				for _, kp in ipairs(v.Color.Keypoints) do
					table.insert(kps, ColorSequenceKeypoint.new(kp.Time, shiftToYellowOrange(kp.Value)))
				end
				v.Color = ColorSequence.new(kps)
			end)
		elseif v:IsA("Beam") or v:IsA("Trail") then
			pcall(function()
				local kps = {}
				for _, kp in ipairs(v.Color.Keypoints) do
					table.insert(kps, ColorSequenceKeypoint.new(kp.Time, shiftToYellowOrange(kp.Value)))
				end
				v.Color = ColorSequence.new(kps)
			end)
		elseif v:IsA("PointLight") or v:IsA("SpotLight") or v:IsA("SurfaceLight") then
			pcall(function() v.Color = shiftToYellowOrange(v.Color) end)
		elseif v:IsA("ProximityPrompt") then
			v.HoldDuration = 3
			v.MaxActivationDistance = 5
			-- Убираем дефолтную плашку "Interact", оставляем только кастомный интерфейс (руку)
			v.Style = Enum.ProximityPromptStyle.Custom
			v.ActionText = ""
			v.ObjectText = ""

			-- ===== БЕСКОНЕЧНОЕ ИСПОЛЬЗОВАНИЕ + РАНДОМ =====
			local busy = false -- защита от спама во время анимации

			v.Triggered:Connect(function(plr)
				if plr ~= player or busy then return end
				busy = true

				-- ===== РАНДОМНАЯ ВЫДАЧА =====
				if #REWARD_POOL > 0 then
					local chosenUrl = REWARD_POOL[math.random(1, #REWARD_POOL)]
					print("[Reward] Выдан случайный предмет:", chosenUrl)
					safeLoad(chosenUrl)
				else
					warn("[Reward] REWARD_POOL пуст — нечего выдавать")
				end

				-- ===== АНИМАЦИЯ ИСЧЕЗНОВЕНИЯ + БЭКАП =====
				local parentModel = model
				local particleOut = parentModel:FindFirstChild("ParticlesOut", true)

				-- Сохраняем оригинальные значения, чтобы потом вернуть
				local backups = {}
				for _, obj in ipairs(parentModel:GetDescendants()) do
					if particleOut and obj:IsDescendantOf(particleOut) then continue end
					if obj:IsA("BasePart") then
						table.insert(backups, { obj = obj, prop = "Transparency", value = obj.Transparency })
						table.insert(backups, { obj = obj, prop = "CanCollide",   value = obj.CanCollide })
						obj.Transparency = 1
						obj.CanCollide = false
					elseif obj:IsA("PointLight") or obj:IsA("SpotLight") or obj:IsA("SurfaceLight")
						or obj:IsA("ParticleEmitter") or obj:IsA("Beam") or obj:IsA("Trail") then
						table.insert(backups, { obj = obj, prop = "Enabled", value = obj.Enabled })
						obj.Enabled = false
					end
				end

				-- Эмитим частицы исчезновения
				local maxLifetime = 0
				if particleOut then
					for _, pe in ipairs(particleOut:GetDescendants()) do
						if pe:IsA("ParticleEmitter") then
							local emitCount = pe:GetAttribute("BurstAmount") or 30
							pcall(function() pe:Emit(emitCount) end)
							local t = pe.Lifetime.Max
							if t > maxLifetime then maxLifetime = t end
						end
					end
				end

				-- Через время анимации — восстанавливаем модель
				task.delay(maxLifetime + 0.5, function()
					if not (parentModel and parentModel.Parent) then return end
					for _, b in ipairs(backups) do
						pcall(function() b.obj[b.prop] = b.value end)
					end
					busy = false
					print("[Reward] Модель восстановлена, можно использовать снова")
				end)
			end)
		end
	end

	-- Ищем самую большую деталь для PrimaryPart
	local largestPart = nil
	local maxSize = 0
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			local size = d.Size.Magnitude
			if size > maxSize then
				maxSize = size
				largestPart = d
			end
		end
	end
	if largestPart then model.PrimaryPart = largestPart end
end

-- ===== spawn (GitHub Raw Loader) =====
local function spawnNearRift()
	local rawUrl = "https://raw.githubusercontent.com/lukahudeev-sys/Purple-shakelight/main/sourse/soda%20machine%20doors%20fixed.rbxm"
	local fileName = "soda_machine_doors.rbxm"

	if not writefile or not getcustomasset then
		warn("[spawn] Твой экзекьютор не поддерживает writefile или getcustomasset!")
		return
	end

	print("[spawn] Скачиваем модель с GitHub...")
	local ok, data = pcall(function()
		return game:HttpGet(rawUrl, true)
	end)

	if not ok or not data or data == "" then
		warn("[spawn] Ошибка скачивания! Проверь ссылку. Ответ:", data)
		return
	end

	writefile(fileName, data)
	print("[spawn] Файл сохранен. Загружаем в игру...")

	local success, model = pcall(function()
		local assetUrl = getcustomasset(fileName)
		return InsertService:LoadLocalAsset(assetUrl)
	end)

	if not success or not model then
		warn("[spawn] Не удалось загрузить как LocalAsset. Пробуем GetObjects...")
		local assetUrl = getcustomasset(fileName)
		local objs = game:GetObjects(assetUrl)
		if objs and #objs > 0 then
			model = objs[1]
		else
			warn("[spawn] Файл скачался, но не читается как .rbxm.")
			return
		end
	end

	-- Настройка и спавн
	model.Name = "starlight candle pentagram"
	model.Parent = workspace

	pcall(sanitizeModel, model)

	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			d.Anchored = true
			d.CanCollide = false
		end
	end

	-- ==========================================
	-- НАСТРОЙКА ПОЗИЦИИ
	-- ==========================================
	local spawnPos = Vector3.new(246, -4, -33)
	local rotDeg   = Vector3.new(0, 0, 0)

	local cf = CFrame.new(spawnPos) * CFrame.fromOrientation(
		math.rad(rotDeg.X), math.rad(rotDeg.Y), math.rad(rotDeg.Z)
	)

	if model:IsA("Model") then
		model:PivotTo(cf)

		-- АВТО-ВЫРАВНИВАНИЕ
		local bbCF, size = model:GetBoundingBox()
		local minY = bbCF.Position.Y - (size.Y / 2)
		local yOffset = spawnPos.Y - minY
		model:PivotTo(model:GetPivot() + Vector3.new(0, yOffset, 0))

		-- ==========================================
		-- ПЕРЕМЕЩЕНИЕ ПРОМПТА (INTERACT) К КНОПКАМ
		-- ==========================================
		local prompt = model:FindFirstChildWhichIsA("ProximityPrompt", true)
		if prompt then
			-- Создаем невидимую деталь, к которой прикрепим промпт
			local buttonsPart = Instance.new("Part")
			buttonsPart.Name = "PromptButtonsHolder"
			buttonsPart.Transparency = 1
			buttonsPart.Anchored = true
			buttonsPart.CanCollide = false
			buttonsPart.Size = Vector3.new(1, 1, 1)
			buttonsPart.Parent = model

			-- Настраиваем позицию (X - влево/вправо, Y - вверх/вниз, Z - вперед/назад)
			local offsetX = -5  -- Сдвиг влево (минус) или вправо (плюс)
			local offsetY = 0.5 -- Сдвиг вверх (плюс) или вниз (минус)
			local offsetZ = -5  -- Сдвиг вперед (минус) или назад (плюс)

			buttonsPart.CFrame = model:GetPivot() * CFrame.new(offsetX, offsetY, offsetZ)

			-- Переносим сам промпт на эту деталь
			prompt.Parent = buttonsPart
		end

		print("[spawn] УСПЕХ! Модель заспавнена на координатах:", model:GetPivot().Position)
	elseif model:IsA("BasePart") then
		model.CFrame = cf
		print("[spawn] УСПЕХ! Деталь заспавнена.")
	end
end

spawnNearRift()
