-- ============================================================
-- SEEK MORPH STATE
-- ============================================================
local SEEK_ASSET = 86341229891935
local heightOffset = 0
local isTestPlace = (game.GameId == 6627207668)

local morphActive = false
local movementEnabled = false
local currentAmbience = nil
local isThirdPerson = true

local morph = nil
local originalCharacter, originalRootPart, originalHumanoid, originalHeadPart = nil, nil, nil, nil
local originalWalkSpeed, originalJumpPower, originalJumpHeight = 16, 50, 7.2
local animator = nil
local enforceLoop, movementLoop, inputConnection = nil, nil, nil

local introTrack, walkTrack, pipeSlimeTrack = nil, nil, nil

-- ============================================================
-- CLEANUP
-- ============================================================
local function cleanupMorph()
	if inputConnection then inputConnection:Disconnect() inputConnection = nil end
	if enforceLoop then enforceLoop:Disconnect() enforceLoop = nil end
	if movementLoop then movementLoop:Disconnect() movementLoop = nil end
	if currentAmbience then currentAmbience:Stop() currentAmbience = nil end
	if introTrack then introTrack:Stop() introTrack = nil end
	if walkTrack then walkTrack:Stop() walkTrack = nil end
	if pipeSlimeTrack then pipeSlimeTrack:Stop() pipeSlimeTrack = nil end

	local camera = workspace.CurrentCamera
	if camera then camera.CameraType = Enum.CameraType.Custom end

	if originalCharacter then
		for _, part in ipairs(originalCharacter:GetDescendants()) do
			if part:IsA("BasePart") then
				part.Transparency = 0
				part.LocalTransparencyModifier = 0
				part.CanCollide = true
			elseif part:IsA("Decal") or part:IsA("Texture") then
				part.Transparency = 0
			end
		end
		for _, v in pairs(originalCharacter:GetChildren()) do
			if v:IsA("Accessory") and v:FindFirstChild("Handle") then
				v.Handle.Transparency = 0
			end
		end
	end

	if originalHumanoid then
		originalHumanoid.WalkSpeed = originalWalkSpeed
		originalHumanoid.JumpPower = originalJumpPower
		if originalJumpHeight then
			originalHumanoid.JumpHeight = originalJumpHeight
		end
	end

	if morph then
		morph:Destroy()
		morph = nil
	end

	morphActive = false
	animator = nil
end

-- ============================================================
-- ЗАГРУЗКА SEEK
-- ============================================================
local function loadModel()
	local objects = game:GetObjects("rbxassetid://" .. SEEK_ASSET)
	return objects and objects[1]
end

-- ============================================================
-- CORE MORPH ENGINE (через PivotTo)
-- ============================================================
local function applyMorph()
	if morphActive then cleanupMorph() end

	morph = loadModel()
	if not morph then
		warn("[Seek Morph] Не удалось загрузить модель")
		return
	end

	originalCharacter = LocalPlayer.Character
	if not originalCharacter or not originalCharacter:FindFirstChild("HumanoidRootPart") then
		return
	end

	originalRootPart = originalCharacter:FindFirstChild("HumanoidRootPart")
	originalHumanoid = originalCharacter:FindFirstChildWhichIsA("Humanoid")
	originalHeadPart = originalCharacter:FindFirstChild("Head")
	if not originalRootPart or not originalHumanoid then return end

	originalWalkSpeed = originalHumanoid.WalkSpeed
	originalJumpPower = originalHumanoid.JumpPower
	originalJumpHeight = originalHumanoid.JumpHeight

	-- Морф в мир
	morph.Parent = workspace

	-- Убираем Humanoid если есть
	local morphHumanoid = morph:FindFirstChildWhichIsA("Humanoid")
	if morphHumanoid then morphHumanoid:Destroy() end

	for _, part in ipairs(morph:GetDescendants()) do
		if part:IsA("BasePart") then
			part.Anchored = false
			part.CanCollide = false
		end
	end

	-- Ставим Seek на игрока СРАЗУ
	morph:PivotTo(originalRootPart.CFrame)

	-- Скрываем тело игрока
	for _, part in ipairs(originalCharacter:GetDescendants()) do
		if part:IsA("BasePart") then
			part.LocalTransparencyModifier = 1
			part.Transparency = 1
			part.CanCollide = false
		elseif part:IsA("Decal") or part:IsA("Texture") then
			part.Transparency = 1
		end
	end
	for _, v in pairs(originalCharacter:GetChildren()) do
		if v:IsA("Accessory") and v:FindFirstChild("Handle") then
			v.Handle.Transparency = 1
		end
	end

	-- Камера
	local camera = workspace.CurrentCamera
	if camera then camera.CameraType = Enum.CameraType.Scriptable end

	-- Аниматор
	local animationController = morph:FindFirstChildWhichIsA("AnimationController")
		or morph:FindFirstChild("AnimationController", true)
	if not animationController then
		animationController = Instance.new("AnimationController", morph)
	end
	animator = morph:FindFirstChildWhichIsA("Animator")
		or animationController:FindFirstChildWhichIsA("Animator")
	if not animator then
		animator = Instance.new("Animator", animationController)
	end

	local function playAnimation(animationObject, looped)
		local track = animator:LoadAnimation(animationObject)
		if track then
			track.Looped = looped or false
			track:Play()
		end
		return track
	end

	-- Анимации
	if isTestPlace then
		if morph:FindFirstChild("SeekMusic") and morph.SeekMusic:FindFirstChild("Intro") then
			morph.SeekMusic.Intro.SoundId = "rbxassetid://138877504428539"
		end
		introTrack = playAnimation(morph.AnimationsTest.minesintro, false)
		walkTrack = playAnimation(morph.AnimationsTest.run, true)
	else
		introTrack = playAnimation(morph.Animations.minesintro, false)
		walkTrack = playAnimation(morph.Animations.run, true)
	end
	walkTrack:AdjustSpeed(0)

	-- =========================
	-- ENFORCE LOOP — PivotTo каждый кадр
	-- =========================
	enforceLoop = RunService.RenderStepped:Connect(function()
		local char = LocalPlayer.Character
		if not char then return end
		local hrp = char:FindFirstChild("HumanoidRootPart")
		if not hrp then return end

		if morph and morph.Parent then
			morph:PivotTo(hrp.CFrame)
		end

		for _, part in ipairs(char:GetDescendants()) do
			if part:IsA("BasePart") then
				part.LocalTransparencyModifier = 1
			elseif part:IsA("Decal") or part:IsA("Texture") then
				part.Transparency = 1
			end
		end
		for _, v in pairs(char:GetChildren()) do
			if v:IsA("Accessory") and v:FindFirstChild("Handle") then
				v.Handle.Transparency = 1
			end
		end

		if camera then
			local headPos = hrp.Position + Vector3.new(0, 1.5, 0)
			local lookVector = camera.CFrame.LookVector
			local upVector = camera.CFrame.UpVector

			if isThirdPerson then
				local camPos = headPos - (lookVector * 12) + Vector3.new(0, 2, 0)
				camera.CFrame = CFrame.lookAt(camPos, headPos, upVector)
			else
				local camPos = headPos + lookVector * 0.5
				camera.CFrame = CFrame.lookAt(camPos, camPos + lookVector, upVector)
			end
		end
	end)

	-- =========================
	-- INPUT (T — Scream, L — 1st/3rd person)
	-- =========================
	local UserInputService = game:GetService("UserInputService")
	inputConnection = UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed then return end
		if input.UserInputType == Enum.UserInputType.Keyboard then
			if input.KeyCode == Enum.KeyCode.T then
				pcall(function() morph.Figure.Scream:Play() end)
			elseif input.KeyCode == Enum.KeyCode.L then
				isThirdPerson = not isThirdPerson
			end
		end
	end)

	-- =========================
	-- MOVEMENT LOOP — анимация ходьбы
	-- =========================
	movementEnabled = true

	movementLoop = RunService.RenderStepped:Connect(function()
		if not movementEnabled then return end
		local moveDirection = originalHumanoid.MoveDirection
		if not moveDirection then return end
		local moving = moveDirection.Magnitude > 0.1

		if moving then
			if walkTrack then walkTrack:AdjustSpeed(1) end
			local fs = morph:FindFirstChild("Footsteps", true)
			local fsf = morph:FindFirstChild("FootstepsFar", true)
			if fs and not fs.IsPlaying then fs:Play() end
			if fsf and not fsf.IsPlaying then fsf:Play() end
		else
			if walkTrack then walkTrack:AdjustSpeed(0) end
			local fs = morph:FindFirstChild("Footsteps", true)
			local fsf = morph:FindFirstChild("FootstepsFar", true)
			if fs and fs.IsPlaying then fs:Stop() end
			if fsf and fsf.IsPlaying then fsf:Stop() end
		end
	end)

	morphActive = true
	print("[Seek Morph] ✅ Seek привязан к игроку")
end

