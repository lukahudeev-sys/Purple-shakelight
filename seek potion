-- ============================================================
-- VIRIDISLIGHT для Real executor
-- ============================================================

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local InsertService = game:GetService("InsertService")
local LocalPlayer = Players.LocalPlayer

print("[1] Старт")

local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local Humanoid = Character:WaitForChild("Humanoid")
print("[2] Персонаж OK")

-- ============================================================
-- ПОИСК МОДЕЛИ ЗЕЛЬЯ
-- ============================================================
local toolNew = nil

-- Вариант 1: Moon Bottle в ReplicatedStorage
if game.GameId == 6627207668 then
	local mb = game.ReplicatedStorage:FindFirstChild("Moon Bottle")
	if mb then
		toolNew = mb:Clone()
		print("[3] Moon Bottle из ReplicatedStorage")
	end
end

-- Вариант 2: ищем любой похожий tool в ReplicatedStorage
if not toolNew then
	for _, v in pairs(game.ReplicatedStorage:GetChildren()) do
		if v:IsA("Tool") and (v.Name:lower():find("bottle") or v.Name:lower():find("moon")) then
			toolNew = v:Clone()
			print("[3] Найден tool:", v.Name)
			break
		end
	end
end

-- Вариант 3: ищем в StarterPack / Players.Backpack
if not toolNew then
	for _, v in pairs(game:GetService("StarterPack"):GetChildren()) do
		if v:IsA("Tool") then
			toolNew = v:Clone()
			print("[3] Из StarterPack:", v.Name)
			break
		end
	end
end

-- Вариант 4: GetObjects (последний шанс)
if not toolNew then
	local ok, res = pcall(function()
		return game:GetObjects("rbxassetid://111263531009426")[1]
	end)
	if ok and res then
		toolNew = res
		print("[3] Через GetObjects")
	else
		warn("[!] GetObjects не сработал:", res)
	end
end

-- Вариант 5: LoadAsset
if not toolNew then
	local ok, res = pcall(function()
		return InsertService:LoadAsset(111263531009426)
	end)
	if ok and res then
		local child = res:GetChildren()[1]
		if child then
			toolNew = child
			print("[3] Через LoadAsset:", child.Name)
		end
	end
end

-- ============================================================
-- ЕСЛИ НИЧЕГО НЕ НАШЛИ — создаём ПУСТОЙ tool сами
-- ============================================================
if not toolNew then
	warn("[!] Модель не найдена — создаю tool вручную")

	toolNew = Instance.new("Tool")
	toolNew.Name = "Viridislight Bottle"
	toolNew.RequiresHandle = false
	toolNew.CanBeDropped = false
	toolNew.ToolTip = "Выпить зелье"
end

-- ============================================================
-- ВЫДАЁМ ЗЕЛЬЕ
-- ============================================================
local backpack = LocalPlayer:WaitForChild("Backpack")
toolNew.Parent = backpack
toolNew.Name = "Viridislight Bottle"

print("[4] ✅ ЗЕЛЬЕ ВЫДАНО:", toolNew:GetFullName())
print("[5] Backpack содержит:", backpack:FindFirstChild("Viridislight Bottle") ~= nil)

-- ============================================================
-- ПРОСТОЙ ЭФФЕКТ (свет + скорость + реген + таймер)
-- ============================================================
local drinked = false

toolNew.Activated:Connect(function()
	if drinked then return end
	drinked = true
	print("[6] Зелье выпито!")

	-- Свет
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(0, 255, 0)
	light.Brightness = 2
	light.Range = 0
	light.Parent = Character:FindFirstChild("HumanoidRootPart") or Character
	TweenService:Create(light, TweenInfo.new(2.5), { Range = 45 }):Play()

	-- Звук
	local s = Instance.new("Sound", workspace)
	s.SoundId = "rbxassetid://140242540481244"
	s.Volume = 1.2
	s:Play()
	task.delay(5, function() s:Destroy() end)

	-- Скорость 17
	local orig = Humanoid.WalkSpeed
	local conn = RunService.Heartbeat:Connect(function()
		if Humanoid.Parent and Humanoid.WalkSpeed ~= 17 then
			Humanoid.WalkSpeed = 17
		end
	end)

	-- Реген
	local stopRegen = false
	task.spawn(function()
		while not stopRegen do
			task.wait(0.5)
			if Humanoid.Parent and Humanoid.Health > 0 then
				Humanoid.Health = math.min(Humanoid.Health + 1, Humanoid.MaxHealth)
			end
		end
	end)

	-- Подсветка дверей/ключей
	local stopH = false
	local highlights = {}

	local function addHighlight(inst)
		if stopH then return end
		if inst:IsA("Model") and (inst.Name == "Door" or inst.Name == "KeyObtain") then
			if not inst:FindFirstChildOfClass("Highlight") then
				local h = Instance.new("Highlight")
				h.FillColor = Color3.fromRGB(120, 255, 160)
				h.OutlineColor = Color3.fromRGB(80, 255, 120)
				h.FillTransparency = 0.4
				h.OutlineTransparency = 0
				h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
				h.Parent = inst
				table.insert(highlights, h)
			end
		end
	end

	local rooms = workspace:FindFirstChild("CurrentRooms")
	if rooms then
		for _, v in ipairs(rooms:GetDescendants()) do
			addHighlight(v)
		end
		rooms.DescendantAdded:Connect(function(v)
			if stopH then return end
			task.wait()
			addHighlight(v)
		end)
	end

	-- Таймер
	local gui = Instance.new("ScreenGui")
	gui.IgnoreGuiInset = true
	gui.ResetOnSpawn = false
	gui.Parent = LocalPlayer:WaitForChild("PlayerGui")

	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(0, 200, 0, 40)
	label.Position = UDim2.new(0.5, -100, 0, 10)
	label.BackgroundTransparency = 1
	label.TextColor3 = Color3.fromRGB(170, 255, 180)
	label.TextStrokeTransparency = 0.6
	label.Font = Enum.Font.Gotham
	label.TextSize = 20
	label.Text = "0:30"
	label.Parent = gui

	local t = 30
	task.spawn(function()
		while t >= 0 do
			label.Text = string.format("%d:%02d", math.floor(t/60), t % 60)

			if t == 0 then
				stopRegen = true
				stopH = true
				if conn then conn:Disconnect() end
				for _, h in ipairs(highlights) do
					if h.Parent then h:Destroy() end
				end

				TweenService:Create(light, TweenInfo.new(2), { Range = 0 }):Play()
				task.wait(2)
				if light.Parent then light:Destroy() end

				TweenService:Create(Humanoid, TweenInfo.new(2), { WalkSpeed = orig }):Play()
				task.delay(2, function()
					if gui then gui:Destroy() end
				end)
				break
			end

			t -= 1
			task.wait(1)
		end
	end)

	toolNew:Destroy()
end)

print("[7] Готово — жми на зелье в бекпаке")
