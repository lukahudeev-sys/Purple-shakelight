print("[Viridislight] Зелье выдано в инвентарь")

-- ============================================================
-- СОБЫТИЯ ИНСТРУМЕНТА
-- ============================================================
toolNew.Equipped:Connect(function()
	if ohhmydayz then ohhmydayz:Play() end
end)

toolNew.Unequipped:Connect(function()
	if ohhmydayz then ohhmydayz:Stop() end
end)

toolNew.Activated:Connect(function()
	if drinked == false then
		drinked = true
		EffectOnScreen()

		if ohhmydayz2 then
			ohhmydayz2:Play()
			ohhmydayz2.Ended:Wait()
		elseif ohhmydayz3 then
			ohhmydayz3:Play()
			ohhmydayz3.Ended:Wait()
		end

		toolNew:Destroy()

		task.wait(0.5)
		if seekLoaded then
			seekVisible = true
			canWalk = true
			if WalkAnim then WalkAnim:AdjustSpeed(1) end
		end
	end
end)
