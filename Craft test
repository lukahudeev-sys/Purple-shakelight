	model:SetAttribute("FirstTexture", "")
	model:SetAttribute("Crafted", false)
	model:SetAttribute("ResultItem", "")
	model:SetAttribute("StoredTexture", "")

	local item = getItemHolder(model)
	if item and item:IsA("ParticleEmitter") then
		item.Enabled = true
		item.Texture = ""
	end

	model.Parent = workspace
	sanitizeModel(model)

	local spawnPos = Vector3.new(235, 0, -20)
	model:PivotTo(CFrame.new(spawnPos))
