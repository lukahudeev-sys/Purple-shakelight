-- ============================================================
-- ЗЕЛЬЕ (asset id заменён на 124506258223677)
-- ============================================================
local toolNew = nil
if game.GameId == 6627207668 then
	toolNew = game.ReplicatedStorage["Moon Bottle"]:Clone()
else
	toolNew = game:GetObjects("rbxassetid://135227077345759")[1]
