-- ============================================================
-- ВЫПИВАНИЕ → МОРФ В FIGURE
-- ============================================================
toolNew.Activated:Connect(function()
	if drinked == false then
		drinked = true
		EffectOnScreen()

		if game.GameId == 6627207668 then
			ohhmydayz2:Play()
			ohhmydayz2.Ended:Wait()
		else
			ohhmydayz3:Play()
			ohhmydayz3.Ended:Wait()
		end

		-- 🎭 МОРФ В FIGURE
		task.defer(function()
			pcall(transformIntoFigure)
		end)

		toolNew:Destroy()
	end
end)
