local InsertService = game:GetService("InsertService")

local function transformIntoAmbush()
    -- Сбрасываем старый флаг, чтобы морф мог запуститься
    _G.TransformedIntoAnyMorph = false

    local Players = game:GetService("Players")
    local RunService = game:GetService("RunService")

    local Player = Players.LocalPlayer
    local Character = Player.Character or Player.CharacterAdded:Wait()

    -- Загружаем модель Ambush
    local Success, Objects = pcall(function()
        return InsertService:LoadAsset(113981726565681)
    end)

    if not Success or not Objects or not Objects[1] then
        warn("Не удалось загрузить модель Ambush: " .. tostring(Objects))
        return
    end

    local Ambush = Objects[1]
    Ambush.Parent = workspace

    local Main = Ambush:FindFirstChild("Main")
    if not Main then
        warn("У Ambush не найден объект Main")
        Ambush:Destroy()
        return
    end

    _G.TransformedIntoAnyMorph = true

    -- Запускаем звуки
    local Footsteps = Main:FindFirstChild("Footsteps")
    local PlaySound = Main:FindFirstChild("PlaySound")

    if Footsteps then Footsteps:Play() end
    if PlaySound  then PlaySound:Play()  end

    -- Следим за персонажем
    RunService.RenderStepped:Connect(function()
        if not Ambush or not Ambush.Parent then return end

        Character = Player.Character
        if not Character then return end

        local RootPart = Character:FindFirstChild("HumanoidRootPart")
        if not RootPart then return end

        -- Перемещаем Ambush вместе с игроком
        pcall(function()
            Ambush:PivotTo(RootPart.CFrame)
        end)

        -- Скрываем обычного персонажа
        for _, Object in ipairs(Character:GetChildren()) do
            if Object:IsA("BasePart") then
                Object.LocalTransparencyModifier = 1

                for _, Child in ipairs(Object:GetDescendants()) do
                    if Child:IsA("Decal") or Child:IsA("Texture") then
                        Child.Transparency = 1
                    end
                end

            elseif Object:IsA("Accessory") then
                local Handle = Object:FindFirstChild("Handle")
                if Handle then
                    Handle.LocalTransparencyModifier = 1
                end
            end
        end
    end)

    -- R переключает звуки Ambush
    Player:GetMouse().KeyDown:Connect(function(Key)
        if Key ~= "r" then return end

        if Footsteps then
            if Footsteps.IsPlaying then
                Footsteps:Stop()
            else
                Footsteps:Play()
            end
        end

        if PlaySound then
            if PlaySound.IsPlaying then
                PlaySound:Stop()
            else
                PlaySound:Play()
            end
        end
    end)

    print("Ambush morph activated!")
end

-- Запускаем морф сразу
transformIntoAmbush()
