--[[
    Ambush Morph для Doors (с камерой от третьего лица)
    
    Управление:
      R — переключить фоновые звуки
      T — крик (Scream)
      Q — рывок (Ambush мечется)
      F — стук (Knock)
      E — Repent
--]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

if _G.AmbushMorphActive then
    warn("[Ambush Morph] Уже активен!")
    return
end
_G.AmbushMorphActive = true

local AMBUSH_ASSET = "rbxassetid://113981726565681"

-- ============================================================
-- ЗАГРУЗКА МОДЕЛИ
-- ============================================================
local ok, figureNew = pcall(function()
    return game:GetObjects(AMBUSH_ASSET)[1]
end)

if not ok or not figureNew then
    warn("[Ambush Morph] Не удалось загрузить модель Ambush.")
    _G.AmbushMorphActive = false
    return
end

figureNew.Parent = workspace

-- ============================================================
-- ПОИСК ЗВУКОВ
-- ============================================================
local Main = figureNew:FindFirstChild("Main") or figureNew

local Footsteps = Main:FindFirstChild("Footsteps")
local PlaySound  = Main:FindFirstChild("PlaySound")
local Scream     = Main:FindFirstChild("Scream")
local Repent     = Main:FindFirstChild("Repent")
local Knock      = Main:FindFirstChild("Knock")

if Footsteps then Footsteps:Play() end
if PlaySound  then PlaySound:Play()  end

-- ============================================================
-- СИНХРОНИЗАЦИЯ + СКРЫТИЕ ИГРОКА
-- ============================================================
spawn(function()
    RunService.RenderStepped:Connect(function()
        local char = LocalPlayer.Character
        if not char then return end

        local head = char:FindFirstChild("Head")
        if head then head.Transparency = 1 end

        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp and figureNew.Parent then
            pcall(function()
                figureNew:PivotTo(hrp.CFrame)
            end)
        end

        for _, v in pairs(char:GetChildren()) do
            if v:IsA("BasePart") then
                v.LocalTransparencyModifier = 1
                for _, d in pairs(v:GetDescendants()) do
                    if d:IsA("Decal") or d:IsA("Texture") then
                        d.Transparency = 1
                    end
                end
            elseif v:IsA("Accessory") then
                if v:FindFirstChild("Handle") then
                    v.Handle.Transparency = 1
                end
            end
        end
    end)
end)

-- ============================================================
-- КАМЕРА ОТ ТРЕТЬЕГО ЛИЦА
-- ============================================================
local camera = workspace.CurrentCamera
local CAMERA_DISTANCE = 12
local CAMERA_HEIGHT = 4
local CAMERA_SMOOTH = 0.2

LocalPlayer.CameraMode = Enum.CameraMode.Classic
camera.CameraSubject = nil

local lastCamPos = nil

RunService.RenderStepped:Connect(function()
    local char = LocalPlayer.Character
    if not char then return end

    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local targetPos = hrp.CFrame * CFrame.new(0, CAMERA_HEIGHT, CAMERA_DISTANCE)
    local lookAt = hrp.Position + Vector3.new(0, CAMERA_HEIGHT / 2, 0)

    if lastCamPos then
        lastCamPos = lastCamPos:Lerp(targetPos, CAMERA_SMOOTH)
    else
        lastCamPos = targetPos
    end

    camera.CFrame = CFrame.new(lastCamPos.Position, lookAt)
    camera.Focus = CFrame.new(lookAt)
end)

-- ============================================================
-- РЫВОК
-- ============================================================
local dashCooldown = false

local function ambushDash()
    if dashCooldown then return end
    dashCooldown = true

    local char = LocalPlayer.Character
    if not char then dashCooldown = false return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then dashCooldown = false return end

    for i = 1, 6 do
        local side = (i % 2 == 0) and 1 or -1
        hrp.CFrame = hrp.CFrame * CFrame.new(side * 3, 0, 0)
        task.wait(0.05)
    end
    for i = 1, 8 do
        hrp.CFrame = hrp.CFrame * CFrame.new(0, 0, -4)
        task.wait(0.03)
    end

    local roar = math.random(1, 2)
    if roar == 1 and Scream then
        Scream.PlaybackSpeed = math.random(90, 130) / 100
        Scream:Play()
    elseif Repent then
        Repent.PlaybackSpeed = math.random(90, 130) / 100
        Repent:Play()
    end

    task.wait(2)
    dashCooldown = false
end

-- ============================================================
-- УПРАВЛЕНИЕ
-- ============================================================
LocalPlayer:GetMouse().KeyDown:Connect(function(key)
    if key == "r" then
        if Footsteps then
            if Footsteps.IsPlaying then Footsteps:Stop() else Footsteps:Play() end
        end
        if PlaySound then
            if PlaySound.IsPlaying then PlaySound:Stop() else PlaySound:Play() end
        end
    elseif key == "t" then
        if Scream then Scream:Play() end
    elseif key == "q" then
        ambushDash()
    elseif key == "f" then
        if Knock then Knock:Play() end
    elseif key == "e" then
        if Repent then Repent:Play() end
    end
end)

print("[Ambush Morph] Загружен с камерой от третьего лица! Q — рывок, T — scream, F — knock, E — repent, R — звуки")
