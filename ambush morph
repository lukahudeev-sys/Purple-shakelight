local function transformIntoAmbush()
    if _G.TransformedIntoAnyMorph == true then
	   return
    end
    _G.TransformedIntoAnyMorph = true

    local player = game.Players.LocalPlayer
    local char = player.Character or player.CharacterAdded:Wait()
    local hrp = char:WaitForChild("HumanoidRootPart")
    local hum = char:WaitForChild("Humanoid")

    -- делаем персонажа "Ambush" — красноватый, дёрганый
    for _, v in pairs(char:GetDescendants()) do
	   if v:IsA("BasePart") then
		  v.Material = Enum.Material.Neon
		  v.Color = Color3.fromRGB(120, 0, 0)
	   elseif v:IsA("Decal") or v:IsA("Texture") then
		  v.Transparency = 1
	   end
    end

    -- звуки (создаём сами)
    local roarSound = Instance.new("Sound", hrp)
    roarSound.SoundId = "rbxassetid://9114386356"
    roarSound.Volume = 5

    local footstepSound = Instance.new("Sound", hrp)
    footstepSound.SoundId = "rbxassetid://9114386356"
    footstepSound.Volume = 2

    local dashCooldown = false

    -- ФУНКЦИЯ РЫВКА (фишка Ambush)
    local function ambushDash()
	   if dashCooldown then return end
	   dashCooldown = true

	   -- мечемся в стороны
	   for i = 1, 6 do
		  local side = (i % 2 == 0) and 1 or -1
		  hrp.CFrame = hrp.CFrame * CFrame.new(side * 3, 0, 0)
		  wait(0.05)
	   end
	   -- рывок вперёд
	   for i = 1, 8 do
		  hrp.CFrame = hrp.CFrame * CFrame.new(0, 0, -4)
		  wait(0.03)
	   end

	   roarSound.PlaybackSpeed = math.random(90, 130) / 100
	   roarSound:Play()

	   wait(2)
	   dashCooldown = false
    end

    -- управление
    game.Players.LocalPlayer:GetMouse().KeyDown:Connect(function(key)
	   if key == "r" then
		  if footstepSound.IsPlaying then
			 footstepSound:Stop()
		  else
			 footstepSound:Play()
		  end
	   elseif key == "q" then
		  ambushDash()
	   elseif key == "e" then
		  roarSound:Play()
	   end
    end)
end
