```lua
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Player = Players.LocalPlayer
local Character = Player.Character or Player.CharacterAdded:Wait()

local MORPH_ID = "rbxassetid://98266611233960"

if _G.TransformedIntoAnyMorph then
	return
end

_G.TransformedIntoAnyMorph = true

local Ambush = game:GetObjects(MORPH_ID)[1]
Ambush.Parent = workspace

-- Запускаем основные звуки Ambush
Ambush.Main.Footsteps:Play()
Ambush.Main.PlaySound:Play()

-- Прячем настоящего персонажа и двигаем морф вместе с ним
RunService.RenderStepped:Connect(function()
	Character = Player.Character

	if not Character then
		return
	end

	local RootPart = Character:FindFirstChild("HumanoidRootPart")

	if not RootPart then
		return
	end

	-- Скрываем голову
	local Head = Character:FindFirstChild("Head")

	if Head then
		Head.Transparency = 1
	end

	-- Перемещаем Ambush за игроком
	Ambush:PivotTo(RootPart.CFrame)

	-- Скрываем тело
	for _, Object in ipairs(Character:GetChildren()) do
		if Object:IsA("BasePart") then
			Object.LocalTransparencyModifier = 1

			for _, Child in ipairs(Object:GetDescendants()) do
				if Child:IsA("Decal") or Child:IsA("Texture") then
					Child.Transparency = 1
				end
			end

		elseif Object:IsA("Accessory") then
			local Handle = Object:FindFirstChild("Handle")

			if Handle then
				Handle.Transparency = 1
			end
		end
	end
end)

-- R включает/выключает звуки Ambush
Player:GetMouse().KeyDown:Connect(function(Key)
	if Key ~= "r" then
		return
	end

	if Ambush.Main.Footsteps.IsPlaying then
		Ambush.Main.Footsteps:Stop()
	else
		Ambush.Main.Footsteps:Play()
	end

	if Ambush.Main.PlaySound.IsPlaying then
		Ambush.Main.PlaySound:Stop()
	else
		Ambush.Main.PlaySound:Play()
	end
end)
