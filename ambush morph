--[[
    Ambush Morph для Doors (камера мгновенная, мышь в правильную сторону)
    
    Управление:
      Мышь     — вращение камеры
      L        — переключить 1-е / 3-е лицо
      R        — переключить фоновые звуки
      T        — крик (Scream)
      Q        — рывок (Ambush мечется + рёв)
      F        — стук (Knock)
      P        — Repent
--]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer

if _G.AmbushMorphActive then
    warn("[Ambush Morph] Уже активен!")
    return
end
_G.AmbushMorphActive = true

local AMBUSH_ASSET = "rbxassetid://113981726565681"

-- ============================================================
-- ЗАГРУЗКА МОДЕЛИ
-- ============================================================
local ok, figureNew = pcall(function()
    return game:GetObjects(AMBUSH_ASSET)[1]
end)

if not ok or not figureNew then
    warn("[Ambush Morph] Не удалось загрузить модель Ambush. Проверь asset id: " .. AMBUSH_ASSET)
    _G.AmbushMorphActive = false
    return
end

figureNew.Parent = workspace

-- ============================================================
-- ЗВУКИ
-- ============================================================
local Main = figureNew:FindFirstChild("Main") or figureNew

local Footsteps = Main:FindFirstChild("Footsteps")
local PlaySound  = Main:FindFirstChild("PlaySound")
local Scream     = Main:FindFirstChild("Scream")
local Repent     = Main:FindFirstChild("Repent")
local Knock      = Main:FindFirstChild("Knock")

if Footsteps then Footsteps:Play() end
if PlaySound  then PlaySound:Play()  end

-- ============================================================
-- СИНХРОНИЗАЦИЯ + СКРЫТИЕ ИГРОКА
-- ============================================================
spawn(function()
    RunService.RenderStepped:Connect(function()
        local char = LocalPlayer.Character
        if not char then return end

        local head = char:FindFirstChild("Head")
        if head then head.Transparency = 1 end

        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp and figureNew.Parent then
            pcall(function()
                figureNew:PivotTo(hrp.CFrame)
            end)
        end

        for _, v in pairs(char:GetChildren()) do
            if v:IsA("BasePart") then
                v.LocalTransparencyModifier = 1
                for _, d in pairs(v:GetDescendants()) do
                    if d:IsA("Decal") or d:IsA("Texture") then
                        d.Transparency = 1
                    end
                end
            elseif v:IsA("Accessory") then
                if v:FindFirstChild("Handle") then
                    v.Handle.Transparency = 1
                end
            end
        end
    end)
end)

-- ============================================================
-- КАМЕРА (мгновенная, без плавности)
-- ============================================================
local camera = workspace.CurrentCamera

local CAMERA_DISTANCE = 12
local CAMERA_HEIGHT = 2
local MOUSE_SENSITIVITY = 0.5
local isThirdPerson = true

camera.CameraType = Enum.CameraType.Scriptable

local yaw = 0
local pitch = -0.2

UserInputService.InputChanged:Connect(function(input, processed)
    if input.UserInputType == Enum.UserInputType.MouseMovement then
        yaw = yaw - input.Delta.X * MOUSE_SENSITIVITY * 0.01
        pitch = math.clamp(pitch - input.Delta.Y * MOUSE_SENSITIVITY * 0.01, -1.2, 1.2)
    end
end)

RunService:BindToRenderStep("AmbushCamera", Enum.RenderPriority.Camera.Value + 1, function()
    local char = LocalPlayer.Character
    if not char then return end

    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local head = figureNew:FindFirstChild("Head", true)
    local targetPos = head and head.Position or hrp.Position

    local lookDir = Vector3.new(
        math.sin(yaw) * math.cos(pitch),
        math.sin(pitch),
        math.cos(yaw) * math.cos(pitch)
    )

    -- Модель смотрит туда же, куда камера (по горизонтали)
    local modelLook = Vector3.new(lookDir.X, 0, lookDir.Z)
    if modelLook.Magnitude > 0.01 then
        hrp.CFrame = CFrame.lookAt(hrp.Position, hrp.Position + modelLook)
    end

    if isThirdPerson then
        local camPos = targetPos - lookDir * CAMERA_DISTANCE + Vector3.new(0, CAMERA_HEIGHT, 0)
        camera.CFrame = CFrame.lookAt(camPos, targetPos, Vector3.new(0, 1, 0))
    else
        camera.CFrame = CFrame.lookAt(targetPos, targetPos + lookDir, Vector3.new(0, 1, 0))
    end

    camera.Focus = CFrame.new(targetPos)
end)

-- ============================================================
-- РЫВОК (фишка Ambush)
-- ============================================================
local dashCooldown = false

local function ambushDash()
    if dashCooldown then return end
    dashCooldown = true

    local char = LocalPlayer.Character
    if not char then dashCooldown = false return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then dashCooldown = false return end

    -- мечемся в стороны
    for i = 1, 6 do
        local side = (i % 2 == 0) and 1 or -1
        hrp.CFrame = hrp.CFrame * CFrame.new(side * 3, 0, 0)
        task.wait(0.05)
    end
    -- рывок вперёд
    for i = 1, 8 do
        hrp.CFrame = hrp.CFrame * CFrame.new(0, 0, -4)
        task.wait(0.03)
    end

    -- рёв
    local roar = math.random(1, 2)
    if roar == 1 and Scream then
        Scream.PlaybackSpeed = math.random(90, 130) / 100
        Scream:Play()
    elseif Repent then
        Repent.PlaybackSpeed = math.random(90, 130) / 100
        Repent:Play()
    end

    task.wait(2)
    dashCooldown = false
end

-- ============================================================
-- УПРАВЛЕНИЕ
-- ============================================================
UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end
    if input.UserInputType ~= Enum.UserInputType.Keyboard then return end

    local key = input.KeyCode

    if key == Enum.KeyCode.L then
        isThirdPerson = not isThirdPerson
    elseif key == Enum.KeyCode.R then
        if Footsteps then
            if Footsteps.IsPlaying then Footsteps:Stop() else Footsteps:Play() end
        end
        if PlaySound then
            if PlaySound.IsPlaying then PlaySound:Stop() else PlaySound:Play() end
        end
    elseif key == Enum.KeyCode.T then
        if Scream then Scream:Play() end
    elseif key == Enum.KeyCode.Q then
        ambushDash()
    elseif key == Enum.KeyCode.F then
        if Knock then Knock:Play() end
    elseif key == Enum.KeyCode.P then
        if Repent then Repent:Play() end
    end
end)

print("[Ambush Morph] Загружен! L — 1/3 лицо, Q — рывок, T — scream, F — knock, P — repent, R — звуки")
