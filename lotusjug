local function makePink(obj)
	pcall(function()
		if obj:IsA("ImageLabel") or obj:IsA("ImageButton") then
			obj.ImageColor3 = PINK
		elseif obj:IsA("Frame") or obj:IsA("TextLabel") or obj:IsA("TextButton") then
			obj.BackgroundColor3 = PINK
		elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam") then
			obj.Color = ColorSequence.new(PINK)
		elseif obj:IsA("PointLight") or obj:IsA("SpotLight") or obj:IsA("SurfaceLight") then
			obj.Color = PINK
		end
	end)

	for _, d in ipairs(obj:GetDescendants()) do
		pcall(function()
			if d:IsA("ImageLabel") or d:IsA("ImageButton") then
				d.ImageColor3 = PINK
			elseif d:IsA("Frame") or d:IsA("TextLabel") or d:IsA("TextButton") then
				d.BackgroundColor3 = PINK
			elseif d:IsA("ParticleEmitter") or d:IsA("Trail") or d:IsA("Beam") then
				d.Color = ColorSequence.new(PINK)
			elseif d:IsA("PointLight") or d:IsA("SpotLight") or d:IsA("SurfaceLight") then
				d.Color = PINK
			elseif d:IsA("UIGradient") then
				d.Color = ColorSequence.new(PINK)
			end
		end)
	end
end

