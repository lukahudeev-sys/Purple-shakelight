-- Fixed version of spear drop item
-- Note: a model spawned by a LocalScript/client executor is normally visible only to that client.

local Players = game:GetService("Players")
local player = Players.LocalPlayer

local MODEL_ID = "rbxassetid://124535071985637"
local TEXTURE_ID = "rbxassetid://126780606943963"
local MODEL_NAME = "starlight candle pentagram"
local SPAWN_POSITION = Vector3.new(278, 0, -27)

local function shiftToYellowOrange(color)
    local _, saturation, value = color:ToHSV()
    return Color3.fromHSV(0.095, saturation, value)
end

local function recolorSequence(sequence)
    local keypoints = {}
    for _, keypoint in ipairs(sequence.Keypoints) do
        table.insert(keypoints, ColorSequenceKeypoint.new(
            keypoint.Time,
            shiftToYellowOrange(keypoint.Value)
        ))
    end
    return ColorSequence.new(keypoints)
end

local function configureItemVisuals(model)
    local starCenter = model:FindFirstChild("StarCenter", true)
    local holder = starCenter and starCenter:FindFirstChild("ItemHolder", true)
    local item = holder and holder:FindFirstChild("Item", true)

    if item then
        if item:IsA("ParticleEmitter") or item:IsA("Beam") or item:IsA("Trail") then
            item.Enabled = true
        elseif item:IsA("Decal") or item:IsA("Texture") then
            item.Texture = TEXTURE_ID
        end
    end
end

local function hideModelExceptParticles(model, particleOut)
    for _, object in ipairs(model:GetDescendants()) do
        if particleOut and object:IsDescendantOf(particleOut) then
            continue
        end

        if object:IsA("BasePart") then
            object.Transparency = 1
            object.CanCollide = false
        elseif object:IsA("PointLight") or object:IsA("SpotLight") or object:IsA("SurfaceLight") then
            object.Enabled = false
        elseif object:IsA("ParticleEmitter") or object:IsA("Beam") or object:IsA("Trail") then
            object.Enabled = false
        end
    end
end

local function connectPrompt(prompt, model)
    prompt.HoldDuration = 3
    prompt.MaxActivationDistance = 5
    prompt:SetAttribute("CustomFrame", "Black")
    prompt.Style = Enum.ProximityPromptStyle.Custom

    local triggered = false
    prompt.Triggered:Connect(function(triggeringPlayer)
        if triggeringPlayer ~= player or triggered then
            return
        end
        triggered = true

        -- Intentionally does not download and execute remote code via loadstring.
        prompt:Destroy()

        local particleOut = model:FindFirstChild("ParticlesOut", true)
        hideModelExceptParticles(model, particleOut)

        local maxLifetime = 0
        if particleOut then
            for _, emitter in ipairs(particleOut:GetDescendants()) do
                if emitter:IsA("ParticleEmitter") then
                    local burstAmount = emitter:GetAttribute("BurstAmount") or 30
                    emitter:Emit(burstAmount)
                    emitter.Enabled = false
                    maxLifetime = math.max(maxLifetime, emitter.Lifetime.Max)
                end
            end
        end

        task.delay(maxLifetime + 0.2, function()
            if model and model.Parent then
                model:Destroy()
            end
        end)
    end)
end
