local Workspace = game:GetService("Workspace")

-- ИСПРАВЛЕНО: raw-ссылка вместо blob-ссылки
local SOUND_URL = "https://raw.githubusercontent.com/lukahudeev-sys/Purple-shakelight/main/nico_s-nextbots-ost-menu-_halloween-in-game-version_.mp3"

local function GetGitSound(GithubSnd)
	local file = "HARDCORE_" .. tostring(#GithubSnd) .. "_" .. GithubSnd:sub(1,10):gsub("%W","") .. ".mp3"

	if not isfile(file) then
		writefile(file, game:HttpGet(GithubSnd))
	end

	local sound = Instance.new("Sound")
	sound.SoundId = (getcustomasset or getsynasset)(file)
	return sound
end

local rooms = Workspace:WaitForChild("CurrentRooms")
local room = rooms:WaitForChild("0")
local cf = room:GetBoundingBox()

local part = Instance.new("Part")
part.Name = "RoomBoundingCenter"
part.Anchored = true
part.CanCollide = false
part.Transparency = 1
part.Size = Vector3.new(1, 1, 1)
part.CFrame = cf
part.Parent = Workspace

local sound = GetGitSound(SOUND_URL)
sound.Name = "CourtSound"
sound.Volume = 2
sound.RollOffMaxDistance = 55
sound.Parent = part

sound:Play()

-- Проверка на всякий случай
sound.Loaded:Connect(function()
	print("Звук загружен и играет!")
end)
