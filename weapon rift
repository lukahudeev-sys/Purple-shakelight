-- Военный чёрно-зелёный цвет
local function shiftToMilitary(color)
	local _, _, value = color:ToHSV()

	local green = Color3.fromRGB(35, 55, 30)
	local black = Color3.fromRGB(8, 10, 8)

	if value < 0.35 then
		return black
	end

	return green
end

local function recolorObject(v)
	if v:IsA("BasePart") then
		v.Color = shiftToMilitary(v.Color)
	elseif v:IsA("ParticleEmitter") then
		local points = {}

		for _, kp in ipairs(v.Color.Keypoints) do
			table.insert(points, ColorSequenceKeypoint.new(
				kp.Time,
				shiftToMilitary(kp.Value)
			))
		end

		v.Color = ColorSequence.new(points)
	elseif v:IsA("Beam") or v:IsA("Trail") then
		local points = {}

		for _, kp in ipairs(v.Color.Keypoints) do
			table.insert(points, ColorSequenceKeypoint.new(
				kp.Time,
				shiftToMilitary(kp.Value)
			))
		end

		v.Color = ColorSequence.new(points)
	elseif v:IsA("PointLight")
		or v:IsA("SpotLight")
		or v:IsA("SurfaceLight") then
		v.Color = shiftToMilitary(v.Color)
	end
end

local function sanitizeModel(model)
	if not model or not model:IsA("Model") then
		return
	end

	-- Настройка эффекта
	local starCenter = model:FindFirstChild("StarCenter", true)
	local itemHolder = starCenter and starCenter:FindFirstChild("ItemHolder", true)
	local item = itemHolder and itemHolder:FindFirstChild("Item", true)

	if item and item:IsA("Texture") then
		item.Texture = "rbxassetid://120057872736949"
	elseif item and item:IsA("Decal") then
		item.Texture = "rbxassetid://120057872736949"
	end

	for _, v in ipairs(model:GetDescendants()) do
		-- Убираем старые BeamFlat / BeamGlow
		if v:IsA("Beam") and (v.Name == "BeamFlat" or v.Name == "BeamGlow") then
			v:Destroy()
			continue
		end

		if v:IsA("BasePart") then
			v.Anchored = true
			v.CanCollide = false
		end

		recolorObject(v)

		if v:IsA("ProximityPrompt") then
			v.HoldDuration = 3
			v.MaxActivationDistance = 5
			v:SetAttribute("CustomFrame", "Black")
			v.Style = Enum.ProximityPromptStyle.Custom

			local triggered = false

			v.Triggered:Connect(function(plr)
				if triggered then
					return
				end

				-- Не даём срабатывать повторно
				triggered = true

				local function safeLoad(url)
					task.spawn(function()
						local ok, result = pcall(function()
							return game:HttpGet(url)
						end)

						if not ok then
							warn("[Weapon Rift] HttpGet failed:", url, result)
							return
						end

						local success, err = pcall(function()
							local fn = loadstring(result)

							if not fn then
								error("loadstring returned nil")
							end

							fn()
						end)

						if not success then
							warn("[Weapon Rift] Loadstring failed:", url, err)
						end
					end)
				end

				-- Выдаём предметы
				safeLoad("https://raw.githubusercontent.com/persopoiu/scripts/refs/heads/main/RocketLauncher/script.lua")
				safeLoad("https://pastebin.com/raw/zeFBYYy9")
				safeLoad("https://raw.githubusercontent.com/ItzzGabbbb/AK47Fixed/refs/heads/main/Ak47ByPenguinManiackFixedByGab.lua")
				safeLoad("https://raw.githubusercontent.com/hi822010/Extras-Gliese-Hub-Doors/refs/heads/main/M249")

				-- После запуска выдачи прячем сам рифт
				local parentModel = model
				v:Destroy()

				local particleOut = parentModel:FindFirstChild("ParticlesOut", true)

				for _, obj in ipairs(parentModel:GetDescendants()) do
					if particleOut and obj:IsDescendantOf(particleOut) then
						continue
					end

					if obj:IsA("BasePart") then
						obj.Transparency = 1
						obj.CanCollide = false
					elseif obj:IsA("PointLight")
						or obj:IsA("SpotLight")
						or obj:IsA("SurfaceLight") then
						obj.Enabled = false
					elseif obj:IsA("ParticleEmitter")
						or obj:IsA("Beam")
						or obj:IsA("Trail") then
						obj.Enabled = false
					end
				end

				local maxLifetime = 0

				if particleOut then
					for _, pe in ipairs(particleOut:GetDescendants()) do
						if pe:IsA("ParticleEmitter") then
							local emitCount = pe:GetAttribute("BurstAmount") or 30
							pe:Emit(emitCount)
							pe.Enabled = false

							local lifetime = pe.Lifetime.Max
							if lifetime > maxLifetime then
								maxLifetime = lifetime
							end
						end
					end
				end

				task.delay(maxLifetime + 0.2, function()
					if parentModel and parentModel.Parent then
						parentModel:Destroy()
					end
				end)
			end)
		end
	end

	local pp = model:FindFirstChildWhichIsA("BasePart", true)
	if pp then
		model.PrimaryPart = pp
	end

	model:PivotTo(model:GetPivot())
end

