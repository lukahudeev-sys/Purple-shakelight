local function collectKeys(t)
    local keys = {}
    for k in pairs(t) do table.insert(keys, k) end
    table.sort(keys)
    return keys
end

ItemsBox:AddDropdown("Items", {
    Values  = collectKeys(ITEMS),
    Default = "Golden Flashlight",
    Multi   = false,
    Text    = "Select the item",
    Callback = function(choice)
        local url = ITEMS[choice]
        if not url then
            Obsidian:Notify(choice .. " — скрипт пока недоступен", 3)
            return
        end
        safeLoad(url, choice)
        Obsidian:Notify(choice .. " loaded!", 3)
    end
})

