local function safeLoad(url, label)
    local ok, err = pcall(function()
        local src = game:HttpGet(url)
        local fn  = loadstring(src)
        if not fn then error("loadstring failed") end
        fn()
    end)
    if not ok then
        warn(("[Hub] Ошибка загрузки %s: %s"):format(label or "?", tostring(err)))
        pcall(function() Obsidian:Notify("Ошибка: " .. (label or "?"), 4) end)
    end
    return ok
end

