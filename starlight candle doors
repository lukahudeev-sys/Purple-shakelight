-- Загрузка утилит
loadstring(game:HttpGet("https://raw.githubusercontent.com/RegularVynixu/Utilities/main/Functions.lua"))()

-- \\ Настройки // --
local CANDLE_ID         = "rbxassetid://110853297264350"
local HIGHLIGHT_COLOR   = Color3.fromRGB(255, 220, 60)   -- обычная дверь (жёлтая)
local LOCKED_COLOR      = Color3.fromRGB(255, 80, 80)    -- запертая дверь (красная)
local HIGHLIGHT_FILL    = 0.55
local HIGHLIGHT_OUTLINE = 0.15

-- \\ Создание свечи // --
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local tool = LoadCustomInstance(CANDLE_ID)
tool.Name = "Star Candle"
tool.Parent = LocalPlayer.Backpack
tool.Animations.idle.AnimationId = "rbxassetid://10479585177"

-- Перекрас в звёздный (жёлто-золотой) цвет
local function starColor(color)
	local _, s, v = Color3.toHSV(color)
	return Color3.fromHSV(0.13, math.clamp(s * 0.8, 0, 1), v) -- золотистый оттенок
end

local function recolorSeq(seq)
	local newKeys = {}
	for _, key in ipairs(seq.Keypoints) do
		table.insert(newKeys, ColorSequenceKeypoint.new(key.Time, starColor(key.Value)))
	end
	return ColorSequence.new(newKeys)
end

for _, obj in ipairs(tool:GetDescendants()) do
	if obj:IsA("BasePart") then
		obj.Color = starColor(obj.Color)
	elseif obj:IsA("PointLight") or obj:IsA("SpotLight") or obj:IsA("SurfaceLight") then
		obj.Color = starColor(obj.Color)
	elseif obj:IsA("ParticleEmitter") then
		obj.Color = recolorSeq(obj.Color)
	elseif obj:IsA("Trail") then
		obj.Color = recolorSeq(obj.Color)
	elseif obj:IsA("Beam") then
		obj.Color = recolorSeq(obj.Color)
	end
end

-- \\ Подсветка дверей в DOORS // --
local activeHighlights = {}
local highlightEnabled = false

local function makeHighlight(door, isLocked)
	local hl = Instance.new("Highlight")
	hl.Name = "StarCandleHighlight"
	hl.Adornee = door
	hl.FillColor = isLocked and LOCKED_COLOR or HIGHLIGHT_COLOR
	hl.FillTransparency = HIGHLIGHT_FILL
	hl.OutlineColor = Color3.fromRGB(255, 255, 200)   -- светло-жёлтый контур
	hl.OutlineTransparency = HIGHLIGHT_OUTLINE
	hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	hl.Parent = door
	return hl
end

local function refreshRoom(room)
	local door = room:FindFirstChild("Door")
	if not door then return end

	local existing = activeHighlights[door]
	if existing and existing.Parent then
		local isLocked = door:FindFirstChild("Lock") ~= nil
		existing.FillColor = isLocked and LOCKED_COLOR or HIGHLIGHT_COLOR
		return
	end

	if not highlightEnabled then return end

	local isLocked = door:FindFirstChild("Lock") ~= nil
	activeHighlights[door] = makeHighlight(door, isLocked)
end

local function scanAllRooms()
	local currentRooms = workspace:FindFirstChild("CurrentRooms")
	if not currentRooms then return end
	for _, room in ipairs(currentRooms:GetChildren()) do
		refreshRoom(room)
	end
end

local function clearHighlights()
	for _, hl in pairs(activeHighlights) do
		if hl and hl.Parent then hl:Destroy() end
	end
	activeHighlights = {}
end

-- \\ Автослежение за новыми комнатами // --
local currentRoomsConn
local function bindRooms()
	if currentRoomsConn then currentRoomsConn:Disconnect() end

	local currentRooms = workspace:WaitForChild("CurrentRooms", 10)
	if not currentRooms then return end

	currentRoomsConn = currentRooms.ChildAdded:Connect(function(room)
		task.wait(0.1)
		refreshRoom(room)
	end)
end

-- \\ Тумблер // --
local function toggleHighlight()
	highlightEnabled = not highlightEnabled
	if highlightEnabled then
		scanAllRooms()
		bindRooms()
		print("[Star Candle] Подсветка ВКЛ (жёлтая)")
	else
		clearHighlights()
		if currentRoomsConn then
			currentRoomsConn:Disconnect()
			currentRoomsConn = nil
		end
		print("[Star Candle] Подсветка ВЫКЛ")
	end
end

-- \\ Активация // --
tool.Activated:Connect(toggleHighlight)

local UIS = game:GetService("UserInputService")
UIS.InputBegan:Connect(function(input, gp)
	if gp then return end
	if input.KeyCode == Enum.KeyCode.E then
		toggleHighlight()
	end
end)

-- Автостарт
task.wait(1)
toggleHighlight()
