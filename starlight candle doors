loadstring(game:HttpGet("https://raw.githubusercontent.com/RegularVynixu/Utilities/main/Functions.lua"))()

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local tool = LoadCustomInstance("rbxassetid://110853297264350")
tool.Name = "Star Candle"
tool.Parent = LocalPlayer.Backpack

local espFolder = Instance.new("Folder")
espFolder.Name = "StarCandleESP"
espFolder.Parent = game:GetService("CoreGui")

local tracked = {}
local connection = nil
local active = false

local doorFolder = workspace:FindFirstChild("Doors") or workspace:FindFirstChild("Door")

-- Проверка: есть ли в двери табличка с номером (цифрами)
local function hasNumber(door)
	for _, obj in ipairs(door:GetDescendants()) do
		-- TextLabel с цифрами
		if obj:IsA("TextLabel") or obj:IsA("TextButton") then
			if string.match(obj.Text, "%d") then
				return true
			end
		-- SurfaceGui / BillboardGui / Decal — если в имени есть "number" / "num"
		elseif obj:IsA("SurfaceGui") or obj:IsA("BillboardGui") then
			local n = string.lower(obj.Name)
			if string.find(n, "num") or string.find(n, "plate") or string.find(n, "sign") then
				return true
			end
		-- Part / Decal с номером в имени
		elseif obj:IsA("BasePart") or obj:IsA("Decal") then
			if string.match(obj.Name, "%d") then
				return true
			end
		end
	end
	-- Номер может быть в имени самой двери (door1, door_23)
	if string.match(door.Name, "%d") then
		return true
	end
	return false
end

local function isDoor(obj)
	if not obj or not obj:IsA("BasePart") then return false end

	-- Проверка папки
	if doorFolder then
		if not obj:IsDescendantOf(doorFolder) then return false end
	else
		-- Имя должно содержать "door"
		local n = string.lower(obj.Name)
		if not string.find(n, "door") then return false end

		-- Проверка размера (дверь высокая)
		local size = obj.Size
		if size.Y < 4 then return false end
		if size.Y <= size.X or size.Y <= size.Z then return false end
	end

	-- Только двери С номером
	return hasNumber(obj)
end

local function createESP(door)
	if tracked[door] then return end

	local hl = Instance.new("Highlight")
	hl.Name = "StarCandleHL"
	hl.Adornee = door
	hl.FillColor = Color3.fromRGB(255, 220, 120)
	hl.OutlineColor = Color3.fromRGB(255, 255, 255)
	hl.FillTransparency = 0.6
	hl.OutlineTransparency = 1
	hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	hl.Parent = espFolder

	local box = Instance.new("SelectionBox")
	box.Name = "StarCandleBox"
	box.Adornee = door
	box.Color3 = Color3.fromRGB(255, 230, 140)
	box.LineThickness = 0.15
	box.SurfaceTransparency = 1
	box.Transparency = 0
	box.Parent = espFolder

	tracked[door] = {hl = hl, box = box}
end

local function clearAll()
	for door, data in pairs(tracked) do
		if data.hl then data.hl:Destroy() end
		if data.box then data.box:Destroy() end
	end
	tracked = {}
end

local function scanDoors()
	for _, obj in ipairs(workspace:GetDescendants()) do
		if isDoor(obj) then
			createESP(obj)
		end
	end
end

local function onEquip()
	if active then return end
	active = true

	scanDoors()

	connection = workspace.DescendantAdded:Connect(function(obj)
		if not active then return end
		task.wait(0.3)
		if isDoor(obj) then
			createESP(obj)
		end
	end)
end

local function onUnequip()
	active = false
	if connection then
		connection:Disconnect()
		connection = nil
	end
	clearAll()
end

tool.Equipped:Connect(onEquip)
tool.Unequipped:Connect(onUnequip)
