local Watermark = Obsidian:AddDraggableLabel("Doors Items Hub")
Watermark:SetVisible(true)

do
    local frames = 0
    local fps = 60
    local lastUpdate = tick()
    game:GetService("RunService").RenderStepped:Connect(function()
        frames += 1
        if tick() - lastUpdate >= 1 then
            fps = frames
            frames = 0
            lastUpdate = tick()
        end
        local ping = 0
        pcall(function()
            ping = math.floor(game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValue())
        end)
        Watermark:SetText(("Doors Items Hub | %d fps | %d ms"):format(fps, ping))
    end)
end

