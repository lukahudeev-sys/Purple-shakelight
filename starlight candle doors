loadstring(game:HttpGet("https://raw.githubusercontent.com/RegularVynixu/Utilities/main/Functions.lua"))()

local tool = LoadCustomInstance("rbxassetid://110853297264350")
tool.Parent = game:GetService("Players").LocalPlayer.Backpack
tool.Name = "Glitch Candle"

if tool:FindFirstChild("Animations") and tool.Animations:FindFirstChild("idle") then
    tool.Animations.idle.AnimationId = "rbxassetid://10479585177"
end
if tool:IsA("Tool") then
    tool.TextureId = "rbxassetid://103455405358047"
end

-- Запоминаем исходные материалы всех BasePart
local originalMaterials = {}
for _, obj in ipairs(tool:GetDescendants()) do
    if obj:IsA("BasePart") then
        originalMaterials[obj] = obj.Material
    end
end

-- =========================
-- ПОДСВЕТКА ВСЕХ ДВЕРЕЙ + НОМЕРА
-- =========================
local Workspace = game:GetService("Workspace")

local stopped = true
local activeHighlights = {}   -- [door] = {highlight, billboard}
local connections = {}

local FILL_COLOR    = Color3.fromRGB(255, 220, 80)
local OUTLINE_COLOR = Color3.fromRGB(255, 170, 0)
local TEXT_COLOR    = Color3.fromRGB(255, 235, 120)

local ATTRIBUTE_NAMES = {"Code", "Number", "RoomNumber", "DoorNumber", "NumberCode", "Num"}

local function getDoorNumber(door)
    -- 1) Пробуем атрибуты
    for _, attr in ipairs(ATTRIBUTE_NAMES) do
        local v = door:GetAttribute(attr)
        if v ~= nil and tostring(v) ~= "" then
            return tostring(v)
        end
    end

    -- 2) Ищем TextLabel внутри двери, у которого текст — число/код
    for _, d in ipairs(door:GetDescendants()) do
        if d:IsA("TextLabel") or d:IsA("TextButton") then
            local t = d.Text
            if t and t:match("^%d+$") and #t >= 1 then
                return t
            end
        end
    end

    -- 3) Ищем в названии двери (Door_0001, Door1234 и т.п.)
    local num = door.Name:match("(%d+)")
    if num then return num end

    return nil
end

local function isDoorModel(inst)
    if not inst:IsA("Model") then return false end
    local n = inst.Name:lower()
    return n == "door" or n:find("door") ~= nil
end

local function getDoorPrimaryPart(door)
    local p = door.PrimaryPart
    if not p then
        p = door:FindFirstChildWhichIsA("BasePart", true)
    end
    return p
end

local function applyToDoor(door)
    if activeHighlights[door] then return end

    -- Highlight
    local h = Instance.new("Highlight")
    h.FillColor = FILL_COLOR
    h.OutlineColor = OUTLINE_COLOR
    h.FillTransparency = 0.35
    h.OutlineTransparency = 0
    h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    h.Parent = door

    -- BillboardGui с номером
    local billboard
    local num = getDoorNumber(door)
    local part = getDoorPrimaryPart(door)
    if part and num then
        billboard = Instance.new("BillboardGui")
        billboard.Name = "GlitchDoorNumber"
        billboard.Size = UDim2.new(0, 160, 0, 60)
        billboard.StudsOffset = Vector3.new(0, 4, 0)
        billboard.AlwaysOnTop = true
        billboard.MaxDistance = 500
        billboard.Parent = part

        local lbl = Instance.new("TextLabel")
        lbl.Size = UDim2.new(1, 0, 1, 0)
        lbl.BackgroundTransparency = 1
        lbl.Text = num
        lbl.TextColor3 = TEXT_COLOR
        lbl.TextStrokeTransparency = 0.4
        lbl.TextStrokeColor3 = Color3.fromRGB(90, 60, 0)
        lbl.TextScaled = true
        lbl.Font = Enum.Font.GothamBold
        lbl.Parent = billboard
    end

    activeHighlights[door] = {highlight = h, billboard = billboard}
end

local function process(inst)
    if stopped then return end
    if isDoorModel(inst) then
        applyToDoor(inst)
    end
end

local function scanContainer(container)
    if stopped or not container then return end
    for _, v in ipairs(container:GetDescendants()) do
        process(v)
    end
end

local function hookContainer(container)
    if not container then return end
    local conn = container.DescendantAdded:Connect(function(v)
        if stopped then return end
        task.wait()
        process(v)
    end)
    table.insert(connections, conn)
end

local function startHighlight()
    if not stopped then return end
    stopped = false
    activeHighlights = {}
    connections = {}

    task.spawn(function()
        scanContainer(Workspace)

        local rooms = Workspace:FindFirstChild("CurrentRooms")
        if not rooms then
            rooms = Workspace:WaitForChild("CurrentRooms", 15)
        end
        if rooms then
            scanContainer(rooms)
            hookContainer(rooms)
        end

        local wsConn = Workspace.ChildAdded:Connect(function(child)
            if child.Name == "CurrentRooms" then
                task.wait(0.5)
                scanContainer(child)
                hookContainer(child)
            end
        end)
        table.insert(connections, wsConn)

        hookContainer(Workspace)
    end)
end

local function stopHighlight()
    stopped = true

    for _, conn in ipairs(connections) do
        if conn then conn:Disconnect() end
    end
    connections = {}

    for door, data in pairs(activeHighlights) do
        if data.highlight and data.highlight.Parent then
            data.highlight:Destroy()
        end
        if data.billboard and data.billboard.Parent then
            data.billboard:Destroy()
        end
    end
    activeHighlights = {}
end

-- =========================
-- ЭКИПИРОВКА / СНЯТИЕ
-- =========================
tool.Equipped:Connect(function()
    for part, _ in pairs(originalMaterials) do
        if part and part.Parent then
            part.Material = Enum.Material.Neon
        end
    end
    startHighlight()
end)

tool.Unequipped:Connect(function()
    for part, material in pairs(originalMaterials) do
        if part and part.Parent then
            part.Material = material
        end
    end
    stopHighlight()
end)
