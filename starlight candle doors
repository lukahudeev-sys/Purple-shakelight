loadstring(game:HttpGet("https://raw.githubusercontent.com/RegularVynixu/Utilities/main/Functions.lua"))()

local tool = LoadCustomInstance("rbxassetid://110853297264350")
tool.Parent = game:GetService("Players").LocalPlayer.Backpack
tool.Name = "Glitch Candle"

if tool:FindFirstChild("Animations") and tool.Animations:FindFirstChild("idle") then
    tool.Animations.idle.AnimationId = "rbxassetid://10479585177"
end
if tool:IsA("Tool") then
    tool.TextureId = "rbxassetid://103455405358047"
end

local originalMaterials = {}
for _, obj in ipairs(tool:GetDescendants()) do
    if obj:IsA("BasePart") then
        originalMaterials[obj] = obj.Material
    end
end

-- =========================
-- ПОДСВЕТКА ДВЕРЕЙ 2..100 (не запертых)
-- =========================
local Workspace = game:GetService("Workspace")

local MIN_NUM = 2
local MAX_NUM = 100

local stopped = true
local activeHighlights = {}
local connections = {}

-- Настройки подсветки: только контур, заливка почти прозрачная
local FILL_COLOR      = Color3.fromRGB(255, 220, 80)
local OUTLINE_COLOR   = Color3.fromRGB(255, 200, 40)
local FILL_TRANSP     = 0.9   -- 0.9 = почти не видно заливки
local OUTLINE_TRANSP  = 0     -- контур яркий

local ATTRIBUTE_NAMES = {
    "Code", "Number", "RoomNumber", "DoorNumber",
    "NumberCode", "Num", "Room", "RoomId", "Id", "ID"
}

local function extractNumber(str)
    if not str then return nil end
    str = tostring(str)
    local digits = str:match("(%d+)")
    if not digits then return nil end
    return tonumber(digits)
end

local function getDoorNumber(door)
    for _, attr in ipairs(ATTRIBUTE_NAMES) do
        local v = door:GetAttribute(attr)
        if v ~= nil then
            local n = extractNumber(v)
            if n then return n end
        end
    end

    for _, d in ipairs(door:GetDescendants()) do
        if d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then
            local n = extractNumber(d.Text)
            if n then return n end
        end
    end

    local n = extractNumber(door.Name)
    if n then return n end

    return nil
end

-- Проверка на запертую дверь
local function isLocked(door)
    local lockedAttr = door:GetAttribute("Locked") or door:GetAttribute("IsLocked")
    if lockedAttr == true then return true end

    for _, d in ipairs(door:GetDescendants()) do
        if d.Name == "Lock" or d.Name:lower():find("lock") then
            return true
        end
    end
    return false
end

local function isDoorModel(inst)
    if not inst:IsA("Model") then return false end
    local n = inst.Name:lower()
    return n == "door" or n:find("door") ~= nil
end

local function applyHighlight(door)
    if activeHighlights[door] then return end

    local h = Instance.new("Highlight")
    h.FillColor = FILL_COLOR
    h.OutlineColor = OUTLINE_COLOR
    h.FillTransparency = FILL_TRANSP
    h.OutlineTransparency = OUTLINE_TRANSP
    h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    h.Parent = door

    activeHighlights[door] = h
end

local function process(inst)
    if stopped then return end
    if not isDoorModel(inst) then return end

    local n = getDoorNumber(inst)
    if not n or n < MIN_NUM or n > MAX_NUM then return end

    if isLocked(inst) then return end

    applyHighlight(inst)
end

local function scanContainer(container)
    if stopped or not container then return end
    for _, v in ipairs(container:GetDescendants()) do
        process(v)
    end
end

local function hookContainer(container)
    if not container then return end
    local conn = container.DescendantAdded:Connect(function(v)
        if stopped then return end
        task.wait()
        process(v)
    end)
    table.insert(connections, conn)
end

local function startHighlight()
    if not stopped then return end
    stopped = false
    activeHighlights = {}
    connections = {}

    task.spawn(function()
        scanContainer(Workspace)

        local rooms = Workspace:FindFirstChild("CurrentRooms")
        if not rooms then
            rooms = Workspace:WaitForChild("CurrentRooms", 15)
        end
        if rooms then
            scanContainer(rooms)
            hookContainer(rooms)
        end

        local wsConn = Workspace.ChildAdded:Connect(function(child)
            if child.Name == "CurrentRooms" then
                task.wait(0.5)
                scanContainer(child)
                hookContainer(child)
            end
        end)
        table.insert(connections, wsConn)

        hookContainer(Workspace)
    end)
end

local function stopHighlight()
    stopped = true

    for _, conn in ipairs(connections) do
        if conn then conn:Disconnect() end
    end
    connections = {}

    for door, h in pairs(activeHighlights) do
        if h and h.Parent then
            h:Destroy()
        end
    end
    activeHighlights = {}
end

tool.Equipped:Connect(function()
    for part, _ in pairs(originalMaterials) do
        if part and part.Parent then
            part.Material = Enum.Material.Neon
        end
    end
    startHighlight()
end)

tool.Unequipped:Connect(function()
    for part, material in pairs(originalMaterials) do
        if part and part.Parent then
            part.Material = material
        end
    end
    stopHighlight()
end)
