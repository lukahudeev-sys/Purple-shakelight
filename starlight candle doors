loadstring(game:HttpGet("https://raw.githubusercontent.com/RegularVynixu/Utilities/main/Functions.lua"))()

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

-- Загружаем свечу по указанному ID
local tool = LoadCustomInstance("rbxassetid://110853297264350")
tool.Name = "Star Candle"
tool.Parent = LocalPlayer.Backpack

-- Папка для подсветки дверей
local highlightFolder = Instance.new("Folder")
highlightFolder.Name = "StarCandleHighlights"
highlightFolder.Parent = workspace

local activeHighlights = {}

local function isDoor(obj)
	if not obj or not obj:IsA("BasePart") then return false end
	local n = string.lower(obj.Name)
	if string.find(n, "door") or string.find(n, "двер") then
		return true
	end
	return false
end

local function addHighlight(door)
	if activeHighlights[door] then return end

	local hl = Instance.new("Highlight")
	hl.Name = "StarCandleHL"
	hl.Adornee = door
	hl.FillColor = Color3.fromRGB(255, 220, 120)   -- звёздный жёлтый
	hl.OutlineColor = Color3.fromRGB(255, 255, 255)
	hl.FillTransparency = 0.55
	hl.OutlineTransparency = 0.15
	hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	hl.Parent = highlightFolder

	local light = Instance.new("PointLight")
	light.Name = "StarCandleLight"
	light.Color = Color3.fromRGB(255, 230, 150)
	light.Range = 18
	light.Brightness = 2.5
	light.Parent = door

	activeHighlights[door] = {Highlight = hl, Light = light}
end

local function removeAllHighlights()
	for door, data in pairs(activeHighlights) do
		if data.Highlight then data.Highlight:Destroy() end
		if data.Light then data.Light:Destroy() end
	end
	activeHighlights = {}
end

local function scanDoors()
	for _, obj in ipairs(workspace:GetDescendants()) do
		if obj:IsA("Model") then
			for _, part in ipairs(obj:GetDescendants()) do
				if isDoor(part) then
					addHighlight(part)
				end
			end
		elseif isDoor(obj) then
			addHighlight(obj)
		end
	end
end

-- Следим за новыми дверями, пока свеча экипирована
local connection
local function startScanning()
	scanDoors()
	connection = workspace.DescendantAdded:Connect(function(obj)
		task.wait(0.1)
		if isDoor(obj) then
			addHighlight(obj)
		end
	end)
end

local function stopScanning()
	if connection then
		connection:Disconnect()
		connection = nil
	end
	removeAllHighlights()
end

tool.Equipped:Connect(startScanning)
tool.Unequipped:Connect(stopScanning)

-- Если уже в руках при загрузке
if tool.Parent == LocalPlayer.Character then
	startScanning()
end
