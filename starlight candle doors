loadstring(game:HttpGet("https://raw.githubusercontent.com/RegularVynixu/Utilities/main/Functions.lua"))()

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

-- Загружаем свечу
local tool = LoadCustomInstance("rbxassetid://110853297264350")
tool.Name = "Star Candle"
tool.Parent = LocalPlayer.Backpack

-- Папка для ESP
local espFolder = Instance.new("Folder")
espFolder.Name = "StarCandleESP"
espFolder.Parent = game:GetService("CoreGui")

local tracked = {}
local connection = nil
local active = false

local function isDoor(obj)
	if not obj or not obj:IsA("BasePart") then return false end
	local n = string.lower(obj.Name)
	return string.find(n, "door") or string.find(n, "двер")
end

-- ESP на дверь (БЕЗ света)
local function createESP(door)
	if tracked[door] then return end

	local hl = Instance.new("Highlight")
	hl.Name = "StarCandleHL"
	hl.Adornee = door
	hl.FillColor = Color3.fromRGB(255, 235, 160)
	hl.OutlineColor = Color3.fromRGB(255, 255, 255)
	hl.FillTransparency = 0.9      -- почти прозрачная заливка
	hl.OutlineTransparency = 0.35
	hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	hl.Parent = espFolder

	local billboard = Instance.new("BillboardGui")
	billboard.Name = "StarCandleName"
	billboard.Adornee = door
	billboard.Size = UDim2.new(0, 200, 0, 40)
	billboard.StudsOffset = Vector3.new(0, 2.5, 0)
	billboard.AlwaysOnTop = true
	billboard.MaxDistance = 250
	billboard.Parent = espFolder

	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = "🚪 " .. door.Name
	label.TextColor3 = Color3.fromRGB(255, 240, 180)
	label.TextStrokeTransparency = 0.3
	label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
	label.TextScaled = true
	label.Font = Enum.Font.GothamBold
	label.Parent = billboard

	-- никакого PointLight на двери
	tracked[door] = {Highlight = hl, Billboard = billboard}
end

local function clearAll()
	for door, data in pairs(tracked) do
		if data.Highlight then data.Highlight:Destroy() end
		if data.Billboard then data.Billboard:Destroy() end
		if data.Light then data.Light:Destroy() end
	end
	tracked = {}
end

local function scanDoors()
	for _, obj in ipairs(workspace:GetDescendants()) do
		if isDoor(obj) then
			createESP(obj)
		end
	end
end

local function onEquip()
	if active then return end
	active = true

	scanDoors()

	connection = workspace.DescendantAdded:Connect(function(obj)
		if not active then return end
		task.wait(0.1)
		if isDoor(obj) then
			createESP(obj)
		end
	end)
end

local function onUnequip()
	active = false
	if connection then
		connection:Disconnect()
		connection = nil
	end
	clearAll()
end

tool.Equipped:Connect(onEquip)
tool.Unequipped:Connect(onUnequip)
