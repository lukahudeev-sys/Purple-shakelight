loadstring(game:HttpGet("https://raw.githubusercontent.com/RegularVynixu/Utilities/main/Functions.lua"))()

local tool = LoadCustomInstance("rbxassetid://110853297264350")
tool.Parent = game:GetService("Players").LocalPlayer.Backpack
tool.Name = "Glitch Candle"

if tool:FindFirstChild("Animations") and tool.Animations:FindFirstChild("idle") then
    tool.Animations.idle.AnimationId = "rbxassetid://10479585177"
end
if tool:IsA("Tool") then
    tool.TextureId = "rbxassetid://103455405358047"
end

-- Запоминаем исходные материалы всех BasePart
local originalMaterials = {}
for _, obj in ipairs(tool:GetDescendants()) do
    if obj:IsA("BasePart") then
        originalMaterials[obj] = obj.Material
    end
end

-- =========================
-- ПОДСВЕТКА ГЛАВНОЙ ДВЕРИ (жёлтая)
-- =========================
local Workspace = game:GetService("Workspace")

local stopped = true
local activeHighlight = nil
local connections = {}

local FILL_COLOR = Color3.fromRGB(255, 220, 80)
local OUTLINE_COLOR = Color3.fromRGB(255, 170, 0)

-- Имена комнат, где лежит главная дверь (лобби)
local LOBBY_NAMES = {["lobby"]=true, ["room0"]=true, ["0"]=true, ["start"]=true, ["startroom"]=true, ["lobbydoor"]=true}

local function isMainDoor(inst)
    if not inst:IsA("Model") then return false end
    if inst.Name ~= "Door" then return false end

    -- Проверяем, что дверь лежит в комнате-лобби
    local parent = inst.Parent
    if parent then
        local pname = parent.Name:lower()
        if LOBBY_NAMES[pname] then
            return true
        end
        -- Иногда дверь лежит глубже: Room0.Lobby.Door
        local grand = parent.Parent
        if grand and LOBBY_NAMES[grand.Name:lower()] then
            return true
        end
    end
    return false
end

local function applyHighlight(inst)
    if activeHighlight and activeHighlight.Parent then return end
    local h = Instance.new("Highlight")
    h.FillColor = FILL_COLOR
    h.OutlineColor = OUTLINE_COLOR
    h.FillTransparency = 0.35
    h.OutlineTransparency = 0
    h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    h.Parent = inst
    activeHighlight = h
end

local function tryHighlight(inst)
    if stopped then return end
    if activeHighlight and activeHighlight.Parent then return end
    if isMainDoor(inst) then
        applyHighlight(inst)
    end
end

local function scanContainer(container)
    if stopped or not container then return end
    for _, v in ipairs(container:GetDescendants()) do
        tryHighlight(v)
        if activeHighlight and activeHighlight.Parent then return end
    end
end

local function hookContainer(container)
    if not container then return end
    local conn = container.DescendantAdded:Connect(function(v)
        if stopped then return end
        task.wait()
        tryHighlight(v)
    end)
    table.insert(connections, conn)
end

local function startDoorHighlight()
    if not stopped then return end
    stopped = false
    activeHighlight = nil
    connections = {}

    task.spawn(function()
        scanContainer(Workspace)

        local rooms = Workspace:FindFirstChild("CurrentRooms")
        if not rooms then
            rooms = Workspace:WaitForChild("CurrentRooms", 15)
        end
        if rooms then
            scanContainer(rooms)
            hookContainer(rooms)
        end

        local wsConn = Workspace.ChildAdded:Connect(function(child)
            if child.Name == "CurrentRooms" then
                task.wait(0.5)
                scanContainer(child)
                hookContainer(child)
            end
        end)
        table.insert(connections, wsConn)

        hookContainer(Workspace)
    end)
end

local function stopDoorHighlight()
    stopped = true

    for _, conn in ipairs(connections) do
        if conn then conn:Disconnect() end
    end
    connections = {}

    if activeHighlight and activeHighlight.Parent then
        activeHighlight:Destroy()
    end
    activeHighlight = nil
end

-- =========================
-- ЭКИПИРОВКА / СНЯТИЕ
-- =========================
tool.Equipped:Connect(function()
    for part, _ in pairs(originalMaterials) do
        if part and part.Parent then
            part.Material = Enum.Material.Neon
        end
    end

    startDoorHighlight()
end)

tool.Unequipped:Connect(function()
    for part, material in pairs(originalMaterials) do
        if part and part.Parent then
            part.Material = material
        end
    end

    stopDoorHighlight()
end)
