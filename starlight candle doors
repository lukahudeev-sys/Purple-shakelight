local function safeLoad(url, label)
    print("[Hub] Загружаю:", label, url)
    local ok, err = pcall(function()
        local src = game:HttpGet(url)
        print("[Hub] Получено байт:", #src)
        if #src < 10 or src:find("^404") then
            error("HTTP вернул пустой ответ / 404")
        end
        local fn, parseErr = loadstring(src)
        if not fn then error("loadstring: " .. tostring(parseErr)) end
        fn()
    end)
    if not ok then
        warn("[Hub] FAIL " .. (label or "?") .. ": " .. tostring(err))
        pcall(function() Obsidian:Notify("Ошибка: " .. (label or "?"), 4) end)
    else
        print("[Hub] OK:", label)
    end
    return ok
end

