-- =========================
-- ПОДСВЕТКА ДВЕРЕЙ В ДИАПАЗОНЕ 2..100
-- =========================
local Workspace = game:GetService("Workspace")

local MIN_NUM = 2
local MAX_NUM = 100

local stopped = true
local activeHighlights = {}
local connections = {}

local FILL_COLOR    = Color3.fromRGB(255, 220, 80)
local OUTLINE_COLOR = Color3.fromRGB(255, 170, 0)
local TEXT_COLOR    = Color3.fromRGB(255, 235, 120)

local ATTRIBUTE_NAMES = {
    "Code", "Number", "RoomNumber", "DoorNumber",
    "NumberCode", "Num", "Room", "RoomId", "Id", "ID"
}

-- Извлекаем число из строки (поддерживает "0001", "Door 12", "№7")
local function extractNumber(str)
    if not str then return nil end
    str = tostring(str)
    -- сначала ищем последовательность цифр
    local digits = str:match("(%d+)")
    if not digits then return nil end
    local n = tonumber(digits)
    return n, digits
end

local function getDoorNumber(door)
    -- 1) Атрибуты двери
    for _, attr in ipairs(ATTRIBUTE_NAMES) do
        local v = door:GetAttribute(attr)
        if v ~= nil then
            local n, digits = extractNumber(v)
            if n then return n, digits end
        end
    end

    -- 2) Все TextLabel / TextButton / TextBox внутри двери
    for _, d in ipairs(door:GetDescendants()) do
        if d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then
            local n, digits = extractNumber(d.Text)
            if n then return n, digits end
        end
    end

    -- 3) SurfaceGui / BillboardGui — иногда текст в свойстве Name или DisplayName
    for _, d in ipairs(door:GetDescendants()) do
        if d:IsA("SurfaceGui") or d:IsA("BillboardGui") then
            local n, digits = extractNumber(d.Name)
            if n then return n, digits end
        end
    end

    -- 4) Из имени самой двери (Door0001, Door_12, Room7 и т.д.)
    local n, digits = extractNumber(door.Name)
    if n then return n, digits end

    -- 5) Из имени родителя (если дверь внутри Room0X)
    if door.Parent then
        local n, digits = extractNumber(door.Parent.Name)
        if n then return n, digits end
    end

    return nil
end

local function inRange(n)
    if not n then return false end
    return n >= MIN_NUM and n <= MAX_NUM
end

local function isDoorModel(inst)
    if not inst:IsA("Model") then return false end
    local n = inst.Name:lower()
    return n == "door" or n:find("door") ~= nil
end

local function getDoorPrimaryPart(door)
    local p = door.PrimaryPart
    if not p then
        p = door:FindFirstChildWhichIsA("BasePart", true)
    end
    return p
end

local function applyToDoor(door, digits)
    if activeHighlights[door] then return end

    local h = Instance.new("Highlight")
    h.FillColor = FILL_COLOR
    h.OutlineColor = OUTLINE_COLOR
    h.FillTransparency = 0.35
    h.OutlineTransparency = 0
    h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    h.Parent = door

    local billboard
    local part = getDoorPrimaryPart(door)
    if part then
        billboard = Instance.new("BillboardGui")
        billboard.Name = "GlitchDoorNumber"
        billboard.Size = UDim2.new(0, 160, 0, 60)
        billboard.StudsOffset = Vector3.new(0, 4, 0)
        billboard.AlwaysOnTop = true
        billboard.MaxDistance = 500
        billboard.Parent = part

        local lbl = Instance.new("TextLabel")
        lbl.Size = UDim2.new(1, 0, 1, 0)
        lbl.BackgroundTransparency = 1
        lbl.Text = digits
        lbl.TextColor3 = TEXT_COLOR
        lbl.TextStrokeTransparency = 0.4
        lbl.TextStrokeColor3 = Color3.fromRGB(90, 60, 0)
        lbl.TextScaled = true
        lbl.Font = Enum.Font.GothamBold
        lbl.Parent = billboard
    end

    activeHighlights[door] = {highlight = h, billboard = billboard}
end

local function process(inst)
    if stopped then return end
    if not isDoorModel(inst) then return end

    local n, digits = getDoorNumber(inst)
    if not inRange(n) then return end

    applyToDoor(inst, digits)
end

local function scanContainer(container)
    if stopped or not container then return end
    for _, v in ipairs(container:GetDescendants()) do
        process(v)
    end
end

local function hookContainer(container)
    if not container then return end
    local conn = container.DescendantAdded:Connect(function(v)
        if stopped then return end
        task.wait()
        process(v)
    end)
    table.insert(connections, conn)
end

local function startHighlight()
    if not stopped then return end
    stopped = false
    activeHighlights = {}
    connections = {}

    task.spawn(function()
        scanContainer(Workspace)

        local rooms = Workspace:FindFirstChild("CurrentRooms")
        if not rooms then
            rooms = Workspace:WaitForChild("CurrentRooms", 15)
        end
        if rooms then
            scanContainer(rooms)
            hookContainer(rooms)
        end

        local wsConn = Workspace.ChildAdded:Connect(function(child)
            if child.Name == "CurrentRooms" then
                task.wait(0.5)
                scanContainer(child)
                hookContainer(child)
            end
        end)
        table.insert(connections, wsConn)

        hookContainer(Workspace)
    end)
end

local function stopHighlight()
    stopped = true

    for _, conn in ipairs(connections) do
        if conn then conn:Disconnect() end
    end
    connections = {}

    for door, data in pairs(activeHighlights) do
        if data.highlight and data.highlight.Parent then
            data.highlight:Destroy()
        end
        if data.billboard and data.billboard.Parent then
            data.billboard:Destroy()
        end
    end
    activeHighlights = {}
end

tool.Equipped:Connect(function()
    for part, _ in pairs(originalMaterials) do
        if part and part.Parent then
            part.Material = Enum.Material.Neon
        end
    end
    startHighlight()
end)

tool.Unequipped:Connect(function()
    for part, material in pairs(originalMaterials) do
        if part and part.Parent then
            part.Material = material
        end
    end
    stopHighlight()
end)
