-- Загрузка утилит
loadstring(game:HttpGet("https://raw.githubusercontent.com/RegularVynixu/Utilities/main/Functions.lua"))()

-- \\ Настройки // --
local CANDLE_ID         = "rbxassetid://110853297264350"
local HIGHLIGHT_COLOR   = Color3.fromRGB(255, 220, 60)   -- жёлтый
local HIGHLIGHT_OUTLINE = Color3.fromRGB(255, 255, 200)  -- светло-жёлтый контур
local HIGHLIGHT_FILL    = 0.55
local HIGHLIGHT_OUT_T   = 0.15
local RESCAN_INTERVAL   = 1  -- как часто проверять новые комнаты (сек)

-- \\ Создание свечи // --
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local tool = LoadCustomInstance(CANDLE_ID)
tool.Name = "Star Candle"
tool.Parent = LocalPlayer.Backpack
tool.Animations.idle.AnimationId = "rbxassetid://10479585177"

-- Перекрас свечи в золотистый
local function starColor(color)
	local _, s, v = Color3.toHSV(color)
	return Color3.fromHSV(0.13, math.clamp(s * 0.8, 0, 1), v)
end

local function recolorSeq(seq)
	local newKeys = {}
	for _, key in ipairs(seq.Keypoints) do
		table.insert(newKeys, ColorSequenceKeypoint.new(key.Time, starColor(key.Value)))
	end
	return ColorSequence.new(newKeys)
end

for _, obj in ipairs(tool:GetDescendants()) do
	if obj:IsA("BasePart") then
		obj.Color = starColor(obj.Color)
	elseif obj:IsA("PointLight") or obj:IsA("SpotLight") or obj:IsA("SurfaceLight") then
		obj.Color = starColor(obj.Color)
	elseif obj:IsA("ParticleEmitter") then
		obj.Color = recolorSeq(obj.Color)
	elseif obj:IsA("Trail") then
		obj.Color = recolorSeq(obj.Color)
	elseif obj:IsA("Beam") then
		obj.Color = recolorSeq(obj.Color)
	end
end

-- \\ Подсветка дверей в DOORS // --
local activeHighlights = {}   -- [door] = Highlight
local scanRunning = false

local function makeHighlight(door)
	local hl = Instance.new("Highlight")
	hl.Name = "StarCandleHighlight"
	hl.Adornee = door
	hl.FillColor = HIGHLIGHT_COLOR
	hl.FillTransparency = HIGHLIGHT_FILL
	hl.OutlineColor = HIGHLIGHT_OUTLINE
	hl.OutlineTransparency = HIGHLIGHT_OUT_T
	hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	hl.Parent = door
	return hl
end

-- Пробегаем все комнаты и добиваем подсветку там, где её нет
local function scanRooms()
	local currentRooms = workspace:FindFirstChild("CurrentRooms")
	if not currentRooms then return end

	-- чистим записи об уничтоженных дверях
	for door, hl in pairs(activeHighlights) do
		if not door.Parent or not hl.Parent then
			activeHighlights[door] = nil
		end
	end

	for _, room in ipairs(currentRooms:GetChildren()) do
		local door = room:FindFirstChild("Door")
		if door and not activeHighlights[door] then
			activeHighlights[door] = makeHighlight(door)
		end
	end
end

local function clearHighlights()
	for _, hl in pairs(activeHighlights) do
		if hl and hl.Parent then hl:Destroy() end
	end
	activeHighlights = {}
end

-- Цикл автосканирования
local function startScanning()
	if scanRunning then return end
	scanRunning = true

	task.spawn(function()
		while scanRunning do
			scanRooms()
			task.wait(RESCAN_INTERVAL)
		end
	end)
end

local function stopScanning()
	scanRunning = false
	clearHighlights()
end

-- \\ Автовключение при экипировке // --
tool.Equipped:Connect(function()
	print("[Star Candle] Экипирована — подсветка ВКЛ")
	scanRooms()
	startScanning()
end)

tool.Unequipped:Connect(function()
	print("[Star Candle] Убрана — подсветка ВЫКЛ")
	stopScanning()
end)
