loadstring(game:HttpGet("https://raw.githubusercontent.com/RegularVynixu/Utilities/main/Functions.lua"))()

local tool = LoadCustomInstance("rbxassetid://110853297264350")
tool.Parent = game:GetService("Players").LocalPlayer.Backpack
tool.Name = "Glitch Candle"

-- Функция сохранения яркости при смене цвета на фиолетовый
local function purpleKeepBrightness(color)
	local _, _, v = Color3.toHSV(color)
	return Color3.fromHSV(0.78, 1, v) -- фиолетовый
end

-- Перекраска всех объектов инструмента
for _, obj in ipairs(tool:GetDescendants()) do
	if obj:IsA("BasePart") then
		obj.Color = purpleKeepBrightness(obj.Color)
	elseif obj:IsA("PointLight") or obj:IsA("SpotLight") or obj:IsA("SurfaceLight") then
		obj.Color = purpleKeepBrightness(obj.Color)
	elseif obj:IsA("ParticleEmitter") then
		if obj.Name ~= "FireParticle" then
			local newKeys = {}
			for _, key in ipairs(obj.Color.Keypoints) do
				table.insert(newKeys, ColorSequenceKeypoint.new(key.Time, purpleKeepBrightness(key.Value)))
			end
			obj.Color = ColorSequence.new(newKeys)
		end
	elseif obj:IsA("Trail") then
		local newKeys = {}
		for _, key in ipairs(obj.Color.Keypoints) do
			table.insert(newKeys, ColorSequenceKeypoint.new(key.Time, purpleKeepBrightness(key.Value)))
		end
		obj.Color = ColorSequence.new(newKeys)
	elseif obj:IsA("Beam") then
		local newKeys = {}
		for _, key in ipairs(obj.Color.Keypoints) do
			table.insert(newKeys, ColorSequenceKeypoint.new(key.Time, purpleKeepBrightness(key.Value)))
		end
		obj.Color = ColorSequence.new(newKeys)
	end
end

-- Создаём источник света для подсветки при экипировке
local handle = tool:FindFirstChild("Handle")
if handle then
	local glowLight = Instance.new("PointLight")
	glowLight.Name = "EquipGlow"
	glowLight.Color = Color3.fromHSV(0.78, 1, 1) -- фиолетовый
	glowLight.Range = 12
	glowLight.Brightness = 2.5
	glowLight.Enabled = false -- изначально выключен
	glowLight.Parent = handle

	-- Включаем свет при экипировке
	tool.Equipped:Connect(function()
		glowLight.Enabled = true
	end)

	-- Выключаем свет при снятии
	tool.Unequipped:Connect(function()
		glowLight.Enabled = false
	end)
end
