loadstring(game:HttpGet("https://raw.githubusercontent.com/RegularVynixu/Utilities/main/Functions.lua"))()

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local tool = LoadCustomInstance("rbxassetid://110853297264350")
tool.Name = "Star Candle"
tool.Parent = LocalPlayer.Backpack

local espFolder = Instance.new("Folder")
espFolder.Name = "StarCandleESP"
espFolder.Parent = game:GetService("CoreGui")

local tracked = {}
local connection = nil
local active = false

local doorFolder = workspace:FindFirstChild("Doors") or workspace:FindFirstChild("Door")

local function isDoor(obj)
	if not obj or not obj:IsA("BasePart") then return false end

	if doorFolder then
		return obj:IsDescendantOf(doorFolder)
	end

	if string.lower(obj.Name) ~= "door" then return false end

	local size = obj.Size
	if size.Y < 4 then return false end
	if size.Y <= size.X or size.Y <= size.Z then return false end

	return true
end

local function createESP(door)
	if tracked[door] then return end

	-- Заливка двери
	local hl = Instance.new("Highlight")
	hl.Name = "StarCandleHL"
	hl.Adornee = door
	hl.FillColor = Color3.fromRGB(255, 220, 120)
	hl.OutlineColor = Color3.fromRGB(255, 255, 255)
	hl.FillTransparency = 0.6
	hl.OutlineTransparency = 1       -- контур Highlight выключаем (будет SelectionBox)
	hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	hl.Parent = espFolder

	-- Чёткая рамка вокруг двери
	local box = Instance.new("SelectionBox")
	box.Name = "StarCandleBox"
	box.Adornee = door
	box.Color3 = Color3.fromRGB(255, 230, 140)
	box.LineThickness = 0.15
	box.SurfaceTransparency = 1
	box.Transparency = 0
	box.Parent = espFolder

	tracked[door] = {hl = hl, box = box}
end

local function clearAll()
	for door, data in pairs(tracked) do
		if data.hl then data.hl:Destroy() end
		if data.box then data.box:Destroy() end
	end
	tracked = {}
end

local function scanDoors()
	for _, obj in ipairs(workspace:GetDescendants()) do
		if isDoor(obj) then
			createESP(obj)
		end
	end
end

local function onEquip()
	if active then return end
	active = true

	scanDoors()

	connection = workspace.DescendantAdded:Connect(function(obj)
		if not active then return end
		task.wait(0.1)
		if isDoor(obj) then
			createESP(obj)
		end
	end)
end

local function onUnequip()
	active = false
	if connection then
		connection:Disconnect()
		connection = nil
	end
	clearAll()
end

tool.Equipped:Connect(onEquip)
tool.Unequipped:Connect(onUnequip)
