local isRunning = true

local phase1Sound = GetGitSound("https://raw.githubusercontent.com/lukahudeev-sys/Purple-shakelight/main/lv_0_20260926233537.mp3", "FrostbitePhase1")
if phase1Sound then
    phase1Sound.Parent = workspace
