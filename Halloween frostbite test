    phase1Sound.PlaybackSpeed = 1
    phase1Sound.Looped = true
    phase1Sound.Name = "FrostymanPhase1"
    phase1Sound:Play()
end

local phase2Sound = GetGitSound("https://raw.githubusercontent.com/lukahudeev-sys/Purple-shakelight/main/lv_0_20260926233731.mp3", "FrostbitePhase2")

local function UpdateBar()
    if fillBar then
        fillBar.Size = UDim2.new(currentColdValue, 0, 1, 0)
    end
end

RunService.Heartbeat:Connect(function()
    if not isRunning or not entityPart or not entityPart.Parent then return end

    local player = LocalPlayer
    if not player or not player.Character then return end

    local root = player.Character:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local distance = (entityPart.Position - root.Position).Magnitude
    if distance > 5 then
        local dir = (root.Position - entityPart.Position).Unit
        entityPart.AssemblyLinearVelocity = dir * 25
    else
        entityPart.AssemblyLinearVelocity = Vector3.new(0, entityPart.AssemblyLinearVelocity.Y, 0)
    end

    if distance < 18 then
        currentColdValue = math.min(1, currentColdValue + 0.02)
    else
        currentColdValue = math.max(0, currentColdValue - 0.01)
    end

    UpdateBar()
end)

local endSoundUrl = "https://raw.githubusercontent.com/lukahudeev-sys/Purple-shakelight/main/lv_0_20260927123343.mp3"

local function PlayEndSound()
    local endSound = GetGitSound(endSoundUrl, "Frostenddd")
    if endSound then
        endSound.Parent = workspace
        endSound.Volume = 7.5
        endSound.PlaybackSpeed = 1
        endSound:Play()
        Debris:AddItem(endSound, 10)
    else
        local fallback = Instance.new("Sound")
        fallback.SoundId = "rbxassetid://9125402735"
        fallback.Volume = 7.5
        fallback.Parent = workspace
        fallback.PlaybackSpeed = 0.7
        fallback:Play()
        Debris:AddItem(fallback, 3.6)
    end
end

task.delay(10, function()
    if isRunning then
        isRunning = false

        if phase1Sound then
            phase1Sound:Stop()
            phase1Sound:Destroy()
        end

        if phase2Sound then
            phase2Sound:Stop()
            phase2Sound:Destroy()
        end

        if entityModel and entityModel.Parent then
            entityModel:Destroy()
        end

        if coldGui and coldGui.Parent then
            coldGui:Destroy()
        end

        PlayEndSound()
    end
end)

