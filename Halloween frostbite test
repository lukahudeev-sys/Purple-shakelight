local function GetGitSound(GithubSnd, SoundName)
    local fileName = SoundName .. ".mp3"
    if not isfile(fileName) then
        local success, response = pcall(function()
            return game:HttpGet(GithubSnd)
        end)

        if success and response then
            writefile(fileName, response)
        else
            warn("[Frostbite]: Не удалось скачать звук: " .. SoundName)
            return nil
        end
    end

    local sound = Instance.new("Sound")
    sound.SoundId = getcustomasset(fileName)
    return sound
end

local function CreateEntity()
    local model = Instance.new("Model")
    model.Name = "Frostyma5n"

    local body = Instance.new("Part")
    body.Name = "Body"
    body.Size = Vector3.new(3, 3, 3)
    body.Shape = Enum.PartType.Ball
    body.Material = Enum.Material.Neon
    body.Color = Color3.fromRGB(100, 150, 255)
    body.CanCollide = false
    body.TopSurface = Enum.SurfaceType.Smooth
    body.BottomSurface = Enum.SurfaceType.Smooth
    body.CFrame = CFrame.new(0, 15, 0)
    body.Parent = model

    model.PrimaryPart = body
    model.Parent = workspace
    return model, body
end

