--// HALLOWEEN / ORANGE MODE — ТОЛЬКО ОБОИ
--// Красим в оранжевый только объекты с именем "Wallpaper"
--// ============================================================

require(game.Players.LocalPlayer.PlayerGui.MainUI.Initiator.Main_Game)
	.caption("HALLOWEEN Mode initiated! Script by Nowxwellor", true)

local ORANGE = Color3.fromRGB(255, 145, 20)

local function paintWallpaper(object)
	if object:IsA("BasePart") and object.Name == "Wallpaper" then
		object.Color = ORANGE
		-- Если нужно вернуть прозрачность как в старом скрипте — раскомментируй:
		-- object.Transparency = 0.7
	end
end

-- Существующие обои
for _, object in ipairs(workspace:GetDescendants()) do
	paintWallpaper(object)
end

-- Новые обои
workspace.DescendantAdded:Connect(function(descendant)
	paintWallpaper(descendant)
end)
