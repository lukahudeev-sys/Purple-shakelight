local TweenService_upvr = game:GetService("TweenService")
local TweenService = game:GetService("TweenService")
local MainUI_upvr = nil
if not game.Players.LocalPlayer.PlayerGui:FindFirstChild("MainUI") then repeat wait() until game.Players.LocalPlayer.PlayerGui:FindFirstChild("MainUI") end
MainUI_upvr = game.Players.LocalPlayer.PlayerGui.MainUI
local toolNew = nil
if game.GameId == 6627207668 then
	toolNew = game.ReplicatedStorage["Moon Bottle"]:Clone()
else
	toolNew = game:GetObjects("rbxassetid://111263531009426")[1]
end
local newCloneEffect = MainUI_upvr.MainFrame.Healthbar.Effects.HerbGreenEffect:Clone()
local drinked = false
local CollisionLoopRunning = true
local ended = false
newCloneEffect.Name = "GuidingLightPotion"
newCloneEffect.Visible = false
newCloneEffect.Parent = MainUI_upvr.MainFrame.Healthbar.Effects

-- 🎀 РОЗОВЫЙ ЦВЕТ
local PINK = Color3.fromRGB(255, 105, 180)

local ohhmydayz = game.Players.LocalPlayer.Character:WaitForChild("Humanoid"):LoadAnimation(toolNew.bals.idle)
local ohhmydayz2 = game.Players.LocalPlayer.Character:WaitForChild("Humanoid"):LoadAnimation(toolNew.bals.open)
local ohhmydayz3 = game.Players.LocalPlayer.Character:WaitForChild("Humanoid"):LoadAnimation(toolNew.Animations.open)

spawn(function()
	while wait() do
		if drinked == true and ended == false then
			ended = true
			if game.GameId == 6627207668 then
				local newTool = script.flyTest:Clone()
				newTool.Parent = game.Players.LocalPlayer.Backpack
				newTool.Enabled = true
			else
				if getgenv().ViridislightRunning then
					return
				end
				getgenv().ViridislightRunning = true

				local Character = game.Players.LocalPlayer.Character or game.Players.LocalPlayer.CharacterAdded:Wait()
				local Humanoid = Character:WaitForChild("Humanoid")
				local RootPart = Character:WaitForChild("HumanoidRootPart")

				-- 🎀 Свет РОЗОВЫЙ
				local potionLight = Instance.new("PointLight")
				potionLight.Name = "ViridisLight"
				potionLight.Color = PINK
				potionLight.Brightness = 2
				potionLight.Range = 0
				potionLight.Shadows = false
				potionLight.Parent = RootPart

				TweenService:Create(
					potionLight,
					TweenInfo.new(2.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
					{ Range = 45 }
				):Play()

				local Camera = workspace.CurrentCamera
				local Collision

				Collision = Character:FindFirstChild("CollisionPart")
				if not Collision then
					for _, part in pairs(Character:GetChildren()) do
						if part:IsA("BasePart") and part.Name:lower():find("collision") then
							Collision = part
							break
						end
					end
				end

				if not Collision then
					Collision = RootPart
				end

				local CollisionClone = Collision:Clone()
				CollisionClone.CanCollide = false
				CollisionClone.Massless = true
				CollisionClone.CanQuery = false
				CollisionClone.Name = "CollisionClone"

				if CollisionClone:FindFirstChild("CollisionCrouch") then
					CollisionClone.CollisionCrouch:Destroy()
				end

				CollisionClone.Parent = Character

				task.spawn(function()
					while Character.Parent and CollisionLoopRunning do
						if RootPart.Anchored then
							CollisionClone.Massless = true
							repeat
								task.wait()
							until not RootPart.Anchored or not CollisionLoopRunning

							if not CollisionLoopRunning then
								break
							end

							task.wait(0.15)
						else
							CollisionClone.Massless = not CollisionClone.Massless
						end

						task.wait(0.24)
					end
				end)

				local viridis = Instance.new("Sound", workspace)
				viridis.SoundId = "rbxassetid://140242540481244"
				viridis.Volume = 1.2

				local ambience = Instance.new("Sound", workspace)
				ambience.SoundId = "rbxassetid://1841950508"
				ambience.Volume = 1
				ambience.Looped = true
				ambience:Play()

				-- =============================
				-- 🚫 ПОДСВЕТКА ДВЕРЕЙ / КЛЮЧЕЙ ОТКЛЮЧЕНА
				-- =============================
				local stopped = false
				local activeHighlights = {}

				local function stopHighlights()
					stopped = true
					for _, h in ipairs(activeHighlights) do
						if h and h.Parent then
							h:Destroy()
						end
					end
					activeHighlights = {}
				end
				-- (функции process / scanRooms / DescendantAdded удалены,
				--  чтобы не подсвечивать Door и KeyObtain)

				-- =============================
				-- 💚 ХИЛ ДО МАКСИМАЛЬНОГО HP
				-- =============================
				local RunService = game:GetService("RunService")
				local player = game.Players.LocalPlayer

				local humanoid = player.Character or player.CharacterAdded:Wait()
				humanoid = humanoid:WaitForChild("Humanoid")

				local regenStopped = false

				local function startRegen()
					task.spawn(function()
						while not regenStopped do
							task.wait(0.5)
							if humanoid and humanoid.Parent and humanoid.Health > 0 then
								-- 💖 МГНОВЕННЫЙ ХИЛ ДО МАКСА
								humanoid.Health = humanoid.MaxHealth
							end
						end
					end)
				end

				local function stopRegen()
					regenStopped = true
				end

				startRegen()

				local Players = game:GetService("Players")
				local Lighting = game:GetService("Lighting")

				local char = player.Character or player.CharacterAdded:Wait()
				local humanoid2 = char:WaitForChild("Humanoid")

				local originalWalkSpeed = humanoid2.WalkSpeed

				local speedConn
				speedConn = RunService.Heartbeat:Connect(function()
					if humanoid2 and humanoid2.Parent then
						if humanoid2.WalkSpeed ~= 17 then
							humanoid2.WalkSpeed = 17
						end
					end
				end)

				-- =========================
				-- ⏳ TIMER UI (исправлено: 30 сек)
				-- =========================
				local gui = Instance.new("ScreenGui")
				gui.IgnoreGuiInset = true
				gui.ResetOnSpawn = false
				gui.Parent = player:WaitForChild("PlayerGui")

				local label = Instance.new("TextLabel")
				label.Size = UDim2.new(0, 200, 0, 40)
				label.Position = UDim2.new(0.5, -100, 0, 10)
				label.BackgroundTransparency = 1
				label.TextColor3 = PINK               -- 🎀 розовый текст таймера
				label.TextStrokeTransparency = 0.6
				label.Font = Enum.Font.Gotham
				label.TextSize = 20
				label.Text = "0:30"
				label.Parent = gui

				local timeLeft = 30

				local function formatTime(t)
					local m = math.floor(t / 60)
					local s = t % 60
					return string.format("%d:%02d", m, s)
				end

				local function restore()
					getgenv().ViridislightRunning = false

					if potionLight and potionLight.Parent then
						local lightTween = TweenService:Create(
							potionLight,
							TweenInfo.new(2),
							{ Range = 0 }
						)
						lightTween:Play()
						lightTween.Completed:Connect(function()
							if potionLight then potionLight:Destroy() end
						end)
					end

					newCloneEffect.Visible = false

					if speedConn then
						speedConn:Disconnect()
					end

					local tween = TweenService:Create(humanoid2, TweenInfo.new(2), {
						WalkSpeed = originalWalkSpeed
					})
					tween:Play()

					task.delay(2, function()
						if gui then gui:Destroy() end
					end)
				end

				viridis:Play()

				viridis.Ended:Connect(function()
					viridis:Destroy()
				end)

				task.spawn(function()
					while timeLeft >= 0 do
						label.Text = formatTime(timeLeft)

						if timeLeft == 0 then
							stopRegen()
							stopHighlights()
							restore()
							ambience:Destroy()

							CollisionLoopRunning = false
							if CollisionClone then
								CollisionClone:Destroy()
							end
							break
						end

						timeLeft -= 1
						task.wait(1)
					end
				end)
			end
		end
	end
end)

